      <parset name="parameters">
        <parset name="PROCDESC">
          <par name="label" type="string"> "Reproduce Traces" </par>
          <par name="parallel_enabled" type="boolean"> false </par>
          <par name="parallelizable" type="boolean"> true </par>
          <par name="product" type="string"> PROMAX </par>
          <par name="collapse" type="boolean"> false </par>
          <par name="ipmEnabled" type="boolean"> false </par>
          <par name="name" type="string"> repeat </par>
          <par name="toolType" type="string"> NORMAL </par>
          <par name="type" type="string"> Lisp </par>
          <par name="legalHybrid" type="boolean"> true </par>
        </parset>
        <parset name="MENUDATA">
          <par name="MENUDATA" type="string"> "(:label\n^Reproduce Traces^\n:enablep T\n:name REPEAT\n:value_tab 40\n:plot_label NIL\n:rules NIL\n:exec_data (^REPEAT^ (^GENERAL^ (^version^ :implicit ^ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $^) (^MODE^ :implicit (VALUE (QUOTE MODE))) (^NCOPIES^ :implicit (VALUE (QUOTE NCOPIES))))):parameter MODE\n:text ^Trace grouping to reproduce^\n:type :pop_choose\n:type_desc ((^Ensembles ^ 1 ^Reproduce ensembles of traces (shots, gathers, etc.).^) (^Traces^ 2 ^Reproduce individual traces (also stacked traces).^) (^All Data^ 4 ^Reproduce all data in the flow.^))\n:selected_item (^Ensembles ^ 1 ^Reproduce ensembles of traces (shots, gathers, etc.).^)\n:value 1\n:mouse_text ^You can repeat (reproduce) individual traces, ensembles of traces, or all of the data.^\n:parameter NCOPIES\n:text ^Total number of datasets^\n:type :typein\n:type_desc (:int 3 1 999)\n:value 2\n:mouse_text ^Total number of datasets passed on for further processing (equal to: \'number of copies + 1\' to account for input dataset).^\n)\n" </par>
        </parset>
        <parset name="parameterAttributes">
        </parset>
        <parset name="execParameters">
          <parset name="REPEAT #0">
            <parset name="GENERAL">
              <par name="version" type="string"> "ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $" </par>
              <par name="MODE" type="long"> 1 </par>
              <par name="NCOPIES" type="long"> 2 </par>
            </parset>
          </parset>
        </parset>
      </parset>
    </parset>
    <parset name="FLOW_IF #1">
      <par name="ToolName" type="string"> FLOW_IF </par>
