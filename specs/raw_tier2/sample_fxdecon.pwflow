          <par name="ipmEnabled" type="boolean"> true </par>
          <par name="name" type="string"> flow_if </par>
          <par name="toolType" type="string"> NORMAL </par>
          <par name="type" type="string"> Lisp </par>
          <par name="legalHybrid" type="boolean"> true </par>
        </parset>
        <parset name="MENUDATA">
          <par name="MENUDATA" type="string"> "(:label\n^IF^\n:enablep T\n:name FLOW_IF\n:value_tab 40\n:plot_label NIL\n:rules NIL\n:exec_data (^FLOW_IF^ (^GENERAL^ (^version^ :implicit ^ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $^) (^MERGE^ :implicit 1) (^MODE^ :implicit (VALUE (QUOTE MODE))) (^PRIM_KEY^ :implicit (VALUE (QUOTE PRIM_KEY))) (^SCND_KEY^ :implicit (VALUE (QUOTE SCND_KEY))) (^LIST^ :implicit (VALUE (QUOTE LIST))))):parameter MODE\n:text ^Trace selection MODE^\n:type :circular\n:type_desc ((^Include^ 0 ^INCLUDE the traces in the list.^) (^Exclude^ 1 ^EXCLUDE the traces in the list.^))\n:selected_item (^Include^ 0 ^INCLUDE the traces in the list.^)\n:value 0\n:mouse_text ^The traces in the list can be either INCLUDED or EXCLUDED from the following processes.^\n:parameter PRIM_KEY\n:text ^SELECT Primary trace header word^\n:type :function\n:type_desc (HEADER_LIST HEADERS)\n:selected_item ^REPEATED data copy number^\n:value ^REPEAT  ^\n:mouse_text ^Use MB1 to select a header word from the headers menu as the PRIMARY key for specifying the inc./exc. trace list.^\n:properties (:supported_formats (^PROMAX^ ^PROMAX_SMART^ ^PROMAX_TAPE^)\n )\n:parameter SCND_KEY\n:text ^SELECT Secondary trace header word^\n:type :function\n:type_desc (HEADER_LIST HEADERS)\n:selected_item ^No trace header entry selected^\n:value ^NONE    ^\n:mouse_text ^Use MB1 to select a header word from the headers menu as the SECONDARY key for specifying the inc./exc. trc list.^\n:properties (:supported_formats (^PROMAX^ ^PROMAX_SMART^ ^PROMAX_TAPE^)\n )\n:parameter LIST\n:text ^SPECIFY trace list^\n:type :edit\n:type_desc (25 80 5 ^ FORMAT: Primary header word value(s):Secondary header word value(s)/\n EXAMPLES: 1 / 1-3:40,65 / 4-10:1-120(3) / 5-99(10):2-120(3),3,6,9 /\n HELP: EMACS Editor Widget (scroll with down/up arrow keys)\n CURSOR MOVEMENT: Use the arrow keys:->,&lt;-,etc.;Point the mouse cursor,click B1\n CM: Ctrl-A\t\tMove the cursor to the BEGINNING of the current line\n CM: Ctrl-E\t\tMove the cursor to the END of the current line\n EDITING: All keyboard entry is in \'insert\' mode\n E:  Backspace, Delete keys\tDelete one character to the LEFT of the cursor\n E:  Ctrl-D\t\t\tDelete one character to the RIGHT of the cursor\n E:  Ctrl-K\t\tKILL to the end of the line (from the cursor)\n E:  Ctrl-Y\t\tYANK back the contents of the kill buffer; \'Cut and \n\t\t\t  paste\'; (Can move the cursor first) ^ 3)\n:value ^1^\n:mouse_text ^Use MB1 to specify the copy number from \'Repeat\', or to define the list of traces, you wish to include/exclude.^\n)\n" </par>
        </parset>
        <parset name="parameterAttributes">
        </parset>
        <parset name="execParameters">
          <parset name="FLOW_IF #0">
            <parset name="GENERAL">
              <par name="version" type="string"> "ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $" </par>
              <par name="MERGE" type="long"> 1 </par>
              <par name="MODE" type="long"> 0 </par>
              <par name="PRIM_KEY" type="string"> "REPEAT  " </par>
              <par name="SCND_KEY" type="string"> "NONE    " </par>
              <par name="LIST" type="string"> 1 </par>
            </parset>
          </parset>
        </parset>
      </parset>
    </parset>
