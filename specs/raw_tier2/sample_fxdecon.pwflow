          <par name="legalHybrid" type="boolean"> true </par>
        </parset>
        <parset name="MENUDATA">
          <par name="MENUDATA" type="string"> "(:label\n^ENDIF^\n:enablep T\n:name FLOW_ENDIF\n:value_tab 40\n:plot_label NIL\n:rules NIL\n:exec_data (^FLOW_ENDIF^ (^GENERAL^ (^version^ :implicit ^ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $^) (^MERGE^ :implicit 1))))\n" </par>
        </parset>
