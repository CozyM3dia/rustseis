    <parset name="FXDECON #2">
      <par name="ToolName" type="string"> FXDECON </par>
      <par name="enabled" type="boolean"> true </par>
      <parset name="parameters">
        <parset name="PROCDESC">
          <par name="label" type="string"> "F-X Decon" </par>
          <par name="parallel_enabled" type="boolean"> false </par>
          <par name="parallelizable" type="boolean"> true </par>
          <par name="product" type="string"> PROMAX </par>
          <par name="collapse" type="boolean"> false </par>
          <par name="ipmEnabled" type="boolean"> true </par>
          <par name="name" type="string"> fxdecon </par>
          <par name="toolType" type="string"> NORMAL </par>
          <par name="type" type="string"> Lisp </par>
          <par name="legalHybrid" type="boolean"> true </par>
        </parset>
        <parset name="MENUDATA">
          <par name="MENUDATA" type="string"> "(:label\n^F-X Decon^\n:enablep T\n:name FXDECON\n:value_tab 54\n:plot_label T\n:rules ((((VALUE FLT_TYPE)) RULE1 (= (VALUE (QUOTE FLT_TYPE)) 1) (PROGN (DO_NOT_SHOW (QUOTE RADAPT)) (DO_SHOW (QUOTE NPF)) (DO_SHOW (QUOTE PCTN)))) (((VALUE FLT_TYPE)) RULE2 (= (VALUE (QUOTE FLT_TYPE)) 2) (PROGN (DO_SHOW (QUOTE RADAPT)) (DO_SHOW (QUOTE NPF)) (DO_NOT_SHOW (QUOTE PCTN)))) (((VALUE HDRLIMIT)) RULE3 (VALUE (QUOTE HDRLIMIT)) (DO_SHOW (QUOTE HDRNAME)) (DO_NOT_SHOW (QUOTE HDRNAME))) (((VALUE NTRW) (VALUE NPF)) NPF (&lt;= (VALUE (QUOTE NTRW)) (VALUE (QUOTE NPF))) (SET_VALUE (QUOTE NPF) (- (VALUE (QUOTE NTRW)) 1))))\n:exec_data (^FXDECON^ (^GENERAL^ (^version^ :implicit ^ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $^) (^FLT_TYPE^ :implicit (VALUE (QUOTE FLT_TYPE))) (^PCTN^ :implicit (VALUE (QUOTE PCTN))) (^RADAPT^ :implicit (VALUE (QUOTE RADAPT))) (^NTRW^ :implicit (VALUE (QUOTE NTRW))) (^NPF^ :implicit (VALUE (QUOTE NPF))) (^TIMEW^ :implicit (VALUE (QUOTE TIMEW))) (^TOVLP^ :implicit (VALUE (QUOTE TOVLP))) (^FR1^ :implicit (VALUE (QUOTE FR1))) (^FR2^ :implicit (VALUE (QUOTE FR2))) (^NPASSES^ :implicit (VALUE (QUOTE NPASSES))) (^HDRLIMIT^ :implicit (IF (VALUE (QUOTE HDRLIMIT)) 1 0)) (^HDRNAME^ :implicit (IF (VALUE (QUOTE HDRLIMIT)) (VALUE (QUOTE HDRNAME)) ^NONE^)) (^REMUTE^ :implicit (IF (VALUE (QUOTE REMUTE)) 1 0)))):parameter FLT_TYPE\n:text ^TYPE of filter^\n:plot_label T\n:type :circular\n:type_desc ((^Wiener Levinson^ 1 ^Apply complex Wiener Levinson prediction filter.^) (^L2 NORM ADAPTIVE^ 2 ^Apply LMS L2 norm adaptive prediction filter.^))\n:selected_item (^Wiener Levinson^ 1 ^Apply complex Wiener Levinson prediction filter.^)\n:value 1\n:mouse_text ^The output data is from a complex step ahead prediction filter, either W-L fixed or L2 norm adaptive.^\n:parameter PCTN\n:text ^Percentage of white noise^\n:plot_label T\n:type :typein\n:type_desc (:real 5 0.0 NIL)\n:value 0.0\n:mouse_text ^Percentage of white noise to be added to the zero lag autocorrelation value.^\n:parameter RADAPT\n:text ^Rate of adaptation^\n:plot_label T\n:type :typein\n:type_desc (:real 10 1.0E-10 NIL)\n:value 0.1\n:showp NIL\n:mouse_text ^This is the coefficient controlling the adaptation rate.^\n:parameter NTRW\n:text ^Horizontal window length^\n:plot_label T\n:type :typein\n:type_desc (:int 5 1 NIL)\n:value 10\n:mouse_text ^This is the horizontal F-X prediction window length in traces.^\n:parameter NPF\n:text ^Number of filter samples^\n:plot_label T\n:type :typein\n:type_desc (:int 5 1 NIL)\n:value 5\n:mouse_text ^This is the number of samples in the complex prediction filter.  (Minimum of 4 samps; longer for conflicting dips)^\n:parameter TIMEW\n:text ^Time window length^\n:plot_label T\n:type :typein\n:type_desc (:real 8 1.0E-6 NIL)\n:value 1000.0\n:mouse_text ^This is the time gate length (in milliseconds) for prediction windows.^\n:parameter TOVLP\n:text ^Time window overlap^\n:plot_label T\n:type :typein\n:type_desc (:real 8 0.0 NIL)\n:value 100.0\n:mouse_text ^This is the window extension in milliseconds (and on both sides) of time gates for prediction windows.^\n:parameter FR1\n:text ^F-X filter start frequency^\n:plot_label T\n:type :typein\n:type_desc (:real 8 0.0 NIL)\n:value 1.0\n:mouse_text ^This is minimum frequency of any SIGNAL OR NOISE in the seismic data.^\n:parameter FR2\n:text ^F-X filter end frequency^\n:plot_label T\n:type :typein\n:type_desc (:real 8 1.0E-6 NIL)\n:value 250.0\n:mouse_text ^This is maximum frequency of any SIGNAL OR NOISE in the seismic data.^\n:parameter NPASSES\n:text ^Number of times to apply F-X filter to each trace^\n:plot_label T\n:type :typein\n:type_desc (:int 5 1 5)\n:value 1\n:mouse_text ^For convenience multiple F-X passes may be used without inserting extra processes in the flow.^\n:parameter HDRLIMIT\n:text ^Apply filter only to selected traces?^\n:plot_label T\n:type :boolean\n:type_desc ((^Yes ^ T) (^No^ NIL))\n:selected_item (^No^ NIL)\n:mouse_text ^Compute output only where chosen trace header is nonzero.^\n:parameter HDRNAME\n:text ^  Select trace header for filter application^\n:plot_label T\n:type :function\n:type_desc (HEADER_LIST HEADERS)\n:selected_item ^Trace type (data, aux, etc.)^\n:value ^TRC_TYPE^\n:showp NIL\n:mouse_text ^Choose which header to use in determining filter application.^\n:properties (:supported_formats (^PROMAX^ ^PROMAX_SMART^ ^PROMAX_TAPE^)\n )\n:parameter REMUTE\n:text ^Re-apply trace mute after filter?^\n:type :boolean\n:type_desc ((^Yes ^ T) (^No^ NIL))\n:selected_item (^Yes ^ T)\n:value T\n:mouse_text ^Trace mutes (such as surgical and first break suppression mutes) may be re-applied after F-X filtering.^\n)\n" </par>
        </parset>
        <parset name="parameterAttributes">
        </parset>
        <parset name="execParameters">
          <parset name="FXDECON #0">
            <parset name="GENERAL">
              <par name="version" type="string"> "ProMAX $Id: exec.0.pwflow 29824 2008-05-30 03:29:11Z dgrygier $ $Revision: 29824 $ $Date: 2008-05-29 21:29:11 -0600 (Thu, 29 May 2008) $" </par>
              <par name="FLT_TYPE" type="long"> 1 </par>
              <par name="PCTN" type="double"> 0.0 </par>
              <par name="RADAPT" type="double"> 0.1 </par>
              <par name="NTRW" type="long"> 10 </par>
              <par name="NPF" type="long"> 5 </par>
              <par name="TIMEW" type="double"> 1000.0 </par>
              <par name="TOVLP" type="double"> 100.0 </par>
              <par name="FR1" type="double"> 1.0 </par>
              <par name="FR2" type="double"> 250.0 </par>
              <par name="NPASSES" type="long"> 1 </par>
              <par name="HDRLIMIT" type="long"> 0 </par>
              <par name="HDRNAME" type="string"> NONE </par>
              <par name="REMUTE" type="long"> 1 </par>
            </parset>
          </parset>
        </parset>
      </parset>
    </parset>
