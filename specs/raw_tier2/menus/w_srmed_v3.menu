;; 1 IIID IVD DEV DEPTHC
'(
name: W_SRMED_V3
label: "SRME Y-X to F-X"
value_tab: 50

parameter: MAXTIME
text: "Maximum trace time (msec)"
type: typein:
type_desc:  ( int: 7 1 nil)
value: 6000
mouse_text: "Maximum trace time to process (msec)."

parameter: HDR_VAL1
text: "Primary key of regularization"
type: function:
type_desc: (header_list headers )
value: "SOURCE  "
selected_item: "SOURCE  "
mouse_text: "Use MB1 to specify the Primary key trace header entry of regularization."
plot_label: t

parameter: FILENAME
text: "Trace Header file name"
type: typein:
type_desc: ( :string 32 )
value: "trchdrs"
mouse_text: "Specify the name of the file to restore the Trace Headers from."
plot_label: t

parameter: DEBUG
text: "Debug mode?"
type: boolean:
value: nil
mouse_text: "If 'Yes', you must execute this program yourself using a debugger."

exec_data:
	("ST_W_SRMED_V3"
		("GENERAL"
			("program"   implicit: "w_srmed_v3.exe" )
			("DEBUG"     implicit: (if (value 'DEBUG) 2 0 ) )
			("version"   implicit: "ProMAX $Id: w_srmed_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
			("MAXTIME"   implicit: (value 'MAXTIME))
			("HDR_VAL1"  implicit: (value 'HDR_VAL1))
			("FILENAME"  implicit: (value 'FILENAME))
		)
	)

rules: 	(

(socket_debug_rule t
		(if (= (printenv 'SOCKET_DEBUG) "t")
			(do_show 'DEBUG)
			(do_not_show 'DEBUG) )  )

	)

)
