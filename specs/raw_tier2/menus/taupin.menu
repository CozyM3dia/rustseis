; IIID IVD 1 BSI FIELD DEV DEPTHC BHSS
'(
 name: taupin
label: "Tau-P Inverse Transform"
value_tab: 45

parameter: PMIN
text: "Minimum slowness (ms/km or ms/kf)"
type: typein:
type_desc: (real: 8)
value: -250.0
mouse_text: "This is the minimum P value in milliseconds per kilometer or kilofoot to inverse transform."

parameter: PMAX
text: "Maximum slowness (ms/km or ms/kf)"
type: typein:
type_desc: (real: 8)
value: 250.0
mouse_text: "This is the maximum P value in milliseconds per kilometer or kilofoot to inverse transform."

parameter: WINTAU
text: "Place a window on Tau?"
type: boolean:
value: nil
mouse_text: "The default is to use the Minimum Tau generated by TAUP."

parameter: TAUMIN
text: "Minimum Tau of interest (ms)"
type: typein:
type_desc: (real: 8 )
value: 0.0
mouse_text: "This is the minimum input Tau (intercept time) to consider."

parameter: TAUMAX
text: "Maximum Tau of interest (ms)"
type: typein:
type_desc:  (real: 8)
value: 2000.0
mouse_text: "This is the maximum input Tau (intercept time) to consider."

parameter: TMIN
text: "Minimum time of interest (ms)"
type: typein:
type_desc: (real: 8)
value: 0.0
mouse_text: "This is the minimum time value to output, in milliseconds."


parameter: TMAX
text: "Maximum time of interest (ms)"
type: typein:
type_desc: (real: 8)
value: 2000.0
mouse_text: "This is the maximum time value to output, in milliseconds."

parameter: NTROUSER
text: "Maximum number of output TX offsets"
type: typein:
type_desc: (int: 8 1 99999 )
value: 500
mouse_text: "If no database exists, you must supply the maximum number of TX 
traces to be output.  Should be the same as maximum inputs to Forward Tau P."

parameter: MODE
text: "Tau-P Inversion mode"
type: pop_choose:
type_desc: (
("Original" 1 "Transform back to the original ensemble.")
("User defined X" 2 "Transform to a user defined set of offsets.") )
value: 1
mouse_text: "Specify how offsets are to be determined."

parameter: OFFSETS
text: "Enter a list of offsets (meters or ft)"
type: edit:
type_desc: (31 80 5 " FORMAT: offset1,offset2, begin - end, increment
 EXAMPLE: -2000 - -1500(100),1000,1200   yields traces with offsets
 -2000, -1900, -1800, -1700, -1600, -1500, 1000, and 1200.
 HELP: EMACS Editor Widget (scroll help with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A             Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E             Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys     Delete one character to the LEFT of the cursor
 E:  Ctrl-D                     Delete one character to the RIGHT of the cursor
 E:  Ctrl-K             KILL to the end of the line (from the cursor)
 E:  Ctrl-Y             YANK back the contents of the kill buffer; 'Cut and
                          paste'; (Can move the cursor first) " 3 )
value: "-2000 - -100(100),1000,1200 "
mouse_text: "Enter a list of offsets which may include ranges of offsets."

parameter: STKZERX
text: "Zero offset for stacked data (X)"
type: typein:
type_desc: (real: 8)
value: 0.0
mouse_text: "For stacked data, define the X location to use for zero offset."
 
parameter: STKZERY
text: "Zero offset for stacked data (Y)"
type: typein:
type_desc: (real: 8)
value: 0.0
mouse_text: "For stacked data, define the Y location to use for zero offset."
 
;parameter: DOSINC
;text: "Use a Sinc interpolation?"
;type: boolean:
;value: nil
;mouse_text: "If YES, a Sinc interpolation is used.  The default is linear."

parameter: REMUT_OP
text: "Apply mute after Taup inversion?"
type: boolean:
value: t
mouse_text: "Set to 'Yes' to re-apply previously applied mutes after inversion."

exec_data:("TAUPIN"
	      ("GENERAL"
	        ("version" implicit: "ProMAX $Id: taupin.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
		("PMIN"     implicit: (value 'PMIN))
		("PMAX"     implicit: (value 'PMAX))
		("WINTAU"   implicit: ( if (value 'WINTAU) 1 0 ))
		("TAUMIN"   implicit: (value 'TAUMIN))
		("TAUMAX"   implicit: (value 'TAUMAX))
		("TMIN"     implicit: (value 'TMIN))
		("TMAX"     implicit: (value 'TMAX))
		("MODE"     implicit: (value 'MODE))
		("NTROUSER" implicit: (value 'NTROUSER))
		("OFFSETS"  implicit: (value 'OFFSETS))
                ("STKZERX"  implicit: (value 'STKZERX))
                ("STKZERY"  implicit: (value 'STKZERY))
;		("DOSINC"   implicit: ( if (value 'DOSINC) 1 0 ))
		("REMUT_OP" implicit: ( if (value 'REMUT_OP) 1 0 ))
 	     )
           )
rules: (
  (rule1 ( = (value 'MODE ) 1 ) (progn (do_not_show 'OFFSETS)
				       (do_not_show 'STKZERX)
				       (do_not_show 'STKZERY) ))
  (rule3 ( = (value 'MODE ) 2 ) (progn (do_show 'OFFSETS)
				       (do_show 'STKZERX)
				       (do_show 'STKZERY) ))
  (rule4 (value 'WINTAU)        (progn (do_show 'TAUMIN)
				       (do_show 'TAUMAX))
                                (progn (do_not_show 'TAUMIN)
				       (do_not_show 'TAUMAX) ))
  )
)
