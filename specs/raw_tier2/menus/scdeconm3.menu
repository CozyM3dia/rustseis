; IIID IVD 1 BSI DEV DEPTHC BHSS
'(
  :name SCDECONM3
  :label "Gated SC Decon 3: Application"
  :value_tab 45

  :parameter db_option
  :text "Get APPLICATION gates from the DATABASE?"
  :type :boolean
  :value t
  :mouse_text "Select 'No' if a time gate parameter file was not created interactively. (Enter manually.)"

  :parameter GATELIST
  :text "Select APPLICATION Time Gate Parameter FILE"
  :type function:
  :type_desc ((parm_list "GAT") parms)
  :value  "no entry"
  :selected_item "* No Parameter File has been Selected *"
  :mouse_text "Select a time gate parameter file to use for operator application."
  :plot_label t

  :parameter PRIM_KEY
  :text "  SELECT Primary gate header word"
  :type function:
  :type_desc (header_list headers)
  :value "SOURCE  "
  :selected_item "Live source number"
  :mouse_text "Select a header word to use as the PRIMARY key for specifying gate parameters."
  :plot_label t

  :parameter SCND_KEY
  :text "  SELECT Secondary gate header word"
  :type function:
  :type_desc (header_list headers)
  :value "AOFFSET "
  :selected_item "Absolute value of offset"
  :mouse_text "Select a header word to use as the optional SECONDARY key for specifying gate parameters."
  :plot_label t

  :parameter DCN_GATE
  :text "  Specify APPLICATION gate parameters"
  :type edit:
  :type_desc (30 80 5 " FORMAT: Primary Gate Location Value: (Secondary Gate Loc. Value):Time Gate(s)/
 EXAMPLE: 101:0.0:700-2000 / 101:5280.0:1200-2200 /
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A	Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E	Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K	KILL to the end of the line (from the cursor)
 E:  Ctrl-Y	YANK back the contents of the kill buffer; 'Cut and paste';
		(Can move the cursor first) " 3 )
  :value "1:0:700-2500/1:2640:1000-2800/1:5280:1500-3000/"
  :mouse_text "Define the time gate(s) for operator application."
  :plot_label t

  :parameter COMPONENTS
  :text "Components of spectral decomposition"
  :type multiple_choose:
  :type_desc ( ("SHOT"    :shot "Include source component in spectral decomposition." ) 
			   ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) 
			   ("OFFSET"  :offset "Include offset component in spectral decomposition.")
			   ("CDP"     :cdp "Include cdp component in spectral decomposition.")
			   ("OTHER"   :other "Include user-defined component in spectral decomposition.") )
  :selected_item ( ("SHOT"    :shot "Include source component in spectral decomposition." ) 
				   ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) 
				   ("OFFSET"  :offset "Include offset component in spectral decomposition.")
				   ("CDP"     :cdp "Include cdp component in spectral decomposition.") )
  :mouse_text "Select components used in spectral decomposition. MUST MATCH Stage 1 selections."
  :plot_label t

  :parameter OTHERNAM
  :text "  SELECT header word for OTHER component"
  :type function:
  :type_desc (header_list headers)
  :value "NONE    "
  :selected_item "No trace header entry selected"
  :mouse_text "Select header word to use as OTHER component of spectral decomposition. MUST MATCH Stage 1 selection."
  :plot_label t

  :parameter OTHERMIN
  :text "  Minimum value for OTHER"
  :type :typein
  :type_desc (:int 7 1 nil )
  :value 1
  :mouse_text "Enter minimum value for OTHER component header word. MUST MATCH Stage 1 value."
  :plot_label t

  :parameter OTHERMAX
  :text "  Minimum value for OTHER"
  :type :typein
  :type_desc (:int 7 1 nil )
  :value 1
  :mouse_text "Enter maximum value for OTHER component header word. MUST MATCH Stage 1 value."
  :plot_label t

  :parameter OTHERINC
  :text "  Increment for OTHER"
  :type :typein
  :type_desc (:int 7 1 nil )
  :value 1
  :mouse_text "Enter increment for OTHER component header word. MUST MATCH Stage 1 value."
  :plot_label t

  :parameter APPLICATION
  :text "Components to use in application"
  :type :multiple_choose
  :type_desc ( ("SHOT"    :shot "Include source component in spectral decomposition." ) 
			   ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) 
			   ("OFFSET"  :offset "Include offset component in spectral decomposition.")
			   ("CDP"     :cdp "Include cdp component in spectral decomposition.") )
  :selected_item ( ("SHOT"    :shot "Include source component in spectral decomposition." ) 
				   ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) )
  :mouse_text "Select components to use in operator design."
  :plot_label t

  :parameter KILL_OPT
  :text "Kill trace if component missing?"
  :type :boolean
  :value nil
  :mouse_text "Select 'Yes' to kill trace if no spectrum for one component. Select 'No' to deconvolve trace with remaining components."
  :plot_label t

  :parameter ISOL_OPT
  :text "Solution option"
  :type pop_choose:
  :type_desc (
			  ("Surface consistent deconvolution" 1 "Use SOLUTION ensemble spectral estimates in operator design.")
			  ("Ensemble deconvolution"           2 "Use INITIAL ensemble spectral estimates in operator design.")
			  )
  :mouse_text "Select the spectral estimates to use in operator design."
  :plot_label t

  :parameter OFFS_RES
  :text "Limit offsets?"
  :type :boolean
  :value nil
  :mouse_text "Select 'Yes' if a restricted range of offsets were used in estimation and decomposition. MUST MATCH Stage 1 selection."
  :plot_label t

  :parameter OFFS_MIN
  :text "  Minimum absolute offset"
  :type :typein
  :type_desc (:real 7 0. nil )
  :value 1000.
  :mouse_text "Enter minimum absolute offset used. MUST MATCH Stage 1 value."
  :plot_label t

  :parameter OFFS_MAX
  :text "  Maximum absolute offset"
  :type :typein
  :type_desc (:real 7 2. nil )
  :value 3000.
  :mouse_text "Enter maximum absolute offset used. MUST MATCH Stage 1 value."
  :plot_label t

  :parameter DCN_TYPE
  :text "TYPE of deconvolution"
  :type pop_choose:
  :type_desc (  
			  ("Spiking"                 1 "Apply Wiener-Levinson Spiking Decon." ) 
			  ("Phase correction only"   2 "Apply Weiner-Levinson Spiking Decon without spectral whitening.")
			  ("Spectral whitening only" 3 "Apply Weiner-Levinson Spiking Decon without phase correction.")
			  ("Predictive"              4 "Apply Weiner-Levinson Predictive Decon.")
			  )
  :mouse_text "Select type of decon operator to design and apply."
  :plot_label t

  :parameter DCN_OPER
  :text "Decon operator length(s)"
  :type :typein
  :type_desc (:string 30)
  :value "80.0"
  :mouse_text "Enter operator length, in ms, for each gate. MUST MATCH Stage 1 values. Example: 80.0, 120.0, 160.0."
  :plot_label t

  :parameter DCN_WHTN
  :text "Operator 'white noise' level(s)"
  :type :typein
  :type_desc (:string 30)
  :value "0.1"
  :mouse_text "Enter 'white noise' level, in PERCENT, for each gate. May DIFFER from Stage 1 values. Example: 0.1, 0.5."
  :plot_label t

  :parameter DCN_PRED
  :text "Operator prediction distance(s)"
  :type :typein
  :type_desc (:string 30)
  :value "35.0"
  :mouse_text "Enter operator prediction distance, in ms, for each gate. Example: 35.0,45.0."
  :plot_label t

  :parameter TWIN_MIN
  :text "Gate rejection factor"
  :type :typein
  :type_desc ( :real 7 0.0 nil )
  :value 2.0
  :mouse_text "Eliminate gates with fewer LIVE samples than this factor times the operator length. May DIFFER from Stage 1 value."
  :plot_label t

  :parameter filter_option
  :text "Apply a bandpass filter after decon?"
  :type :boolean
  :value nil
  :mouse_text "Select 'Yes' to apply a bandpass filter after decon."
  :plot_label t

  :parameter FLT_FREQ
  :text "  Bandpass filter frequency values"
  :type :typein
  :type_desc ( :string 25 )
  :value "4-8-90-120"
  :mouse_text "Enter four 'corner' frequencies: F1(0%) - F2(100%) - F3(100%) - F4(0%). Hanning tapers are used for ramps."
  :plot_label t

  :parameter AMORTOPT
  :text "Amortize the operator spectrum?"
  :type :boolean
  :value nil
  :mouse_text "Select 'Yes' to amortize operator spectrum at high and low frequencies."
  :plot_label t

  :parameter AMOFREQL
  :text "  Low-end amortization frequency (Hz)"
  :type :typein
  :type_desc ( :real 4 0.0001 nil )
  :value 8.0
  :mouse_text "Enter the low-end frequency value at which you wish to start the operator amortization."
  :plot_label t

  :parameter AMOROLLL
  :text "  Low-end amortization slope (dB/oct)"
  :type :typein
  :type_desc ( :real 4 0.0 nil )
  :value 30.0
  :mouse_text "Enter the low-end amortization operator slope in decibels/octave."
  :plot_label t

  :parameter AMOFREQH
  :text "  High-end amortization frequency (Hz)"
  :type :typein
  :type_desc ( :real 4 0.0001 nil )
  :value 100.0
  :mouse_text "Enter the high-end frequency value at which you wish to start the operator amortization."
  :plot_label t

  :parameter AMOROLLH
  :text "  High-end amortization slope (dB/oct)"
  :type :typein
  :type_desc ( :real 4 0.0 nil )
  :value 72.0
  :mouse_text "Enter the high-end amortization operator slope in decibels/octave."
  :plot_label t

  :parameter remute_option
  :text "Reapply trace mute after decon?"
  :type :boolean
  :value t
  :mouse_text "Select 'Yes' to reapply trace mutes (such as first break suppression mutes) after decon."
  :plot_label t

  :parameter ID_CHARS
  :text "4-character file ID"
  :type :typein
  :type_desc ( :string 4 )
  :value "SPEC"
  :mouse_text "Enter a 4-character (or numeric) identifier (NO blanks) for the input spectrum file."
  :plot_label t


  :exec_data 
  ("SCDECONM"
   ("GENERAL"
	("version" :implicit "ProMAX $Id: scdeconm3.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
	("ISTAGE"   :implicit 4)			;Apply decon
	("GATELIST" :implicit (if (value 'db_option)(value 'GATELIST) "NONE"))
	("PRIM_KEY" :implicit (value 'PRIM_KEY))
	("SCND_KEY" :implicit (value 'SCND_KEY))
	("DCN_GATE" :implicit (value 'DCN_GATE))
	("DCN_TYPE" :implicit (value 'DCN_TYPE))
	("DCN_PRED" :implicit (value 'DCN_PRED))
	("DCN_OPER" :implicit (value 'DCN_OPER))
	("DCN_WHTN" :implicit (value 'DCN_WHTN))
	("TWIN_MIN" :implicit (value 'TWIN_MIN))
	("FLT_FREQ" :implicit (if (value 'filter_option) (value 'FLT_FREQ) "    ")) 
	("AMORTOPT" :implicit ( if (value 'AMORTOPT) 1 0 ))
	("AMOFREQL" :implicit (value 'AMOFREQL))
	("AMOROLLL" :implicit (value 'AMOROLLL))
	("AMOFREQH" :implicit (value 'AMOFREQH))
	("AMOROLLH" :implicit (value 'AMOROLLH))
	("REMUTE"   :implicit ( if (value 'remute_option) 1 0 ))

	("S_DECOMP" :implicit ( if (member :shot (value 'COMPONENTS)) 1 0 ))
	("R_DECOMP" :implicit ( if (member :rcvr (value 'COMPONENTS)) 1 0 ))
	("O_DECOMP" :implicit ( if (member :offset (value 'COMPONENTS)) 1 0 ))
	("C_DECOMP" :implicit ( if (member :cdp (value 'COMPONENTS)) 1 0 ))
	("X_DECOMP" :implicit ( if (member :other (value 'COMPONENTS)) 1 0 ))

	("SHOT_COM" :implicit ( if (member :shot (value 'APPLICATION)) 1 0 ))
	("RCVR_COM" :implicit ( if (member :rcvr (value 'APPLICATION)) 1 0 ))
	("OFFS_COM" :implicit ( if (member :offset (value 'APPLICATION)) 1 0 ))
	("CDPD_COM" :implicit ( if (member :cdp (value 'APPLICATION)) 1 0 ))
	("OTHR_COM" :implicit ( if (member :other (value 'APPLICATION)) 1 0 ))

	("OTHERNAM" :implicit (value 'OTHERNAM))
	("OTHERMIN" :implicit (value 'OTHERMIN))
	("OTHERMAX" :implicit (value 'OTHERMAX))
	("OTHERINC" :implicit (value 'OTHERINC))
	("KILL_OPT" :implicit ( if (value 'KILL_OPT) 1 0 ))
	("ISOL_OPT" :implicit (value 'ISOL_OPT ))
	("OFFS_RES" :implicit ( if (value 'OFFS_RES) 1 0 ))
	("OFFS_MIN" :implicit (value 'OFFS_MIN ))	
	("OFFS_MAX" :implicit (value 'OFFS_MAX ))	
	("ID_CHARS" :implicit (value 'ID_CHARS))
	)
   )


  :rules 
  (

   (rule_time_gate (value 'db_option)
				   (progn	(do_show 'GATELIST)
							(do_not_show '(PRIM_KEY SCND_KEY DCN_GATE)))
				   (progn	(do_not_show 'GATELIST)
							(do_show '(PRIM_KEY SCND_KEY DCN_GATE))))

   (rule_other_show (member :other (value 'COMPONENTS))
					(do_show '(OTHERNAM OTHERMIN OTHERMAX OTHERINC))
					(do_not_show '(OTHERNAM OTHERMIN OTHERMAX OTHERINC)) )

   (rule_other_text (value 'OTHERNAM)
					(progn
					  (set_text 'OTHERMIN (string_concatinate "  Minimum value for " (value 'OTHERNAM)))
					  (set_text 'OTHERMAX (string_concatinate "  Maximum value for " (value 'OTHERNAM)))
					  (set_text 'OTHERINC (string_concatinate "  Increment for " (value 'OTHERNAM)))
					  (set_mouse_text 'OTHERMIN (string_concatinate "Enter minimum value for OTHER component header word " (value 'OTHERNAM) " MUST MATCH Stage 1 value."))
					  (set_mouse_text 'OTHERMAX (string_concatinate "Enter maximum value for OTHER component header word " (value 'OTHERNAM) " MUST MATCH Stage 1 value."))
					  (set_mouse_text 'OTHERINC (string_concatinate "Enter increment for OTHER component header word " (value 'OTHERNAM) " MUST MATCH Stage 1 value.")) ) )

   (app_type_desc_rule (value 'COMPONENTS)
					   (set_type_desc 'APPLICATION (selected_item 'COMPONENTS)))

   (app_error_rule1 (and (member :other (value 'APPLICATION))
						 (not (member :other (value 'COMPONENTS))) )
					(add_error 'APPLICATION "OTHER is not part of decomposition")
					(delete_error 'APPLICATION "OTHER is not part of decomposition") )
 
   (app_error_rule2 (and (member :cdp (value 'APPLICATION))
						 (not (member :cdp (value 'COMPONENTS))) )
					(add_error 'APPLICATION "CDP is not part of decomposition")
					(delete_error 'APPLICATION "CDP is not part of decomposition"))
 
   (app_error_rule3 (and (member :offset (value 'APPLICATION))
						 (not (member :offset (value 'COMPONENTS))) )
					(add_error 'APPLICATION "OFFSET is not part of decomposition")
					(delete_error 'APPLICATION "OFFSET is not part of decomposition") )
 
   (app_error_rule4 (and (member :rcvr (value 'APPLICATION))
						 (not (member :rcvr (value 'COMPONENTS))) )
					(add_error 'APPLICATION "RCVR is not part of decomposition")
					(delete_error 'APPLICATION "RCVR is not part of decomposition"))
   
   (app_error_rule5 (and (member :shot (value 'APPLICATION))
						 (not (member :shot (value 'COMPONENTS))) )
					(add_error 'APPLICATION "SHOT is not part of decomposition")
					(delete_error 'APPLICATION "SHOT is not part of decomposition") )
   
   (rule_offs_res (member :offset (value 'APPLICATION))
				  (do_show 'OFFS_RES)
				  (do_not_show 'OFFS_RES))
 
   (rule_offs_min_max (and (showing 'OFFS_RES) (value 'OFFS_RES))
					  (do_show '(OFFS_MIN OFFS_MAX))
					  (do_not_show '(OFFS_MIN OFFS_MAX)))
 
   (rule_dcn_pred (= (value 'DCN_TYPE) 4)
				  (do_show 'DCN_PRED)
				  (do_not_show 'DCN_PRED))
 
   (rule_filter_opt (value 'filter_option)
					(do_show 'FLT_FREQ)
					(do_not_show 'FLT_FREQ))
 
   (rule_amort_opt (value 'AMORTOPT)
				   (do_show '(AMOFREQL AMOROLLL AMOFREQH AMOROLLH ))
				   (do_not_show '(AMOFREQL AMOROLLL AMOFREQH AMOROLLH )))
 
   )
  )
