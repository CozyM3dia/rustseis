; FIELD 1 DEV DEPTHC IIID IVD
'(
:name spreadsheet
:label "Crooked Line Geom Spreadsheet*"
:value_tab 40

:exec_data ("CALLER  "
	    ("SPECIAL"
	     ("TOOLTYPE"  :implicit "STAND_ALONE")
	     ("PATHNAME"  :implicit "module_call.exe")
	     )
	    ("GENERAL"
             ("version" implicit: "ProMAX $Id: geomspread_crooked.menu 43060 2008-07-09 23:26:16Z dgrygier $ $Revision: 43060 $ $Date: 2008-07-09 17:26:16 -0600 (Wed, 09 Jul 2008) $")
	     ("EXEC"    :implicit (promax_path "sys/exe/geomspread"))
	     ("NARGS"   :implicit 7 )
	     ("ARG"     :implicit "-area" )
	     ("ARG"     :implicit (current_area) )
	     ("ARG"     :implicit "-line" )
	     ("ARG"     :implicit (current_line) )
	     ("ARG"     :implicit "-land" )
	     ("ARG"     :implicit "-crooked" )
	     ("ARG"     :implicit ^-name \"ProMAX 2D Crooked Line Geometry Spreadsheet: Copyright 1995 Advance Geophysical Inc.  All rights Reserved.\"^ )
	     )
	    )
)




