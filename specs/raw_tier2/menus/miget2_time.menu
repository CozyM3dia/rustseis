; IIID IVD 1 PROSPECTOR DEV DEPTHC
'(
 name: MIGET2_TIME
label: "Fast Explicit FD Time Mig."
value_tab: 50

parameter: dcdp
text: "CDP interval (feet or meters)"
type: typein:
type_desc:  ( real: 7 0.0 nil)
value: 999999.
mouse_text: "CDP spacing in feet or meters (consistent with headers)."

parameter: fmax
text: "Maximum frequency (in Hz)"
type: typein:
type_desc:  ( real: 5 0.001 nil )
value: 50.0
mouse_text: "For efficiency, set this as low as possible.  Frequencies above this value will not be migrated."
plot_label: t

parameter: dt
text: "Time step for migration diffraction term"
type: typein:
type_desc:  ( real: 5 0.000 nil )
value: 0.0
mouse_text: "This value is generally near 20 milliseconds.  Larger values speed the program but steeper dips are not migrated.  0.0 defaults to the data sample rate."

parameter: padTime
text: "Percent to pad trace length"
type: typein:
type_desc:  ( real: 6 0.0 400.0 )
value: 30.0
mouse_text: "Padding the trace length eliminates data wrap around from the bottom of the section."

parameter: vel_b
text: "Get interval velocities from database?"
type: boolean:
value: t
mouse_text: "This migration uses interval velocities in time.  Do you want to get these velocities from the database?"
plot_label: t

parameter: velf
text: "  Select interval vs. time velocity file"
type: function:
type_desc:  ((parm_list "VIT") parms)
value: "no entry"
selected_item: "No velocity file has been selected!"
mouse_text: "Use Mouse Button 1 to select a field in time from the interval velocity vs. time database."
plot_label: t

parameter: vels
text: "Interval velocities in time for migration"
type: edit:
type_desc: (20 80 5 " FORMAT: CDP1: T1-V1,T2-V2,...,Tn-Vn / CDP2: T1-V1,T2-V2,...,Tn-Vn /
 EXAMPLE: 1:0-5000,900-6725,1500-8571,2000-9670/ 101:0-5100,860-6690,2000-9852/
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
 value: "XXX"
mouse_text: "Use Mouse Button 1 to edit velocities for migration. (See editor for examples.)"
plot_label: t

parameter: change_mem
text: "Change paneling parameters?"
type: boolean:
value: nil
mouse_text: "Paneling is used to migrate large datasets in overlapping units."

parameter: max_memory
text: "   Maximum Memory for migration to use in megabytes"
type: typein:
type_desc:  ( real: 4 0. nil )
value: 24.
mouse_text: "When the migration requires more memory than this limit, the migration is done in over
lapping panels."

parameter: aperture
text: "   Migration aperture to use for panel overlap"
type: typein:
type_desc:  ( real: 7 0. nil )
value: 0.0
mouse_text: "Specify feet or meters.  A value of 0.0 lets the program determine the migration aperture."


parameter: changeTapering
text: "Change the default tapering?"
type: boolean:
value: nil
mouse_text: "Tapering is automatically applied to the bottom and edges of the data.  Enter YES to change the amount of tapering."

parameter: ms_taper
text: "   Bottom taper (in milliseconds)"
type: typein:
type_desc: ( real: 6 0 nil )
value: 200.0
mouse_text: "The bottom of all traces is tapered to avoid data truncation artifacts when padded with zeros."

parameter: taperTop
text: "   Upper edge taper (in traces)"
type: typein:
type_desc: ( int: 3 0 nil )
value: 2
mouse_text: "Edge tapering will be varied linearly between the upper and lower parts of the section."

parameter: taperBot
text: "   Lower edge taper (in traces)"
type: typein:
type_desc: ( int: 4 0 nil )
value: 20
mouse_text: "Edge tapering will be varied linearly between upper and lower parts of section. Usually greater toward bottom of section."

parameter: keepSampRat
text: "Retain input sample rate?"
type: boolean:
value: nil
mouse_text: "The migration can run significantly faster if it can internally resample the data.  Aliasing is avoided based on your maximum frequency."

parameter: remute_b
text: "Re-apply trace mutes?"
type: boolean:
value: t
mouse_text: "Yes: trace mutes will be re-applied after migration.  No: Mutes will be adjusted as necessary."
plot_label: t

parameter: rekill_b
text: "Re-kill dead traces?"
type: boolean:
value: t
mouse_text: "If 'Yes', traces that were dead (all zeros) before migration will be killed after migration.  If 'No', dead traces will become live."

parameter: DEBUG
text: "debug mode?"
type: boolean:
value: nil
mouse_text: "If 'Yes,' use debug mode for executing the stand alone module."


exec_data: (
    ("PAD_TRACES"
		("GENERAL"
			("version" implicit: "ProMAX $Id: miget2_time.menu 41831 2007-09-01 20:51:38Z crs $ $Revision: 41831 $ $Date: 2007-09-01 14:51:38 -0600 (Sat, 01 Sep 2007) $")
			("header" implicit: "CDP     ")
			("defineBounds" implicit: 0 )
			("dval" implicit: 1.0)
			("removeTraces" implicit: 1)
		)
	    )	
	   ("MIGTAPER"
		("GENERAL"
			("ms_taper" implicit: (if (value 'changeTapering) (value 'ms_taper) 200. ) )
			("estimateTaper" implicit: 0 )
			("taperTop" implicit: (if (value 'changeTapering) (value 'taperTop) 2 ) )
			("taperBot" implicit: (if (value 'changeTapering) (value 'taperBot) 20) )
		)
   	)


	   ("ST_FAST_FD_TIME"
		("GENERAL"
; The following are parameters for the stand alone capability
		   	("program"   implicit: "miget2_time.exe" )
; if no machine name is given, it means execute on this machine. 
		   	("machine"     implicit: " " )  
		   	("prog_location"   implicit: 1 ) 
;  if no ruser is given execute as the current user.
		   	("ruser"   implicit: " " )
; DEBUG mode means the user must start the remote program, probably under dbx.
		   	("DEBUG"   implicit: (if (value 'DEBUG) 2 0) )
;		   	("DEBUG"   implicit: 0 )

; Normal program parameters
		("dcdp" implicit: (value 'dcdp))
		("fmax" implicit: (value 'fmax))
		("dt" implicit: (value 'dt))
		("rekill" implicit: (if (value 'rekill_b) 1 0))
		("remute" implicit: (if (value 'remute_b) 1 0))
		("keepSampRat" implicit: (if (value 'keepSampRat) 1 0))
		("max_memory" implicit: (value 'max_memory))
		("padTime" implicit: (* 0.01 (value 'padTime)))
		("aperture" implicit: (value 'aperture))
		("velf" implicit: (if (value 'vel_b) (value 'velf) "NONE"))
		("vels" implicit: (value 'vels))
		("useTable" implicit: 1 )
	)
   )
    ("RMPAD_TRACES"
		("GENERAL"
		)
	    )	
)


rules: (
	(cdp_interval_default_rule  (AND ( = (value 'dcdp) 999999.) (db_parmget_line "DCDPILNz"))
		(set_value 'dcdp (db_parmget_line "DCDPILNz")))
	(rule1 (showing 'vels) (do_not_show 'velf) (do_show 'velf))
	(rule2 (value 'vel_b) (do_not_show 'vels) (do_show 'vels))
	(rule3 (value 'change_mem) (do_show 'max_memory) (do_not_show 'max_memory))
	(rule3 (value 'change_mem) (do_show 'aperture) (do_not_show 'aperture))
	(vels_default_rule1 (and 
		(equal (value 'vels) "XXX")
		(= (db_parmget_line "IUNITSz") 1))
		(set_value 'vels 
"1:0-5000,1000-7500,2000-9500,3000-11500,4000-14000,6000-18000,8000-22000/"))
	(vels_default_rule2 (equal (value 'vels) "XXX")
		(set_value 'vels
"1:0-1480,1000-2500,2000-3200,3000-4000,4000-4500,6000-6000,8000-7000/"))

 (rule3 (value 'changeTapering)    (progn 
 				    (do_show 'ms_taper)
				    (do_show 'taperTop)
				    (do_show 'taperBot))
			     (progn 
 				    (do_not_show 'ms_taper)
				    (do_not_show 'taperTop)
				    (do_not_show 'taperBot)) )
(socket_debug_rule t
	(if (= (printenv 'SOCKET_DEBUG) "t")
		(do_show 'DEBUG) (dont_show 'DEBUG) ) )
)

)

