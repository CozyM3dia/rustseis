;; 1 IIID IVD DEV DEPTHC
'(
name: W_SRMEA_V2
label: "SRME T-X to F-X"
value_tab: 50

parameter: MAXTIME
text: "Maximum trace time (msec)"
type: typein:
type_desc:  ( int: 7 1 nil)
value: 6000
mouse_text: "Maximum trace time to process (msec)."

parameter: DEBUG
text: "Debug mode?"
type: boolean:
value: nil
mouse_text: "If 'Yes', you must execute this program yourself using a debugger."

exec_data:
	("ST_W_SRMEA_V2"
		("GENERAL"
			("program"   implicit: "w_srmea_v2.exe" )
			("DEBUG"     implicit: (if (value 'DEBUG) 2 0 ) )
			("version"   implicit: "ProMAX $Id: w_srmea_v2.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
			("MAXTIME"   implicit: (value 'MAXTIME))
		)
	)

rules: 	(

(socket_debug_rule t
		(if (= (printenv 'SOCKET_DEBUG) "t")
			(do_show 'DEBUG)
			(do_not_show 'DEBUG) )  )

	)

)
