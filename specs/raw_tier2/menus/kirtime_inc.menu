	; Antialias Advance Parameters	
	(SHOWANISO_rule (and (= (value 'ADV_AALI) 1) (= (value 'ADVANCED) 1) )
			(progn
			  (do_show 'AANBAND)
			  (do_show 'MAXFREQ)
			  )
			(progn
			  (do_not_show 'AANBAND)
			  (do_not_show 'MAXFREQ)
			  )
			)


	; Preprocess Parameters
	 (PREPROC_PAR_rule (and (= (value 'ADVANCED) 1) (= (value 'PREPROC) 1) ) 
			    (progn 
			      (if (value 'KT2D) (do_show 'PHASECO2) (do_show 'PHASECO3)) 
			      (do_show 'RMSTHRE) 
			      (do_show 'T_POWER) 
			      (do_show 'DB_PER_S) 
			      ) 
			    (progn 
			      (if (value 'KT2D) (do_not_show 'PHASECO2) (do_not_show 'PHASECO3))
			      (do_not_show 'RMSTHRE) 
			      (do_not_show 'T_POWER) 
			      (do_not_show 'DB_PER_S) 
			      )
			    )



	; Compression parameters
	(COMPRESSION_PAR_rule (and (= (value 'COMPRESSION ) 1) (= (value 'ADVANCED) 1) )
			      (do_show '(ICMPRTYP ICTKDIST)) 
			      (do_not_show '(ICMPRTYP ICTKDIST))
			      )

        ; Check Compression Parameter
	(COMPRESSION_rule (and  ( = (value 'ICMPRTYP) 4) (and (= (value 'COMPRESSION) 1) (= (value 'ADVANCED) 1) ) ) 
			  (progn 
			    (do_show 'CTKRMSDB)
			    )
			  (progn 
			    (do_not_show 'CTKRMSDB)
			    )
			  )


         (CLEANUP_rule (= (value 'JOBTYPE) 3)
                          (progn
                            (do_not_show 'CHKSAVE)
                            (do_not_show 'RESTART)
                          )
                          (progn
                            (do_show 'CHKSAVE)
                            (do_show 'RESTART)
                          )
		      )

	 (CHKHOURS_rule (and (showing 'CHKSAVE) (value 'CHKSAVE))
			  (progn
			    (do_show 'CHKHOURS)
			    (do_show 'CHKSNAP)
			    (do_show 'CHKDIRS)
			    (do_show 'VBROWSE)
			  ) 
			  (progn
			    (do_not_show 'CHKHOURS)
			    (do_not_show 'CHKSNAP)
			    (do_not_show 'CHKDIRS)
			    (do_not_show 'VBROWSE)
			  )
			)

         (popup_dir_browser_rule ( = 1 (value 'VBROWSE))
             (progn
                 (setq trialname (xsystem (string_concatinate "PROMAX_FLOW_DIRECTORY=" (flow_directory) " " (promax_path "sys/bin/multidirselect") " " ^'^ (value 'CHKDIRS) ^'^ )))
                 (if (> (length trialname) 0) (set_value 'CHKDIRS trialname))
                 (set_value 'VBROWSE 0)
                 (set_selected_item 'VBROWSE (first (type_desc 'VBROWSE)))
              ))

	 (RESTART_rule (value 'RESTART)
			  (progn
                (do_not_show 'JOBTYPE)
			    )
			  (progn 
			    (do_show 'JOBTYPE)
			    )
			  )

	 

	; Debug Parameters
	(DEBUG_rule (do_not_show 'DEBUG))
	 (program_rule (and (= (value 'DEBUG) 1) (= (value 'ADVANCED) 1) )
		       (do_show 'program) (do_not_show 'program))

	 ; Block NMO
	 (BLKNMO_rule (= (value 'ADVANCED) 1)
			(do_show 'BLKNMO) (do_not_show 'BLKNMO) )
	 (BLKNMO_PAR_rule (and (showing 'BLKNMO) (= (value 'BLKNMO) 1) ) 
			    (progn 
			      (do_show 'BNMOTYP) 
			      ) 
			    (progn 
			      (do_not_show 'BNMOTYP) 
			      )
			    )
	 (BNMOTYPPARM_rule (and (= (value 'ADVANCED) 1) (and (= (value 'BLKNMO) 1) (> (value 'BNMOTYP) 1) ) )
			    (progn 
			      (do_show 'BNMOSTP)
			      ) 
			    (progn 
			      (do_not_show 'BNMOSTP)
			      )
			    )


	; Begin Image Set Parameters

	; Image Set Parameters	
	(P_SHOWIM_rule (or (value 'ISETNAM) (or ( value 'P_NAME1) (or (value 'P_NAME2) (or (value 'P_NAME3) (value 'P_NAME4) ) )  ) ) 
		(progn 
		  (let ( ( result ) )
		    
		    (if (member :name4 (value 'ISETNAM) ) 
			(progn
			  (setq result
				( push (list (value 'P_NAME4) 4 "Display Set 4" ) result )
				)
			  (set_value 'P_SHOWIM 4)
			  )
		      )

		    (if (member :name3 (value 'ISETNAM) ) 
			(progn
			  (setq result
				( push (list (value 'P_NAME3) 3 "Display Set 3" ) result )
				)
			  (set_value 'P_SHOWIM 3)
			  )
		      )

		    (if (member :name2 (value 'ISETNAM) ) 
			(progn
			  (setq result
				( push (list (value 'P_NAME2) 2 "Display Set 2" ) result )
				)
			  (set_value 'P_SHOWIM 2)
			  )
		      )

		    (if (member :name1 (value 'ISETNAM) ) 
			(progn
			  (setq result
				( push (list (value 'P_NAME1) 1 "Display Set 1" ) result )
				)
			 (set_value 'P_SHOWIM 1)
			 )
		      ) 
		    
		    (set_type_desc 'P_SHOWIM result)
		    (set_selected_item 'P_SHOWIM (first (type_desc 'P_SHOWIM ) ) )
		    )
		  
		  )
		)


