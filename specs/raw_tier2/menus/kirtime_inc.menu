; IIID IVD 1 PROSPECTOR DEV DEPTHC
;  Include Menu for Prestack Kirchhoff 2D/3D Time Mig.
;  The boolean parameter KT2D must be defined in the menus that include this.
'(
  parameter: NCPUS
  text: "Number of CPUS"
  type: typein:
  type_desc: ( int: 6 1 nil )
  value: 1
  mouse_text: "Enter the maximum number of processors to use."
  plot_label: t


  parameter: VELTAB
  text: "Table with RMS Velocity parameters"
  type: function:
  type_desc: ((parm_list "VEL") parms)
  value: "no entry"
  mouse_text: "Use Mouse Button 1 to select a RMS Velocity file from the menu."
  showp: t
  plot_label: t

  parameter: ANISOTAB
  text: "Table with ETA parameters"
  type: function:
  type_desc: ((parm_list "ETA") parms)
  value: "no entry"
  mouse_text: "Use Mouse Button 1 to select an ETA file for curved ray adjustments from the menu."
  showp: nil
  plot_label: t

  parameter: DCDP
  text: "CDP interval (ft or m)"
  type: typein:
  type_desc: ( real: 7 0.001 nil)
  value: 999999.
  mouse_text: "CDP spacing in feet or meters (consistent with headers)."
  showp: nil  ; turned on for 2D menu
  plot_label: t

  parameter: OTMAX
  text: "Maximum Image Output Time(ms)"
  type: typein:
  type_desc: ( real: 6 0.0 nil)
  value: 0.0
  mouse_text: "Enter the maximum output time for this run. - 0.0 = max time in input dataset."
  plot_label: t

  parameter: ISETNAM
  text: "Image Sets Selected"
  type: multiple_choose:
  type_desc: (
	      ("Set 1" :name1 "Image Set 1.")
	      ("Set 2" :name2 "Image Set 2.")
	      ("Set 3" :name3 "Image Set 3.")
	      ("Set 4" :name4 "Image Set 4.")
	      )
  :selected_item ( 
                  ("Set 1" :name1 "Image Set 1.")
                 )
  mouse_text: "Use MB1 to pop up a menu, and select up to 4 image sets."
  plot_label: t
  

  parameter: P_SHOWIM
  text: "Show Image Set"
  type: pop_choose:
  value: nil
  ;type_desc: ("INVALID")
  mouse_text: "Use MB1 to pop up a menu to select which image set parameters you want to display."



; Parameters for Image Set 1

  ; Output parameters
  parameter: FINLIN1
  text: "      Minimum Output Inline 1"
  type: typein:
  type_desc: ( int: 9 nil nil)
  value: -1
  mouse_text: "Enter the first output inline for this Image Set."
  showp: nil
  plot_label: t


  parameter: LINLIN1
  text: "      Maximum Output Inline 1"
  type: typein:
  type_desc: ( int: 9 nil nil)
  value: -1
  mouse_text: "Enter the last output inline for this Image Set."
  showp: nil
  plot_label: t

  parameter: INLINC1
  text: "      Inline Output Sampling Interval 1"
  type: typein:
  type_desc: ( int: 6 nil nil)
  value: 1
  mouse_text: "Enter the output inline increment for this Image Set."
  showp: nil
  plot_label: t

  parameter: FXLIN1
  text: "      Minimum Output Xline/CDP 1"
  type: typein:
  type_desc: ( int: 9 nil nil)
  value: -1
  mouse_text: "Enter the first output crossline/CDP for this Image Set."
  showp: nil
  plot_label: t

  parameter: LXLIN1
  text: "      Maximum Output Xline/CDP 1"
  type: typein:
  type_desc: ( int: 9 nil nil)
  value: -1
  mouse_text: "Enter the last output crossline/CDP for this Image Set."
  showp: nil
  plot_label: t

  parameter: XLINC1
  text: "      Xline/CDP Output Sampling Interval 1"
  type: typein:
  type_desc: ( int: 6 nil nil)
  value: 1
  mouse_text: "Enter the crossline/CDP output increment for this Image Set."
  showp: nil
  plot_label: t


;  parameter: OTMIN1
;  text: "     Minimum Output Time(ms) 1"
;  type: typein:
;  type_desc: ( real: 6 0.0 nil)
;  value: 0.0
;  mouse_text: "Enter the minimum output time in milliseconds for this Image Set."

  parameter: OTMAX1
  text: "      Maximum Output Time(ms) 1"
  type: typein:
  type_desc: ( real: 6 0.0 nil)
  value: 0.0
  mouse_text: "Enter the maximum output time for this Image Set. - 0.0 = max time in input dataset."
  plot_label: t
  showp: nil

;  parameter: ODT1
;  text: "      Output Sampling Rate(ms) 1"
;  type: typein:
;  type_desc: ( real: 6 0.0 nil)
;  value: 0.0 
;  mouse_text: "Enter the output sampling rate for this Image Set. - 0.0 = input sampling rate."


  ; Supergather parameters
  parameter: SG_APPL1
  text: "      Output Supergathers 1?"
  type: boolean:
  value: nil
  mouse_text: "Output a rectangle/range of image traces around each of the above locations."
  plot_label: t

  parameter: SGINWD1
  text: "         Inlines to combine 1"
  type: typein:
  type_desc: ( int: 9 1 nil)
  value: 1
  mouse_text: "Supply the odd inline width of each supergather rectangle."
  plot_label: t
  showp: nil

  parameter: SGXLWD1
  text: "         Crosslines/CDPs to combine 1"
  type: typein:
  type_desc: ( int: 9  nil)
  value: 1
  mouse_text: "Supply the odd crossline width of each supergather rectangle."
  plot_label: t
  showp: nil

  ; Antialias parameters
  parameter: AA_APPL1
  text: "      Apply Antialias 1?"
  type: boolean:
  value: nil
  mouse_text: "Antialias filters are used for cleaner imaging of steep dips and wide offset data."
  plot_label: t

  parameter: AAIMAGE1
  text: "         Use summation antialias only?"
  type: :boolean
  value: t
  mouse_text: "Summation antialias is generally sufficient, but in some circumstances properly imaged steep dips will appear aliased.  If tests show this effect, then set this parameter to 'No'."
  plot_label: t

  parameter: IMAGEDX1
  text: "         Nominal Inline Antialias Spacing 1"
  type: typein:
  type_desc: ( real: 6 -1.0 nil)
  value: -1.0
  mouse_text: "A smaller value than the default may increases frequency content at the expense of increased aliasing of events in the inline direction."
  plot_label: t

  parameter: IMAGEDY1
  text: "         Nominal Xline/CDP Antialias Spacing 1"
  type: typein:
  type_desc: ( real: 6 -1.0 nil)
  value: -1.0 
  mouse_text: "A smaller value than the default may increases frequency content at the expense of increased aliasing of events in the crossline/CDP direction."
  plot_label: t


  ; Inline or Crossline only?
  parameter: DIRECTN1
  text: "      Migration Direction 1"
  type: :pop_choose
  type_desc: (
	      ("No restriction" 0 "Full Migration.")
 	      ("Crossline Only" 1 "Crossline Only Migration.")
 	      ("Inline Only"    2 "Inline Only Migration.")
 	      )
  value: 0
  mouse_text: "You can restrict imaging to inline-only or crossline-only."
  showp: nil
  plot_label: t


  ; Aperture parameters
  parameter: APRTYP1
  text: "      Aperture Limit Type 1"
  type: multiple_choose:
  type_desc: (
	      ("Not Aperture Limited "  0 "Not Aperture Limited.")
	      ("Image Location Distance "  3 "Image Location Limited in panel.")
;	      ("Normal Ray Distance "   4 "Normal Ray Distance Limited.")
	      ("Stretch Mute "   5 "Stretch Mute Limited.")
	      ("Maximum Dip "   6 "Maximum Dip Limited.")
;	      ("Crossline Migration Only "   1 "Crossline Migration Only.")
;	      ("Inline Migration Only "   2 "Inline Migration Only.")
	      ("External Mute "   7 "External Mute Table.")
	      )
  :selected_item (
	               ("Stretch Mute "   5 "Stretch Mute Limited.")
                 )
  value: 5
  mouse_text: "Choose zero or more aperture limit restrictions for this Image Set."
  plot_label: t

  parameter: APDTYP1
  text: "         Distance Limit Measure 1"
  type: pop_choose:
  type_desc: (
	      ("Both source and receiver"  0 "Both source and receiver within distance limits.")
	      ("Either source or receiver"  1 "Either source or receiver within distance limits.")
	      ("Midpoint "  2 "Midpoint within distance limits.")
	      )
  :selected_item (
		  ("Both source and receiver"  0 "Both source and receiver within distance limits.")
                 )
  value: 0
  mouse_text: "Choose how you want to measure aperture distance for this Image Set."
  plot_label: t

  parameter: TBLAPD1
  text: "         Use time variable distance table(s)?"
  type: pop_choose:
  type_desc: (
              ("No"  0 "Do not use time-variable aperture distance for this image set.")
              ("Yes, elliptical"  1 "The time-variable aperture distance limit tables define a rounded cross section.")
              ("Yes, rectangular"  2 "The time-variable aperture distance limit tables define a rectangular cross section.")
              )
  :selected_item (
              ("No"  0 "Do not use time-variable aperture distance for this image set.")
                 )
  value: 0
  mouse_text: "Tables may be supplied to specify time and space variant distance limits."
  plot_label: t

  parameter: DBILD1
  text: "         Inline Aperture Distance Table Input Type 1"
  type: pop_choose:
  type_desc: (
	      ("Cutoffs from database" 1 "Cutoffs from database.")
 	      ("Manual cutoffs"   2 "Manual cutoffs.")
 	      )
  value: 1
  mouse_text: "Select how Inline Aperture Distance Cutoffs are input for this Image Set."
  showp: nil

  parameter: TBLILD1
  text: "         Inline Maximum Aperture Distance Table 1"
  type: :function
  type_desc: ((parm_list "MUT") parms)
  value: "no entry"
  mouse_text: "Use Mouse Button 1 to select a Mute file from the menu."
  plot_label: t

  parameter: DBXLD1
  text: "         Crossline Aperture Distance Table Input Type 1"
  type: pop_choose:
  type_desc: (
              ("Cutoffs from database" 1 "Cutoffs from database.")
              ("Manual cutoffs"   2 "Manual cutoffs.")
              )
  value: 1
  mouse_text: "Select how Crossline Aperture Distance Cutoffs are input for this Image Set."
  showp: nil

  parameter: TBLXLD1
  text: "         Crossline Maximum Aperture Distance Table 1"
  type: :function
  type_desc: ((parm_list "MUT") parms)
  value: "no entry"
  mouse_text: "Use Mouse Button 1 to select a Mute file from the menu."
  plot_label: t

  parameter: MINAPD1
  text: "         Minimum Aperture Distance 1"
  type: typein:
  type_desc: ( real: 7 0.0 nil)
  value: 0.0
  mouse_text: "Enter the minimum distance from the aperture center to include."
  plot_label: t

  parameter: MAXAPD1
  text: "         Maximum Aperture Distance 1"
  type: typein:
  type_desc: ( real: 7 0.0 nil)
  value: 5000.0
  mouse_text: "Enter the maximum distance from the aperture center to include."
  plot_label: t

  parameter: MXSTRM1
  text: "         Maximum Stretch Mute 1"
  type: typein:
  type_desc: ( real: 6 0.0 1000.0)
  value: 15 
  mouse_text: "Enter the maximum percentage stretch mute to allow in the aperture."
  plot_label: t

  parameter: MXAPDP1
  text: "         Maximum Dip Limit 1"
  type: typein:
  type_desc: ( real: 4 0.0 90.0)
  value: 90
  mouse_text: "Enter the maximum dip aperture limit of less than the default 90 degrees."
  plot_label: t

  parameter: DBMUTE1
  text: "         Mute Input Type 1"
  type: pop_choose:
  type_desc: (
	      ("Mutes from database" 1 "Mutes from database.")
 	      ("Manual mutes"   2 "Manual mutes.")
 	      )
  value: 1
  mouse_text: "Select how Mutes are input for this Image Set."
  showp: nil

  parameter: MUTETAB1
  text: "         Table with Mute parameters 1"
  type: :function
  type_desc: ((parm_list "MUT") parms)
  value: "no entry"
  mouse_text: "Use Mouse Button 1 to select a Mute file from the menu."
  plot_label: t

