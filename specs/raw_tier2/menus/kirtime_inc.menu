	 (initialization (= (value 'INIT) 1)
					(progn 
	                                   (set_value 'PATH (flow_directory))
					   (set_value 'INIT 0)
					   )
			 )

	(cdp_interval_default_rule (and (value 'KT2D) ( = (value 'DCDP) 999999.))
		(set_value 'DCDP (db_parmget_line "DCDPILNz")))

