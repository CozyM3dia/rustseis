  parameter: PHASECO2
  text: "      Amplitude/Phase Correction"
  type: pop_choose:
  type_desc: (
	      ("2D Correction"   2 "Apply 2D Amplitude/Phase Correction.")
	      ("No Correction"   3 "Do Not Apply 2D Amplitude/Phase Correction.")
	      )
  value: 2
  mouse_text: "Choose Amplitude/Phase Correction to Apply.  2D is recommended."
  showp: nil
  plot_label: t

  parameter: PHASECO3
  text: "      Amplitude/Phase Correction"
  type: pop_choose:
  type_desc: (
	      ("3D Correction"   1 "Apply 3D Amplitude/Phase Correction.")
	      ("2D Correction"   2 "Apply 2D Amplitude/Phase Correction.")
	      ("No Correction"   3 "Do Not Apply 3D Amplitude/Phase Correction.")
	      )
  value: 1
  mouse_text: "Choose Amplitude/Phase Correction to Apply.  2D is appropriate for narrow swath imaging, e.g. Inline-Only or Crossline-Only migration apertures."
  showp: nil
  plot_label: t

  parameter: RMSTHRE
  text: "      Noisy Trace RMS Threshold value"
  type: typein:
  type_desc: ( real: 6 0.0 nil)
  value: 0.0
  mouse_text: "Enter the maximum rms threshhold value for rejecting noisy input traces. - 0.0 means no RMS check."
  plot_label: t

  parameter: T_POWER
  text: "      Time-Power gain removal constant"
  type: typein:
  type_desc: ( real: 6 -10.0 nil)
  value: 0.0
  mouse_text: "Rescale input traces by dividing them by time raised to the specified power, i.e. 1.0 divides by t."
  plot_label: t

  parameter: DB_PER_S
  text: "      db/Sec gain removal constant"
  type: typein:
  type_desc: ( real: 6 -120.0 nil)
  value: 0.0
  mouse_text: "Remove previously applied dB/sec gain. Use 6.0 if True Amplitude Recovery defaults were applied."
  plot_label: t


  parameter: COMPRESSION
  text: "   Scratch disk parameters"
  type: circular:
  type_desc: (
	      (" hide"  1 "Do not Show Scratch disk parameters.")
	      (" show"  0 "Show Scratch disk parameters.")
	      )
  :selected_item (" show" 0 "Show Scratch disk parameters.")
  value: 0
  mouse_text: "Show Scratch disk parameters?"

  parameter: ICTKDIST
  text: "      Scratch file layout policy"
  type: pop_choose:
  type_desc: (
	      ("Largest space"   1 "Put each new subfile in the scratch directory with the largest space.")
 	      ("Sequential fill"   2 "Fill up each scratch directory in turn.")
 	      ("Round robin"   3 "Put new subfiles in the scratch directories in round-robin fashion, space permitting.")
 	      )
  :selected_item ("Largest space"   1 "Put each new subfile in the scratch directory with the largest space.")
  value: 1
  mouse_text: "Choose how internal scratch files are laid out. Use Sequential fill if you have a non-local disk for secondary scratch spill.  Use Round robin to stripe data across multiple disks for performance."
  plot_label: t

  parameter: ICMPRTYP
  text: "      Compression Type"
  type: pop_choose:
  type_desc: (
	      ("No Compression"   1 "No compression.")
 	      ("16 bit internal"   2 "16 bit internal compression.")
 	      ("8 bit internal"   3 "8 bit internal compression.")
 	      ("RMS distortion"  4 "RMS distortion limited.")
 	      )
  value: 1
  mouse_text: "Use Compression for internal working files?"
  plot_label: t


  parameter: CTKRMSDB
  text: "      Maximum RMS Distortion (dB)"
  type: typein:
  type_desc: ( real: 6 nil nil )
  value: -36.
  mouse_text: "Maximum permitted RMS Distortion for Compression in dB."
  plot_label: t


