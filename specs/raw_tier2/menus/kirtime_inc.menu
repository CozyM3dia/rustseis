                       (do_not_show 'GRDPRMS1)
                       (do_not_show 'GRDPRMS2)
                       (do_not_show 'GRDPRMS3)
                       (do_not_show 'GRDPRMS4)
			     )
			   (progn
			     (do_not_show 'VELOCI)
			     ;(do_not_show 'SHOWANISO)
			     (do_not_show 'ADV_AALI) 
			     (do_not_show 'PREPROC) 
			     (do_not_show 'COMPRESSION) 
			     (do_not_show 'MAXPREP) 
			     (do_not_show 'MAXIMAG) 
			     (do_not_show 'MNTWIN) 
			     (do_not_show 'CACHEBLK) 
