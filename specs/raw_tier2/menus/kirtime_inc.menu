	 (MAXOFFS3_rule ( = ( value 'MAXOFF3) -1.0)
			(set_value 'MAXOFF3 ( db_parmget_line "OFFMAXz") ) )
	 (OFFBNSZ3_rule ( = ( value 'OFFBNSZ3) -1.0)
		       (set_value 'OFFBNSZ3 ( db_parmget_line "OFFBINCz") ) )
	 (OFFORD3_rule ( < (value 'MAXOFF3) (value 'MINOFF3))
			(set_value 'MAXOFF3 (value 'MINOFF3)))
     (OFFSETPARM30_PAR_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 3 ) )
            (do_show 'IMGRTYP3) (do_not_show 'IMGRTYP3))
	 (OFFSETPARM3_PAR_rule (and (= (value 'P_SHOWIM) 3) (or (= (value 'IMGRTYP3) 2 ) (= (value 'IMGRTYP3) 3) ) )
			    (progn
			      (do_show 'MINOFF3)
			      (do_show 'MAXOFF3)
			      (do_show 'OFFBNSZ3)
			      )
			    (progn
			      (do_not_show 'MINOFF3)
			      (do_not_show 'MAXOFF3)
			      (do_not_show 'OFFBNSZ3)
			      )
			    )


     ; Acquisition Footprint
