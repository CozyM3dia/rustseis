  mouse_text: "Initial percentage velocity for migration velocity scan."
  plot_label: t

  parameter: VSCANEND
  text: "      Velocity Scan End (%)"
  type: typein:
  type_desc: ( real: 6 0.0 nil )
  value: 110.0
  mouse_text: "Final percentage velocity for migration velocity scan."
  plot_label: t


  parameter: VSCANNUM
  text: "      Number of Velocity Scans"
  type: typein:
  type_desc: ( int: 6 1 nil )
  value: 3
  mouse_text: "Number of Velocity Scans to output. A gather will be output at each CDP."
  plot_label: t


