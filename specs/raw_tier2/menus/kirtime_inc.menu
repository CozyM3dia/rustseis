	 (POP_NO_DISPLAY_rule (or 
			       (member :name1 (value 'ISETNAM ) )
			       (or (member :name2 (value 'ISETNAM ) ) 
				   (or (member :name3 (value 'ISETNAM ) ) 
				       (or (member :name4 (value 'ISETNAM ) ) 
					   )
				       )
				   )
			       )
			      (progn
				(do_show 'P_SHOWIM)
				(set_selected_item 'P_SHOWIM (first (type_desc 'P_SHOWIM ) ) )
				;(set_value 'P_SHOWIM 1)
				)
			      (do_not_show 'P_SHOWIM )
			      )
	 




	 ;  Begin Parameters for Image Set 1

	 ; Name Parameters	
	 (P_NAME1_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) )
			(do_show 'P_NAME1) (do_not_show 'P_NAME1))


	 ; Supergather Parameters
	 (SUPERG1_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) ) 
			(do_show 'SG_APPL1) (do_not_show 'SG_APPL1) )

	 (SUPERG11_rule (and (value 'SG_APPL1) (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) ) )
			(progn
			  (if (value 'KT2D) (do_not_show 'SGINWD1) (do_show 'SGINWD1))
			  (do_show 'SGXLWD1)
			  )
			(progn
			  (do_not_show 'SGINWD1) 
			  (do_not_show 'SGXLWD1)
			  )
			)
          (SUPERG12_rule (evenp (value 'SGINWD1))
			  (set_value 'SGINWD1 (+ 1 (value 'SGINWD1)))
			)
          (SUPERG13_rule (evenp (value 'SGXLWD1))
			  (set_value 'SGXLWD1 (+ 1 (value 'SGXLWD1)))
			)

	 ; Antialias Parameters	
	 (ANTIALI1_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) ) 
			(do_show 'AA_APPL1) (do_not_show 'AA_APPL1) )

	 (ANTIALI11_rule (and (value 'AA_APPL1) (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) ) )
			(progn
                          (do_show 'AAIMAGE1)
			  (if (value 'AAIMAGE1) (do_not_show 'IMAGEDY1) (do_show 'IMAGEDY1))
			  (if (or (value 'KT2D) (value 'AAIMAGE1)) (do_not_show 'IMAGEDX1) (do_show 'IMAGEDX1))
			  )
			(progn
                          (do_not_show 'AAIMAGE1)
			  (do_not_show 'IMAGEDX1) 
			  (do_not_show 'IMAGEDY1)
			  )
			)

         ; Migration Direction Parameter
	 (DIRECPAR01_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) )
			(if (not (value 'KT2D)) (do_show 'DIRECTN1)) (do_not_show 'DIRECTN1))

        ; massage APRTYP1 ?
        (NOAP1_rule (and (< 1 (length (value 'APRTYP1))) (member 0 (value 'APRTYP1))) (progn
		    (set_value 'APRTYP1 (remove 0 (value 'APRTYP1)))
		    (set_selected_item 'APRTYP1 (cdr (selected_item 'APRTYP1 ) ) )
		    ))

         ; Aperture Parameters	
	 (APERPAR01_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 1 ) )
			(do_show 'APRTYP1) (do_not_show 'APRTYP1))
	 
         (NOSHOWAPRD1_rule (not (showing 'TBLAPD1))
                          (progn
				(do_not_show 'TBLILD1)
                                (do_not_show 'TBLXLD1)
                                (do_not_show 'MINAPD1)
                                (do_not_show 'MAXAPD1)
                          ))

         ( ((value TBLAPD1) (value DIRECTN1)) TBLSHOWAPRD1_rule (and (showing 'TBLAPD1) (not (= (value 'TBLAPD1) 0)))
                        (progn
                                (do_not_show 'MINAPD1)
                                (do_not_show 'MAXAPD1)
