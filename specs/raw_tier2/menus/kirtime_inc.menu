  text: "      Image Gather Type 1"
  type: pop_choose:
  type_desc: (
	      ("Full Offset Image Traces " 1 "Full Offset Image Traces.")
 	      ("Sou-Rec Offset Limited Gathers"   2 "Source-Receiver Offset Limited Gathers.")
 	      ("Sou-Img_Loc-Rec Offset Limited Gathers"   3 "Source-Image_Location-Receiver Offset Limited Gathers.")
 	      )
  value: 1
  mouse_text: "Select the Image Gather Type for this Image Set."
  plot_label: t




  ; Binning parameters - Function of the Gather Type
  parameter: MINOFF1
  text: "         Absolute Offset of First Bin Center 1"
  type: typein:
  type_desc: ( real: 9 0.0 nil)
  value: 0.0 
  mouse_text: "Enter the minimum input offset for this Image Set."
  plot_label: t

  parameter: MAXOFF1
  text: "         Maximum Migrated Gather Offset 1"
  type: typein:
  type_desc: ( real: 9 -1.0 nil)
  value: -1.0
  mouse_text: "Enter the maximum input offset for this Image Set."
  plot_label: t

  parameter: OFFBNSZ1
  text: "         Bin Size for Offset Gather 1"
  type: typein:
  type_desc: ( real: 6 -1.0 nil)
  value: -1.0
  mouse_text: "Enter the input offset bin interval for this Image Set."
  plot_label: t



  parameter: ACQFOOT1
  text: "      Acquisition Footprint 1"
  type: pop_choose:
  type_desc: (
	      ("No Footprint Compensation " 1 "No Acquisition Footprint Compensation Traces.")
	      ("Migration Fold Compensation " 2 "Migration Fold Aquisition Footprint Compensation Traces.")
 	      )
  value: 1
  mouse_text: "Choose whether to calculate and interleave FOLDCOMP traces in the output for later analysis and/or application."
  plot_label: t



  parameter: P_NAME1
  text: "      Replace Set Name 1"
  type: typein:
  type_desc:  ( string: 32)
  value: "Image Set 1"
  mouse_text: "Supply a descriptive name for this Image Set."
  plot_label: t





