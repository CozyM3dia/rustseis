		      (set_text 'DBXLD4 "         Aperture Distance Table Input Type 4")
		      (set_mouse_text 'DBXLD4 "Select how Aperture Distance Cutoffs are input for this Image Set.")
		      (set_text 'TBLXLD4 "         Maximum Aperture Distance Table 4")

		   )
                 ; 3D menu
		   (progn
		      (set_value 'program "kirtime3d.exe")
		      (do_not_show 'DCDP)
		      (set_text 'FXLIN1 "      Minimum Output Xline 1")
		      (set_mouse_text 'FXLIN1 "Enter the first output crossline for this Image Set.")
