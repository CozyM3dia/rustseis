	; Velocity Parameters	
	 (ADVANCE_PAR_rule (= (value 'ADVANCED) 1)
			   (progn
			     (do_show 'VELOCI)
			     ;(do_show 'SHOWANISO)
			     (do_show 'ADV_AALI) 
			     (do_show 'PREPROC) 
			     (do_show 'COMPRESSION) 
			     (do_show 'MAXPREP) 
