	 (APERTYP35PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP3) (and (member 6 (value 'APRTYP3) ) ) ) )
			    (progn 
			      (do_show 'MXAPDP3)
			      ) 
		    )

	 (APERTYP36PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP3) (and (member 7 (value 'APRTYP3) ) ) ) )
			    (progn 
			      (do_show 'MUTETAB3)
			      ) 
		    )



	; Output Parameters	
	 (FINLIN3_DB_rule (and (not (value 'KT2D)) ( = ( value 'FINLIN3) -1))
			   (set_value 'FINLIN3 ( db_parmget_line "MINILINz") ) )
	 (LINLIN3_DB_rule (and (not (value 'KT2D)) ( = ( value 'LINLIN3) -1))
			   (set_value 'LINLIN3 ( db_parmget_line "MAXILINz") ) )
	 (FXLIN3_DB_rule ( = ( value 'FXLIN3) -1.0)
			    (if (value 'KT2D)
				(set_value 'FXLIN3 ( db_parmget_line "MINCDPz") ) 
				(set_value 'FXLIN3 ( db_parmget_line "MINXLINz") ) 
                            ))
	 (LXLIN3_DB_rule ( = ( value 'LXLIN3) -1.0)
                            (if (value 'KT2D)
				(set_value 'LXLIN3 ( db_parmget_line "MAXCDPz") ) 
				(set_value 'LXLIN3 ( db_parmget_line "MAXXLINz") ) 
			    ))


	 (IMAGEDX3_DB_rule (and (not (value 'KT2D)) ( = ( value 'IMAGEDX3) -1.0))
			    (set_value 'IMAGEDX3 (* ( db_parmget_line "DCDPXLNz") (value 'INLINC3) ) ) )
	 (IMAGEDY3_DB_rule ( = ( value 'IMAGEDY3) -1.0)
			    (set_value 'IMAGEDY3 (* ( db_parmget_line "DCDPILNz") (value 'XLINC3) )  ) )


	 (OUTPARM3_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 3) )
			    (progn
			      ;(do_show 'ODT3)
			      ;(do_show 'OTMIN3)
			      ;(do_show 'OTMAX3)
			      (if (not (value 'KT2D)) (do_show '(FINLIN3 LINLIN3 INLINC3) ))
			      (do_show 'FXLIN3)
			      (do_show 'LXLIN3)
			      (do_show 'XLINC3)
			      )
			    (progn
			      ;(do_not_show 'ODT3)
			      ;(do_not_show 'OTMIN3)
			      ;(do_not_show 'OTMAX3)
			      (do_not_show 'FINLIN3)
			      (do_not_show 'LINLIN3)
			      (do_not_show 'INLINC3)
			      (do_not_show 'FXLIN3)
			      (do_not_show 'LXLIN3)
			      (do_not_show 'XLINC3)
			      )

			    )


	 ; Grid Parameters
	 (GRDPRMS3_rule (and  (and (= (value 'ADVANCED) 1) (showing 'P_SHOWIM) ) ( = (value 'P_SHOWIM) 3) )
			(do_not_show 'GRDPRMS3) 
            (do_not_show 'GRDPRMS3)
     )
	 (GRDPRMS3_PAR_rule (and (showing 'GRDPRMS3) (= (value 'GRDPRMS3) 1) ) 
			    (progn 
			      (do_show 'SBGRTYP3) 
			      (do_show 'TGRPTYP3) 
			      (do_show 'ARBMETH3) 
			      (do_show 'ARBCOOR3) 

			      ) 
			    (progn 
			      (do_not_show 'SBGRTYP3)
			      (do_not_show 'TGRPTYP3) 
			      (do_not_show 'ARBMETH3) 
			      (do_not_show 'ARBCOOR3) 
