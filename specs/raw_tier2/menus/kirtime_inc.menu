	 ;  Begin Parameters for Image Set 4

	 ; Name Parameters	
	 (P_NAME4_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) )
			(do_show 'P_NAME4) (do_not_show 'P_NAME4))

	 ; Supergather Parameters
	 (SUPERG4_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) ) 
			(do_show 'SG_APPL4) (do_not_show 'SG_APPL4) )

	 (SUPERG41_rule (and (value 'SG_APPL4) (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) ) )
			(progn
			  (if (not (value 'KT2D)) (do_show 'SGINWD4))
			  (do_show 'SGXLWD4)
			  )
			(progn
			  (do_not_show 'SGINWD4) 
			  (do_not_show 'SGXLWD4)
			  )
			)
          (SUPERG42_rule (evenp (value 'SGINWD4))
			  (set_value 'SGINWD4 (+ 1 (value 'SGINWD4)))
			)
          (SUPERG43_rule (evenp (value 'SGXLWD4))
			  (set_value 'SGXLWD4 (+ 1 (value 'SGXLWD4)))
			)

	 ; Antialias Parameters	
	 (ANTIALI4_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) ) 
			(do_show 'AA_APPL4) (do_not_show 'AA_APPL4) )

	 (ANTIALI41_rule (and (value 'AA_APPL4) (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) ) )
			(progn
                          (do_show 'AAIMAGE4)
			  (if (or (value 'KT2D) (value 'AAIMAGE4)) (do_not_show 'IMAGEDX4) (do_show 'IMAGEDX4))
			  (if (value 'AAIMAGE4) (do_not_show 'IMAGEDY4) (do_show 'IMAGEDY4))
			  )
			(progn
                          (do_not_show 'AAIMAGE4)
			  (do_not_show 'IMAGEDX4) 
			  (do_not_show 'IMAGEDY4)
			  )
			)

         ; Migration Direction Parameter
	 (DIRECPAR04_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) )
			(if (not (value 'KT2D)) (do_show 'DIRECTN4)) (do_not_show 'DIRECTN4))
	 
        ; massage APRTYP4 ?
        (NOAP4_rule (and (< 1 (length (value 'APRTYP4))) (member 0 (value 'APRTYP4))) (progn
		    (set_value 'APRTYP4 (remove 0 (value 'APRTYP4)))
		    (set_selected_item 'APRTYP4 (cdr (selected_item 'APRTYP4 ) ) )
		    ))


         ; Aperture Parameters	
	 (APERPAR04_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4 ) )
			(do_show 'APRTYP4) (do_not_show 'APRTYP4))
	 
         (NOSHOWAPRD4_rule (not (showing 'TBLAPD4))
                          (progn
				(do_not_show 'TBLILD4)
                                (do_not_show 'TBLXLD4)
                                (do_not_show 'MINAPD4)
                                (do_not_show 'MAXAPD4)
                          ))

         ( ((value TBLAPD4) (value DIRECTN4)) TBLSHOWAPRD4_rule (and (showing 'TBLAPD4) (not (= (value 'TBLAPD4) 0)))
                        (progn
                                (do_not_show 'MINAPD4)
                                (do_not_show 'MAXAPD4)
				(if (and (not (value 'KT2D)) (not (= (value 'DIRECTN4) 1))) (do_show 'TBLILD4))
				(if (not (= (value 'DIRECTN4) 2)) (do_show 'TBLXLD4))
                        ))

         (CONSTSHOWAPRD4_rule (and (showing 'TBLAPD4) (= (value 'TBLAPD4) 0))
                        (progn
                                (do_show 'MINAPD4)
                                (do_show 'MAXAPD4)
				(do_not_show 'TBLILD4)
                                (do_not_show 'TBLXLD4)
                        ))

	 (APERTYP41PARM_rule (and (value 'P_SHOWIM) (or (value 'APRTYP4) (not (= (value 'P_SHOWIM) 4) ) ) )
			    (progn 
			      (do_not_show 'MXAPDP4)
			      (do_not_show 'MXSTRM4) 
			      (do_not_show 'APDTYP4)
			      (do_not_show 'TBLAPD4)
			      (do_not_show 'MUTETAB4)
			      ) 
     		    )

	 (APERTYP42PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP4) (and (member 3 (value 'APRTYP4) ) ) ) )
			    (progn 
			      (do_show 'APDTYP4)
			      (do_show 'TBLAPD4)
			      ) 
		    )

	 (APERTYP43PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP4) (and (member 4 (value 'APRTYP4) ) ) ) )
			    (progn 
			      (do_show 'APDTYP4)
			      (do_show 'TBLAPD4)
			      ) 
