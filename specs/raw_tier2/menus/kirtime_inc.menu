	 (APERTYP33PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP3) (and (member 4 (value 'APRTYP3) ) ) ) )
			    (progn 
			      (do_show 'APDTYP3)
			      (do_show 'TBLAPD3)
			      ) 
		    )

	 (APERTYP34PARM_rule (and (value 'P_SHOWIM) (and (showing 'APRTYP3) (and (member 5 (value 'APRTYP3) ) ) ) )
			    (progn 
