  type: pop_choose:
  type_desc: (
	      ("No Scan"   1 "No scan.")
	      ("Uniform percentage velocity"   2 "Uniform percentage velocity.")
	      ("Uniform percentage slowness"   3 "Uniform percentage slowness.")
	      ("Uniform percentage sloth"  4 "Uniform percentage sloth (1/v**2).")
	      )
  mouse_text: "Choose to migrate with a range of percentage-scaled velocities?  The float header entry VELSCAN will record the percent."
  plot_label: t

  parameter: VSCANST
  text: "      Velocity Scan Start (%)"
  type: typein:
  type_desc: ( real: 6 0.0 nil )
