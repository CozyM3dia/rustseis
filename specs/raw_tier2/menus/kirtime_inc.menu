  text: "         Block Moveout Step"
  type: typein:
  type_desc: ( integer: 6 1 nil)
  value: 8
  mouse_text: "Enter the Block Moveout Step size in samples."
  plot_label: t



  parameter: MAXPREP
  text: "   Maximum Preprocessed Traces"
  type: typein:
  type_desc: ( int: 6 1 nil )
  value: 256
  mouse_text: "Maximum number of input traces to buffer in memory at a time."
  plot_label: t


  parameter: MAXIMAG
  text: "   Maximum Image Traces"
  type: typein:
  type_desc: ( int: 6 1 nil )
  value: 16
  mouse_text: "Maximum number of image traces to buffer in memory for each internal working image file."
  plot_label: t

  parameter: MNTWIN
  text: "   Minimum Aperture Window Length (ms)"
  type: typein:
  type_desc: (real: 7 0.0 250.0)
  value: 0.0
  mouse_text: "For speed, very short trace aperture windows can be dropped in the migration."
  plot_label: t

  parameter: CACHEBLK
  text: "   Maximum Number of Cache Blocks"
  type: typein:
  type_desc: ( int: 9 1 nil )
  value: 100000
  mouse_text: "Maximum number of (possibly compressed) image blocks to store in memory at one time.  Each uncompressed block is 2 KB."
  plot_label: t

  parameter: HIWATER
  text: "   Maximum job memory usage (MB)"
  type: typein:
  type_desc: ( int: 9 0 nil )
  value: 0
  mouse_text: "If nonzero, the maximum number of cache blocks will be reduced if needed to keep the virtual memory within the limit."
  showp: nil


