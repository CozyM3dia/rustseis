	 (IMAGEDY4_DB_rule (= ( value 'IMAGEDY4) -1.0)
			    (set_value 'IMAGEDY4 (* ( db_parmget_line "DCDPILNz") (value 'XLINC4) )  ) )



	 (OUTPARM4_rule (and (showing 'P_SHOWIM) ( = (value 'P_SHOWIM) 4) )
			    (progn
			      ;(do_show 'ODT4)
			      ;(do_show 'OTMIN4)
