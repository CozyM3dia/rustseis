                       (do_not_show 'GRDPRMS3)
                       (do_not_show 'GRDPRMS4)
			     )
			   )



	 (VELOCI_PAR_rule (and (= (value 'VELOCI ) 1) (= (value 'ADVANCED) 1) )
			    (progn 
;			      (do_show 'CACHEMB)
			      (do_show 'VSCANTYP)
			      )
			    (progn
;			      (do_not_show 'CACHEMB)
			      (do_not_show 'VSCANTYP)
			      (do_not_show 'VSCANST)
			      (do_not_show 'VSCANEND)
			      (do_not_show 'VSCANNUM)
			      )
			    ) 
					
         ; Check Scan parameters - If No SCAN or not display VSCANST- VSCANEND-VSCANNUM
	 (VELSCANPARM_rule (and (and (= (value 'VELOCI) 1) (= (value 'ADVANCED) 1) )( not ( = (value 'VSCANTYP) 1) ) )
			    (progn 
			      (do_show 'VSCANST)
			      (do_show 'VSCANEND)
			      (do_show 'VSCANNUM)
			      )
			     (progn 
			      (do_not_show 'VSCANST)
			      (do_not_show 'VSCANEND)
			      (do_not_show 'VSCANNUM)
			      )
			)




