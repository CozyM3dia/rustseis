			      (do_show 'XLINC4)
			      )
			    (progn
			      ;(do_not_show 'ODT4)
			      ;(do_not_show 'OTMIN4)
			      ;(do_not_show 'OTMAX4)
			      (do_not_show 'FINLIN4)
			      (do_not_show 'LINLIN4)
			      (do_not_show 'INLINC4)
			      (do_not_show 'FXLIN4)
			      (do_not_show 'LXLIN4)
			      (do_not_show 'XLINC4)
			      )

			    )


	 ; Grid Parameters
	 (GRDPRMS4_rule (and  (and (= (value 'ADVANCED) 1) (showing 'P_SHOWIM) ) ( = (value 'P_SHOWIM) 4) )
			(do_not_show 'GRDPRMS4)
            (do_not_show 'GRDPRMS4)
     )
	 (GRDPRMS4_PAR_rule (and (showing 'GRDPRMS4) (= (value 'GRDPRMS4) 1) ) 
			    (progn 
			      (do_show 'SBGRTYP4) 
			      (do_show 'TGRPTYP4) 
			      (do_show 'ARBMETH4) 
