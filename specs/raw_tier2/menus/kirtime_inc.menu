  rules:(
        (menu_2D_3D_setup t (progn
	    (if (value 'KT2D) 
		 ; 2D menu
		   (progn
		      (set_value 'program "kirtime2d.exe")
		      (do_show 'DCDP)
		      (set_text 'FXLIN1 "      Minimum Output CDP 1")
		      (set_mouse_text 'FXLIN1 "Enter the first output CDP for this Image Set.")
		      (set_text 'LXLIN1 "      Maximum Output CDP 1")
		      (set_mouse_text 'LXLIN1 "Enter the last output CDP for this Image Set.")
		      (set_text 'XLINC1 "      CDP Output Sampling Interval 1")
		      (set_mouse_text 'XLINC1 "Enter the CDP output increment for this Image Set.")
		      (set_mouse_text 'SG_APPL1 "Output a range of image traces around each of the above locations.")
		      (set_text 'SGXLWD1 "         CDPs to combine 1")
		      (set_mouse_text 'SGXLWD1 "Supply the odd CDP width of each supergather.")
		      (set_text 'IMAGEDY1 "         Nominal CDP Antialias Spacing 1")
		      (set_mouse_text 'IMAGEDY1 "A smaller value than the default may increases frequency content at the expense of increased aliasing of events in the CDP direction.")
		      (set_type_desc 'TBLAPD1  '(
              ("No"  0 "Do not use time-variable aperture distance for this image set.")
              ("Yes"  2 "Use a time-variable aperture distance limit.")
              )
		      )
		      (set_text 'TBLAPD1 "         Use time variable distance table?")
	              (set_mouse_text 'TBLAPD1 "A table may be supplied to specify time and space variant distance limits.")
		      (set_text 'DBXLD1 "         Aperture Distance Table Input Type 1")
		      (set_mouse_text 'DBXLD1 "Select how Aperture Distance Cutoffs are input for this Image Set.")
		      (set_text 'TBLXLD1 "         Maximum Aperture Distance Table 1")

		      (set_text 'FXLIN2 "      Minimum Output CDP 2")
		      (set_mouse_text 'FXLIN2 "Enter the first output CDP for this Image Set.")
		      (set_text 'LXLIN2 "      Maximum Output CDP 2")
		      (set_mouse_text 'LXLIN2 "Enter the last output CDP for this Image Set.")
		      (set_text 'XLINC2 "      CDP Output Sampling Interval 2")
		      (set_mouse_text 'XLINC2 "Enter the CDP output increment for this Image Set.")
		      (set_mouse_text 'SG_APPL2 "Output a range of image traces around each of the above locations.")
		      (set_text 'SGXLWD2 "         CDPs to combine 2")
		      (set_mouse_text 'SGXLWD2 "Supply the odd CDP width of each supergather.")
		      (set_text 'IMAGEDY2 "         Nominal CDP Antialias Spacing 2")
		      (set_mouse_text 'IMAGEDY2 "A smaller value than the default may increases frequency content at the expense of increased aliasing of events in the CDP direction.")
		      (set_type_desc 'TBLAPD2  '(
              ("No"  0 "Do not use time-variable aperture distance for this image set.")
              ("Yes"  2 "Use a time-variable aperture distance limit.")
              )
		      )
		      (set_text 'TBLAPD2 "         Use time variable distance table?")
	              (set_mouse_text 'TBLAPD2 "A table may be supplied to specify time and space variant distance limits.")
		      (set_text 'DBXLD2 "         Aperture Distance Table Input Type 2")
		      (set_mouse_text 'DBXLD2 "Select how Aperture Distance Cutoffs are input for this Image Set.")
		      (set_text 'TBLXLD2 "         Maximum Aperture Distance Table 2")

		      (set_text 'FXLIN3 "      Minimum Output CDP 3")
		      (set_mouse_text 'FXLIN3 "Enter the first output CDP for this Image Set.")
		      (set_text 'LXLIN3 "      Maximum Output CDP 3")
		      (set_mouse_text 'LXLIN3 "Enter the last output CDP for this Image Set.")
		      (set_text 'XLINC3 "      CDP Output Sampling Interval 3")
		      (set_mouse_text 'XLINC3 "Enter the CDP output increment for this Image Set.")
		      (set_mouse_text 'SG_APPL3 "Output a range of image traces around each of the above locations.")
		      (set_text 'SGXLWD3 "         CDPs to combine 3")
		      (set_mouse_text 'SGXLWD3 "Supply the odd CDP width of each supergather.")
		      (set_text 'IMAGEDY3 "         Nominal CDP Antialias Spacing 3")
		      (set_mouse_text 'IMAGEDY3 "A smaller value than the default may increases frequency content at the expense of increased aliasing of events in the CDP direction.")
		      (set_type_desc 'TBLAPD3  '(
              ("No"  0 "Do not use time-variable aperture distance for this image set.")
              ("Yes"  2 "Use a time-variable aperture distance limit.")
              )
		      )
		      (set_text 'TBLAPD3 "         Use time variable distance table?")
