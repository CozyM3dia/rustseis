; IIID IVD 1 BSI DEV DEPTHC BHSS
'(
 name: SCDECONM1
label: "Gated SC Decon 1: Estimation"
value_tab: 44

parameter: db_option
text: "Get ESTIMATION gates from the DATABASE?"
type: boolean:
value: t
mouse_text: "Select 'No' if a time gate parameter file was not created interactively. (Enter manually.)"

parameter: GATELIST
text: "Select ESTIMATION Time Gate Parameter FILE"
type: function:
type_desc: ((parm_list "GAT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Select a time gate parameter file to use for estimating ensemble spectra."

parameter: PRIM_KEY
text: "  SELECT Primary gate header word"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Select a header word to use as the PRIMARY key for specifying gate parameters."

parameter: SCND_KEY
text: "  SELECT Secondary gate header word"
type: function:
type_desc: (header_list headers)
value: "AOFFSET "
selected_item: "Absolute value of offset"
mouse_text: "Select a header word to use as the optional SECONDARY key for specifying gate parameters."

parameter: DCN_GATE
text: "  Specify ESTIMATION gate parameters"
type: edit:
type_desc: (30 80 5 " FORMAT: Primary Gate Location Value: (Secondary Gate Loc. Value):Time Gate(s)/
 EXAMPLE: 101:0.0:700-2000 / 101:5280.0:1200-2200 /
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A	Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E	Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K	KILL to the end of the line (from the cursor)
 E:  Ctrl-Y	YANK back the contents of the kill buffer; 'Cut and paste';
		(Can move the cursor first) " 3 )
value: "1:0:700-2500/1:2640:1000-2800/1:5280:1500-3000/"
mouse_text: "Define the time gate(s) for estimating ensemble spectra."

parameter: COMPONENTS
text: "Components of spectral decomposition"
type: multiple_choose:
type_desc: (  
 ("SHOT"    :shot "Include source component in spectral decomposition." ) 
 ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) 
 ("OFFSET"  :offset "Include offset component in spectral decomposition.")
 ("CDP"     :cdp "Include cdp component in spectral decomposition.")
 ("OTHER"   :other "Include user-defined component in spectral decomposition.") )
:selected_item (
 ("SHOT"    :shot "Include source component in spectral decomposition." ) 
 ("RCVR"    :rcvr "Include receiver component in spectral decomposition" ) 
 ("OFFSET"  :offset "Include offset component in spectral decomposition.")
 ("CDP"     :cdp "Include cdp component in spectral decomposition.") )
mouse_text: "Select components to use in spectral decomposition."

parameter: OTHERNAM
text: "  SELECT header word for OTHER component"
type: function:
type_desc: (header_list headers)
value: "NONE    "
selected_item: "No trace header entry selected"
mouse_text: "Select a header word to use as OTHER component of spectral decomposition. Must have INTEGER format."

parameter: OTHERMIN
text: "  Minimum value for OTHER"
type: typein:
type_desc: (int: 7 1 nil )
value: 1
mouse_text: "Enter minimum value for OTHER component header word."

parameter: OTHERMAX
text: "  Maximum value for OTHER"
type: typein:
type_desc: (int: 7 1 nil )
value: 1
mouse_text: "Enter maximum value for OTHER component header word."

parameter: OTHERINC
text: "  Increment for OTHER"
type: typein:
type_desc: (int: 7 1 nil )
value: 1
mouse_text: "Enter increment for OTHER component header word."

parameter: OTHERFLD
text: "  Maximum fold for OTHER"
type: typein:
type_desc: (int: 7 1 nil )
value: 1
mouse_text: "Enter maximum number of traces in a common OTHER gather."

parameter: OFFS_RES
text: "Limit offsets?"
type: boolean:
value: nil
mouse_text: "Select 'Yes' to use a restricted range of offsets in estimation and decomposition."

parameter: OFFS_MIN
text: "  Minimum absolute offset"
type: typein:
type_desc: (real: 7 0. nil )
value: 1000.
mouse_text: "Enter minimum absolute offset to use."

parameter: OFFS_MAX
text: "  Maximum absolute offset"
type: typein:
type_desc: (real: 7 2. nil )
value: 3000.
mouse_text: "Enter maximum absolute offset to use."

parameter: DCN_OPER
text: "Decon operator length(s)"
type: typein:
type_desc: (string: 30)
value: "80.0"
mouse_text: "Enter operator length, in ms, for each gate. Example: 80.0, 120.0, 160.0."

parameter: DCN_WHTN
text: "Operator 'white noise' level(s)"
type: typein:
type_desc: (string: 30)
value: "0.1"
mouse_text: "Enter 'white noise' level, in PERCENT, for each gate. Example: 0.1, 0.5."

parameter: TAPEROPT
text: "Apply user specified taper?"
type: boolean:
value: nil
mouse_text: "Select 'Yes' for user specified taper length. Select 'No' for old default of 1/2 minimum operator length."

parameter: TAPERLEN
text: "  Taper length in ms"
type: typein:
type_desc: ( real: 7 0. nil )
value: 50.
mouse_text: "A taper of this length is applied to EACH end of the gate before calculating its spectrum (0. for no taper)."

parameter: TWIN_MIN
text: "Gate rejection factor"
type: typein:
type_desc: ( real: 7 0.0 nil )
value: 2.0
mouse_text: "Eliminate gates with fewer LIVE samples than this factor times the operator length."

parameter: ID_CHARS
text: "4-character file ID"
type: typein:
type_desc: ( string: 4 )
value: "SPEC"
mouse_text: "Enter a 4-character (or numeric) identifier (NO blanks) for the output spectrum file."

parameter: OVERWRIT
text: "Overwrite existing file?"
type: boolean:
value: nil
mouse_text: "Select 'Yes' to remove any existing file with this ID before execution. Select 'No' to abort if file exists."

parameter: MEM_OPT
text: "Conserve memory?"
type: boolean:
value: nil
mouse_text: "Select 'Yes' to conserve memory by storing spectra on disk instead of in memory."


exec_data: ("SCDECONM"
	          ("GENERAL"
			  ("version" implicit: "ProMAX $Id: scdeconm1.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
                          ("ISTAGE"   implicit: 1) ;Ensemble spectral estimation
			  ("GATELIST" implicit: (if (value 'db_option)(value 'GATELIST) "NONE"))
			  ("PRIM_KEY" implicit: (value 'PRIM_KEY))
			  ("SCND_KEY" implicit: (value 'SCND_KEY))
			  ("DCN_GATE" implicit: (value 'DCN_GATE))
			  ("TAPEROPT" implicit: ( if (value 'TAPEROPT) 1 0 ))
			  ("TAPERLEN" implicit: (value 'TAPERLEN))
			  ("DCN_OPER" implicit: (value 'DCN_OPER))
			  ("DCN_WHTN" implicit: (value 'DCN_WHTN))
			  ("TWIN_MIN" implicit: (value 'TWIN_MIN))

			  ("S_DECOMP"   implicit: ( if (member :shot (value 'COMPONENTS)) 1 0 ))
			  ("R_DECOMP"   implicit: ( if (member :rcvr (value 'COMPONENTS)) 1 0 ))
			  ("O_DECOMP"   implicit: ( if (member :offset (value 'COMPONENTS)) 1 0 ))
			  ("C_DECOMP"   implicit: ( if (member :cdp (value 'COMPONENTS)) 1 0 ))
			  ("X_DECOMP"   implicit: ( if (member :other (value 'COMPONENTS)) 1 0 ))
			  ("OTHERNAM"   implicit: (value 'OTHERNAM))
			  ("OTHERMIN"   implicit: (value 'OTHERMIN))
			  ("OTHERMAX"   implicit: (value 'OTHERMAX))
			  ("OTHERINC"   implicit: (value 'OTHERINC))
			  ("OTHERFLD"   implicit: (value 'OTHERFLD))

			  ("OFFS_RES"   implicit: ( if (value 'OFFS_RES) 1 0 ))
			  ("OFFS_MIN"   implicit: (value 'OFFS_MIN ))	
			  ("OFFS_MAX"   implicit: (value 'OFFS_MAX ))	
			  ("ID_CHARS"   implicit: (value 'ID_CHARS))
			  ("OVERWRIT"   implicit: ( if (value 'OVERWRIT) 1 0 ))
			  ;MEM_OPT: switch 0 and 1 so that in program 1 means use memory.
			  ("MEM_OPT "   implicit: ( if (value 'MEM_OPT) 0 1 ))
			  )
      )


rules: (

        (rule_time_gate (value 'db_option)
		(progn	(do_show 'GATELIST)
			(do_not_show '(PRIM_KEY SCND_KEY DCN_GATE)))
		(progn	(do_not_show 'GATELIST)
			(do_show '(PRIM_KEY SCND_KEY DCN_GATE))))

	(rule_other_show (member :other (value 'COMPONENTS))
		(do_show '(OTHERNAM OTHERMIN OTHERMAX OTHERINC OTHERFLD))
		(do_not_show '(OTHERNAM OTHERMIN OTHERMAX OTHERINC OTHERFLD))
	)

	(rule_other_text (value 'OTHERNAM)
		(progn
			(set_text 'OTHERMIN (string_concatinate 
				"  Minimum value for " (value 'OTHERNAM)))
			(set_text 'OTHERMAX (string_concatinate 
				"  Maximum value for " (value 'OTHERNAM)))
			(set_text 'OTHERINC (string_concatinate 
				"  Increment for " (value 'OTHERNAM)))
			(set_text 'OTHERFLD (string_concatinate
				"  Maximum fold for " (value 'OTHERNAM)))
			(set_mouse_text 'OTHERMIN (string_concatinate 
				"Enter minimum value for OTHER component header word " (value 'OTHERNAM)))
			(set_mouse_text 'OTHERMAX (string_concatinate 
				"Enter maximum value for OTHER component header word " (value 'OTHERNAM)))
			(set_mouse_text 'OTHERINC (string_concatinate 
				"Enter increment for OTHER component header word " (value 'OTHERNAM)))
			(set_mouse_text 'OTHERFLD (string_concatinate
				"Enter maximum number of traces in a common " (value 'OTHERNAM) " gather."))
		)
	)

	(rule_offs_res (value 'OFFS_RES)
                (do_show '(OFFS_MIN OFFS_MAX))
                (do_not_show '(OFFS_MIN OFFS_MAX)))

	(rule_taper_opt (value 'TAPEROPT)
		(do_show 'TAPERLEN)
		(do_not_show 'TAPERLEN))


	)
)
