;; 1 IIID IVD DEV DEPTHC
'(
name: W_SRME_V3
label: "SRME"
value_tab: 50

parameter: MULT_LIN
text: "Process multiple lines?"
type: boolean:
value: nil
mouse_text: "The SRME can be run on multiple lines, restarting at the beginning of each."
plot_label: t

parameter: HDR_VAL0
text: "  Header entry for line change"
type: function:
type_desc: (header_list headers )
value: "NONE    "
selected_item: "INVALID"
mouse_text: "Use MB1 to specify the trace header entry to indicate a change."
plot_label: t

parameter: parallel
text: "Perform parallel processing?"
type: boolean:
value: nil
mouse_text: "The SRME can be run in parallel on several remote machines simultaneously."
plot_label: t

parameter: machines
text: "  Specifies the machines to run processes on"
type: edit:
type_desc: (30 80 3 " Format: Enter format example here, followed by a carriage return
 Example: silver,packhorse.advance.com,sunpony, monolith, mustang
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A             Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E             Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys     Delete one character to the LEFT of the cursor
 E:  Ctrl-D                     Delete one character to the RIGHT of the cursor
 E:  Ctrl-K             KILL to the end of the line (from the cursor)
 E:  Ctrl-Y             YANK back the contents of the kill buffer; 'Cut and
                          paste'; (Can move the cursor first) " 5 )
value: "XXX"
mouse_text: "This item calls the EDIT function. The 'type_desc:' dictates an editor 80 characters by 5 lines (30 chars to show on the menu.)"
plot_label: t

parameter: HDR_VAL1
text: "Primary key of regularization"
type: function:
type_desc: (header_list headers )
value: "SOURCE  "
selected_item: "SOURCE  "
mouse_text: "Use MB1 to specify the Primary key trace header entry of regularization."
plot_label: t

parameter: MAXTIME
text: "Maximum trace time (ms)"
type: typein:
type_desc:  ( int: 7 1 nil)
value: 6000
mouse_text: "Maximum trace time in ms to process."

parameter: MAXSHOTS
text: "Maximum number of shots"
type: typein:
type_desc:  ( int: 7 1 nil)
value: 999999
mouse_text: "The maximum number of shots in this dataset."

parameter: MAXFREQ
text: "Maximum Frequency to process"
type: typein:
type_desc: ( real: 9 nil nil )
value: 0.0
mouse_text: "Maximum frequency to process (hz).  0.0 implies Nyquist."
plot_label: t

parameter: FILENAME
text: "Trace Header file name:"
type: typein:
type_desc: ( :string 32 )
value: "trchdrs"
mouse_text: "Specify the name of the file to save the Trace Headers out to."
plot_label: t

parameter: SFLIP
text: "Flip shot direction?"
type: boolean:
value: nil
mouse_text: "Select 'Yes' or 'No'."
plot_label: t

;parameter: CFLIP
;text: "Flip channel direction?"
;type: boolean:
;value: nil
;mouse_text: "Select 'Yes' or 'No'."
;plot_label: t

parameter: LENTAP
text: "Length of spatial taper (traces)"
type: typein:
type_desc:  ( int: 9 1 nil)
value: 20
mouse_text: "Spatial taper length (# traces)."

parameter: PFREQT
text: "Frequency taper"
type: typein:
type_desc: ( real: 9 0.0 100.0 )
value: 10.0
mouse_text: "Frequency taper (% of maximum frequency)."
plot_label: t

parameter: SR_RATIO
text: "Input Shot/Receiver Spacing Ratio"
type: pop_choose:
type_desc: (
        ("1:1" 11 "Shot/Receiver Spacing Ratio is 1:1")
        ("2:1" 21 "Shot/Receiver Spacing Ratio is 2:1")
        ("3:1" 31 "Shot/Receiver Spacing Ratio is 3:1")
        ("3:2" 32 "Shot/Receiver Spacing Ratio is 3:2")
        ("4:1" 41 "Shot/Receiver Spacing Ratio is 4:1")
)
value: 1
mouse_text: "Select the appropriate input shot/receiver spacing ratio."
plot_label: t

exec_data: (
	("ST_W_SRME_INV2"
		("GENERAL"
			("program"   implicit: "w_srme_inv2.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
			("MULT_LIN"  implicit: ( if (value 'MULT_LIN) 1 0 ) )
                        ("HDR_VAL0"  implicit: (value 'HDR_VAL0))
		)
	)

	("ST_W_SRMEA_V2"
		("GENERAL"
			("program"   implicit: "w_srmea_v2.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
			("MAXTIME"   implicit: (value 'MAXTIME))
		)
	)

        ("ST_W_SRMEB_V3"
                ("GENERAL"
                        ("program"   implicit: "w_srmeb_v3.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
                        ("MAXSHOTS"  implicit: (value 'MAXSHOTS))
			("HDR_VAL1"  implicit: (value 'HDR_VAL1))
                        ("FILENAME"  implicit: (value 'FILENAME))
			("MAXFREQ"   implicit: (value 'MAXFREQ))
			("PFREQT"    implicit: (value 'PFREQT))
                )
        )

	( ( if (value 'parallel) "PT_PXBEGEND" "VOID" ) 
        	("GENERAL"
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
                	("hosts"    implicit: (value 'machines) )
                	("dunit"    implicit: 0) ; trace distribution (split on ensembles)
;               	("dunit"    implicit: 1) ; trace distribution (split on traces)
                	("wapolicy" implicit: 0) ; broadcast round-robin
                	("pedebug"  implicit: 0)
        	)
   	)

        ("ST_W_SRMEC_V3"
                ("GENERAL"
                        ("program"   implicit: "w_srmec_v3.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
                        ("SFLIP"     implicit: ( if (value 'SFLIP) 1 0 ) )
;                       ("CFLIP"     implicit: ( if (value 'CFLIP) 1 0 ) )
                        ("CFLIP"     implicit: 0 )
                        ("LENTAP"    implicit: (value 'LENTAP))
                        ("SR_RATIO"  implicit: (value 'SR_RATIO))
                )
        )

   	( ( if (value 'parallel) "PXEND" "VOID" )
       		("GENERAL"
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
       		)
   	)

        ("ST_W_SRMED_V3"
                ("GENERAL"
                        ("program"   implicit: "w_srmed_v3.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
                        ("MAXTIME"   implicit: (value 'MAXTIME))
			("HDR_VAL1"  implicit: (value 'HDR_VAL1))
                        ("FILENAME"  implicit: (value 'FILENAME))
                )
        )

	("ST_W_SRMEE"
                ("GENERAL"
                        ("program"   implicit: "w_srmee.exe" )
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
;  variables after here are user parameters
			("MAXFREQ"   implicit: (value 'MAXFREQ))
			("PFREQT"    implicit: (value 'PFREQT))
                )
        )

        ("TRACE_LEN"
                ("GENERAL"
			("version"   implicit: "ProMAX $Id: w_srme_v3.menu 43993 2009-02-26 17:51:37Z David Johnston $ $Revision: 43993 $ $Date: 2009-02-26 10:51:37 -0700 (Thu, 26 Feb 2009) $")
                        ("TRACELEN"  implicit: (* 1.0 (value 'MAXTIME)))
                )
        )

)

rules: 	(

(rule1 (value 'MULT_LIN) (do_show 'HDR_VAL0) (do_not_show 'HDR_VAL0))

(machine_default_rule1
      (equal (value 'machines) "XXX")
          (if (equal (printenv 'PROMAX_MACHINES) "")
;;; xxx will not work on windows
                (set_value 'machines (system "hostname") )
          (set_value 'machines (printenv 'PROMAX_MACHINES) )
) )

(rule5 (value 'parallel) (do_show 'machines) (do_not_show 'machines))

(maxshots_default_rule  (AND ( = (value 'MAXSHOTS) 999999.) (db_parmget_line "NSHOTSz"))
                 (set_value 'MAXSHOTS (db_parmget_line "NSHOTSz")))

	)

)
