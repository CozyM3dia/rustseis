; IIID IVD 1 BSI FIELD DEV DEPTHC BHSS
'(
 name: FBPICK
label: "First Break Picking NEW"
value_tab: 42


parameter: FBP_DATA
text: "Type of data we're picking"
;type: choose:
type: circular:
type_desc: ( 
      ("DYNAMITE "  "DYNAMITE"  "Input data is dynamite (generally well-defined first breaks)." )
      ("VIBROSEIS"  "VIBROSIS"  "Input data is vibroseis (emergent or fairly noisy first breaks)." ) )
mouse_text: "Use DYNAMITE for good, sharp first breaks and VIBROSEIS for emergent or noisy first breaks."


parameter: FB_ENVLP
text: "First break energy envelope width"
type: typein:
type_desc: ( real: 7 1.0e-5 nil )
value: 120.0
mouse_text: "What is the average width of the 'energy envelope' of strong first break amplitudes?"
 

parameter: FB_STAB
text: "Power ratio stabilization factor"
type: typein:
type_desc: ( real: 6 1.0e-4 nil )
value: 10.0
mouse_text: "This factor helps stabilize the leading-to-trailing power ratio used as a picking criteria. (Sugg. range: 5-40 %)"
 

parameter: FB_SHIFT
text: "Shift the pick down?"
;type: choose:
type: pop_choose:
type_desc: ( 
      ("NO"    "NONE"    "Do not shift the first break pick.  Use the picked value as is (onset of energy)." )
      ("PEAK"  "PEAK"    "Shift the pick down to the nearest peak below the actual first break pick." )
      ("TROUGH"  "TROUGH"  "Shift the pick down to the nearest trough below the actual first break pick." ) )
mouse_text: "This option shifts the picks down to the nearest peak or trough.  This improves pick consistantcy in noisy data."


parameter: FBP_FILT
text: "  Filter to apply before shift"
type: typein:
type_desc: ( string: 25 )
value: "8,10,40,50"                                      
mouse_text: "This bandpass filter gets applied before the pick is shifted. Specify F1,F2,F3,F4 or a blank char. for no filter."


parameter: fbp_gat_opt
text: "Specify a pick search gate?"
type: boolean:
value: t
mouse_text: "This option is set true if the user wants to define a time & space-variant window in which to search for picks."


parameter: db_option
text: "  Get pick search gates from database?"
type: boolean:
value: t
mouse_text: "Set this to 'YES' if the time gates were entered interactively."


parameter: GATENAME
text: "    SELECT Time Gate Parameter FILE"
type: function:
type_desc: ((parm_list "GAT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a time gate parameter file from the parameter file menu."


parameter: PRIM_KEY
text: "  SELECT Primary Time Gate Header WORD"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the headers menu as the PRIMARY key for specifying 1st brk pick windows."


parameter: SCND_KEY
text: "  SELECT Secondary Time Gate Header WORD"
type: function:
type_desc: (header_list headers)
value: "OFFSET  "
selected_item: "Signed source-receiver offset"
mouse_text: "Use MB1 to select a header word from the headers menu as the SECONDARY key for specifying 1st brk pick windows."


parameter: GATE_DEF
text: "  First break pick search gate"
type: edit:
type_desc: (26 80 5 " Format: Primary Gate Location Value: Secondary Value: Search Gate /
 Example: 1:-5280:1200-1550 / 1:0:0-300 / 1:5280:1200-1550 /
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
value: "1:0:0-300/1:5280:1200-1550/"
mouse_text: "Define/edit the first break pick search gates (example:' 1:0:0-300/1:2000:800-970/1:5280:1200-1550/')."

parameter: VEL_MIN
text: "Minimum refraction velocity"
type: typein:
type_desc: ( real: 7 0.0 nil )
value: 1000.0
mouse_text: "Minimum reasonable refraction velocity, used to limit pick searches.  Set to 0.0 to disable this feature."
 
parameter: VEL_MAX
text: "Maximum refraction velocity"
type: typein:
type_desc: ( real: 7 0.0 nil )
value: 20000.0
mouse_text: "Maximum reasonable refraction velocity, used to limit pick searches.  Set to 0.0 to disable this feature."
 

parameter: DATABASE
text: "Pick output locations"
type: circular:
type_desc: ( 
      ("HEADERS AND DATABASE"  "BOTH"  "Output the picks to both trace headers and to the TRC database." )
      ("HEADERS ONLY        "  "HEADERS"  "Output the picks to the trace headers only." ) )
mouse_text: "If the picks are written only to the trace headers, this module can be run without a database."


parameter: db_ent_opt
text: "  Create a NEW database entry for picks?"
type: boolean:
value: nil
mouse_text: "If this is set to NO, if a previous database entry is present it will be overwritten (thereby saving space)."


parameter: DB_NUM
text: "Enter 4 digit ID number"
type: typein:
type_desc: ( string: 4 )
value: "0001"
mouse_text: "Enter a 4 digit number (or characters) identifying the database output parameters (such as 0001)."

exec_data: ("FBPICK"
		("GENERAL"
			("version" implicit: "ProMAX $Id: fbpick.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
			("FBP_DATA" implicit: (value 'FBP_DATA))
			("FB_ENVLP" implicit: (value 'FB_ENVLP))
			("FB_SHIFT" implicit: (value 'FB_SHIFT))
			("FB_STAB " implicit: (value 'FB_STAB))
			("FBP_FILT" implicit: (value 'FBP_FILT))
			("FBP_GATE" implicit: (if (value 'fbp_gat_opt) 1 0 ))
			("PRIM_KEY" implicit: (value 'PRIM_KEY))
			("SCND_KEY" implicit: (value 'SCND_KEY))
			("GATE_DEF" implicit: (value 'GATE_DEF))
			("VEL_MIN " implicit: (value 'VEL_MIN))
			("VEL_MAX " implicit: (value 'VEL_MAX))
			("GATENAME" implicit: (if (value 'db_option)
						  (value 'GATENAME) "NONE"))
			("NEW_DB  " implicit: (if (value 'db_ent_opt) 1 0 ))
			("DATABASE" implicit: (value 'DATABASE))
			("CDB_PICK" implicit: (if (value 'db_ent_opt) 
					   (string_concatinate "PICK" (value 'DB_NUM))
					 "PICK0000"))
			("CDB_QUAL" implicit: (if (value 'db_ent_opt) 
					   (string_concatinate "QUAL" (value 'DB_NUM))
					 "QUAL0000"))
		)
	    )	

rules: (
 	(rule4 ( equal ( value 'FB_SHIFT ) "NONE" ) (do_not_show 'FBP_FILT) 
                                        (do_show 'FBP_FILT)) 
	(rule5 ( value 'fbp_gat_opt ) (do_not_show 'VEL_MAX) (do_show 'VEL_MAX)) 
	(rule6 ( value 'fbp_gat_opt ) (do_not_show 'VEL_MIN) (do_show 'VEL_MIN) )
        (rule7 (and (value 'db_option) (value 'fbp_gat_opt) )
 	                     (progn (do_show 'GATENAME)
				    (do_not_show 'PRIM_KEY)
				    (do_not_show 'SCND_KEY)
				    (do_not_show 'GATE_DEF))
			     (progn (do_not_show 'GATENAME)
				    (do_show 'PRIM_KEY)
				    (do_show 'SCND_KEY)
				    (do_show 'GATE_DEF)))
 	(rule8 ( value 'fbp_gat_opt) (do_show 'db_option) (do_not_show 'db_option))
 	(rule9 ( value 'fbp_gat_opt ) ( ) (do_not_show 'GATENAME))  
 	(rule10 ( value 'fbp_gat_opt ) ( ) (do_not_show 'PRIM_KEY)) 
	(rule11 ( value 'fbp_gat_opt ) ( ) (do_not_show 'SCND_KEY)) 
 	(rule12 ( value 'fbp_gat_opt ) ( ) (do_not_show 'GATE_DEF)) 
        (database ( equal ( value 'DATABASE ) "HEADERS") (do_not_show 'db_ent_opt)
                                                          (do_show 'db_ent_opt))
        (rule_new_db ( and (value 'db_ent_opt)( = (value 'DATABASE) "BOTH"))
                          (do_show 'DB_NUM) (do_not_show 'DB_NUM) )

      )

)







