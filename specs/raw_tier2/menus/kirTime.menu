; IIID IVD 1  DEV DEPTHC

'(
 name: KIRCHHOFF
label: "Prestack Kirchhoff Time Mig."
value_tab: 50

parameter: parallel
text: "Perform parallel processing?"
type: boolean:
value: nil
mouse_text: "The migration can be run in parallel on several remote machines simultaneously."

parameter: nprocs
text: "   Number of parallel processes to spawn"
type: typein:
type_desc:  ( int: 5 1 nil)
value: 1
mouse_text: ""
showp: nil

parameter: machines
text: "   Specifies the machines to run processes on"
type: edit:
type_desc: (30 80 3 " Format: Enter format example here, followed by a carriage return
 Example: silver,packhorse.advance.com,sunpony, monolith, mustang
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 5 )
value: "XXX"
mouse_text: "This item calls the EDIT function. The 'type_desc:' dictates an editor 80 characters by 5 lines (30 chars to show on the menu.)"

parameter: dcdp
text: "CDP interval (feet or meters)"
type: typein:
type_desc:  ( real: 7 0.001 nil)
value: 999999.
mouse_text: "CDP spacing in feet or meters (consistent with headers)."

parameter: defBounds
text: "Explicitly define bounds of output field?"
type: boolean:
value: nil
mouse_text: "If YES, you specify the bounds and trace spacing of the output field.  If NO, the data is migrated onto the input trace positions."
plot_label: t

parameter: xout1
text: "   First CDP of output field"
type: typein:
type_desc:  ( real: 7 nil nil)
value: 101.
mouse_text: "Please specify the first CDP number of the migrated output field."

parameter: xoutL
text: "   Last CDP of output field"
type: typein:
type_desc:  ( real: 7 nil nil)
value: 401.
mouse_text: "Please specify the last CDP number of the migrated output field."

parameter: dxout
text: "   CDP spacing of traces in output field"
type: typein:
type_desc:  ( real: 5 0.0001 nil)
value: 2.
mouse_text: "Spacing of your output field in CDPs.  If your CDP interval is 50 ft, to make your migrated section have 75 ft spacing, specify 1.5 here."
plot_label: t

parameter: buffer
text: "   Extend output field beyond first and last CDP"
type: typein:
type_desc:  ( real: 5 0.0 nil)
value: 0.
mouse_text: "Specify how many CDPs your output field extends beyond the first and last CDP of the input ensemble."

parameter: maxdtr
text: "   Maximum number of traces in the output field"
type: typein:
type_desc:  ( int: 6 1 nil)
value: 400
mouse_text: "Specify the maximum number of CDPs the migrated output field will contain based on the CDP range of each ensemble and your CDP spacing."

parameter: useHorTbl
text: "Input a Horizon Table?"
type: boolean:
value: nil
mouse_text: "Use a horizon table to limit the migration to certain zones, significantly increasing speed.  With no horizon file specified, all the data is migrated."

parameter: ahzFile
text: "  Select a Horizon Table"
type: function:
type_desc:  ((parm_list "AHZ") parms)
value: "no entry"
selected_item: "No horizon table has been selected!"
mouse_text: "Select a Horizon table that was previously created in screen display."

parameter: fmax
text: "Maximum frequency (in Hz)"
type: typein:
type_desc:  ( real: 5 0.001 nil )
value: 50.0
mouse_text: "For efficency, set this as low as possible.  Frequencies above this value will not be migrated."
plot_label: t


parameter: aper
text: "Migration aperture (feet or meters)"
type: typein:
type_desc:  ( real: 7 0.0 nil )
value: 0.0 
mouse_text: "How far can energy propagate in the horizontal direction?  0.0 defaults to the maximum possible aperture."
plot_label: t

parameter: checkAliasing
text: "Avoid spatial aliasing?"
type: boolean:
value: nil
mouse_text: "Avoiding aliasing will produce cleaner migrations when spatial sampling is large but also increases run time."
plot_label: t

parameter: dxin
text: "Approximate input trace spacing in CDPs"
type: typein:
type_desc:  ( real: 4 0.0 nil )
value: 0.0 
mouse_text: "To avoid spatial aliasing, enter the approximate input trace spacing.  If this is 0.0, an appropriate value will be computed in the migration."
plot_label: t

parameter: solver
text: "Method for producing the green's function"
type: pop_choose:
type_desc: (
   ("RMS computation" 0 "This is fast method that computes diffraction curves using the RMS equation.  " )
)
value: 0
mouse_text: ""
plot_label: t

parameter: accuracy
text: "Accuracy factor"
type: typein:
type_desc:  ( real: 5 0.1 16.0 )
value: 1.0 
mouse_text: "A larger number increases accuracy at the expense of speed, a smaller number does the reverse. "  
plot_label: t

; parameter: doAmplitudes
; text: "Do proper amplitudes?"
; type: boolean:
; value: nil
; mouse_text: "Specify YES to handle amplitudes properly.  This may increase run time. "
; plot_label: t


parameter: vel_b
text: "Get RMS velocities from database?"
type: boolean:
value: t
mouse_text: "This migration uses RMS velocities in time.  Do you want to get these velocities from the database?"
plot_label: t

parameter: velf
text: "   Select RMS vs. time velocity file"
type: function:
type_desc:  ((parm_list "VEL") parms)
value: "no entry"
selected_item: "No velocity file has been selected!"
mouse_text: "Use Mouse Button 1 to select an file from the RMS velocity vs. time database."
plot_label: t

parameter: vels
text: "RMS velocities in time for migration"
type: edit:
type_desc: (20 80 5 " FORMAT: CDP1: T1-V1,T2-V2,...,Tn-Vn / CDP2: T1-V1,T2-V2,...,Tn-Vn /
 EXAMPLE: 1:0-5000,900-6725,1500-8571,2000-9670/ 101:0-5100,860-6690,2000-9852/
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
 value: "XXX"
mouse_text: "Use Mouse Button 1 to edit velocities for migration. (See editor for examples.)"
plot_label: t

parameter: vsmooth
text: "   Velocity Smoothing (feet or meters)"
type: typein:
type_desc:  ( real: 5 0.0 nil )
value: 100.0 
mouse_text: "Smoothing velocities aids the ray tracing.  Specify vertical and horizontal smoothing in feet or meters."
plot_label: t

;parameter: change_mem
;text: "Override default memory usage?"
;type: boolean:
;value: nil
;mouse_text: "Set to 'YES' to change the maximum memory the migration can use."

;parameter: max_memory
;text: "   Maximum Memory for migration to use in megabytes"
;type: typein:
;type_desc:  ( real: 4 0. nil )
;value: 24.
;mouse_text: "When the migration requires more memory than this limit, the migration is done in overlapping panels."

parameter: changeTapering
text: "Change the default tapering?"
type: boolean:
value: nil
mouse_text: "Tapering is automatically applied to the bottom and edges of the data.  Enter YES to change the amount of tapering."

parameter: ms_taper
text: "   Bottom taper (in milliseconds)"
type: typein:
type_desc: ( real: 6 0 nil )
value: 200.0
mouse_text: "The bottom of all traces is tapered to avoid data truncation artifacts when padded with zeros."

parameter: taperTop
text: "   Upper edge taper (in traces)"
type: typein:
type_desc: ( int: 3 0 nil )
value: 2
mouse_text: "Edge tapering will be varied linearly between the upper and lower parts of the section."

parameter: taperBot
text: "   Lower edge taper (in traces)"
type: typein:
type_desc: ( int: 4 0 nil )
value: 20
mouse_text: "Edge tapering will be varied linearly between upper and lower parts of section. Usually greater toward bottom of section."

;parameter: remute_b
;text: "Re-apply trace mutes?"
;type: boolean:
;value: t
;mouse_text: "Yes: trace mutes will be re-applied after migration.  No: Mutes will be adjusted as necessary."
;plot_label: t

;parameter: rekill_b
;text: "Re-kill dead traces?"
;type: boolean:
;value: t
;mouse_text: "If 'Yes', traces that were dead (all zeros) before migration will be killed after migration.  If 'No', dead traces will become live."

parameter: DEBUG
text: "debug mode?"
type: boolean:
value: nil
mouse_text: "If 'Yes', use debug mode for executing the stand alone module."


exec_data: (
	   ("MIGTAPER"
		("GENERAL"
			("ms_taper" implicit: (if (value 'changeTapering) (value 'ms_taper) 200. ) )
			("estimateTaper" implicit: 0 )
			("taperTop" implicit: (if (value 'changeTapering) (value 'taperTop) 2 ) )
			("taperBot" implicit: (if (value 'changeTapering) (value 'taperBot) 20) )
		)
   	)


	   ("KIR_P_TOOL"
		("GENERAL"
; The following are parameters for the stand alone capability
		   	("program"   implicit: "kirchco.exe" )
			("communication_protocal" implicit: 0)
		   	("DEBUG"   implicit: (if (value 'DEBUG) 2 0) )
			("machines" implicit: (if (value 'parallel) (value 'machines) " ") )
			("nProcesses" implicit: (if (value 'parallel) (value 'nprocs) 1) )

; Normal program parameters
                ("version" implicit: "ProMAX $Id: kirTime.menu 41831 2007-09-01 20:51:38Z crs $ $Revision: 41831 $ $Date: 2007-09-01 14:51:38 -0600 (Sat, 01 Sep 2007) $")
		("dcdp" implicit: (value 'dcdp))
	   	("defBounds"   implicit: (if (value 'defBounds) 1 0) )
		("xout1" implicit: (value 'xout1))
		("xoutL" implicit: (value 'xoutL))
		("dxout" implicit: (value 'dxout))
		("buffer" implicit: (value 'buffer))
		("maxdtr" implicit: (value 'maxdtr))
		("fmax" implicit: (value 'fmax))
		("dz" implicit: 0.0 )
		("aperture" implicit: (value 'aper))
		("emerAngle" implicit: 89.0 )
		("doTurning" implicit: 1 )
		("depth" implicit: 0.0 )
;		("rekill" implicit: (if (value 'rekill_b) 1 0))
;		("remute" implicit: (if (value 'remute_b) 1 0))
		("remute" implicit: 0)
;		("max_memory" implicit: (value 'max_memory))
		("velf" implicit: (if (value 'vel_b) (value 'velf) "NONE"))
		("vels" implicit: (value 'vels))
		("solver" implicit: (value 'solver))
		("accuracy" implicit: (value 'accuracy))
		("vsmooth" implicit: (if (> (value 'solver) 2) (value 'vsmooth) 0.0 ) )
		("checkAliasing" implicit: (if (value 'checkAliasing) 1 0 ))
		("fromTopo" implicit: 0 )
		("datum" implicit: 0.0)
		("useHorTbl" implicit: (if (value 'useHorTbl) 1 0 ) )
		("ahzFile" implicit: (value 'ahzFile))
;		("doAmplitudes" implicit: (if (AND (> (value 'solver) 2) (value 'doAmplitudes)) 1 0 ) )
		("dxin" implicit: (value 'dxin))
	)
   )
)


rules: (
	(cdp_interval_default_rule  ( = (value 'dcdp) 999999.) 
		(set_value 'dcdp (db_parmget_line "DCDPILNz")))
;;;;;	(rule4 (value 'parallel) (do_show 'nprocs) (do_not_show 'nprocs))
	(rule5 (value 'parallel) (do_show 'machines) (do_not_show 'machines))
        (((value machines)) counthosts (showing 'machines)
		(set_value 'nprocs (system (string_concatinate
			(promax_path "port/bin/PvmHostCount")
			" '" (value 'machines) "'" ) ) ) )
	(rule1 (showing 'vels) (do_not_show 'velf) (do_show 'velf))
	(rule2 (value 'vel_b) (do_not_show 'vels) (do_show 'vels))
;	(rule3 (value 'change_mem) (do_show 'max_memory) (do_not_show 'max_memory))
	(rule3 (value 'useHorTbl) (do_show 'ahzFile) (do_not_show 'ahzFile))
	(rule3 (> (value 'solver) 2) (do_show 'vsmooth) (do_not_show 'vsmooth))
;	(rule3 (> (value 'solver) 2) (do_show 'doAmplitudes) (do_not_show 'doAmplitudes))
	(rule3 (value 'checkAliasing)  (do_show 'dxin) (do_not_show 'dxin))
	(vels_default_rule1 (and 
		(equal (value 'vels) "XXX")
		(= (db_parmget_line "IUNITSz") 1))
		(set_value 'vels 
"1:0-5000,1000-7500,2000-9500,3000-11500,4000-14000,6000-18000,8000-22000/"))
	(vels_default_rule2 (equal (value 'vels) "XXX")
		(set_value 'vels
"1:0-1480,1000-2500,2000-3200,3000-4000,4000-4500,6000-6000,8000-7000/"))

 (rule3 (value 'changeTapering)    (progn 
 				    (do_show 'ms_taper)
				    (do_show 'taperTop)
				    (do_show 'taperBot))
			     (progn 
 				    (do_not_show 'ms_taper)
				    (do_not_show 'taperTop)
				    (do_not_show 'taperBot)) )
 (rule3 (value 'defBounds)    (progn 
 				    (do_show 'xout1)
				    (do_show 'xoutL)
				    (do_not_show 'maxdtr)
				    (do_not_show 'buffer))
			     (progn 
 				    (do_not_show 'xout1)
				    (do_not_show 'xoutL)
				    (do_show 'maxdtr)
				    (do_show 'buffer)) )
 (machine_default_rule1 
      (equal (value 'machines) "XXX")
 	  (if (equal (printenv 'PROMAX_MACHINES) "")
;;; xxx will not work on windows
 		(set_value 'machines (system "hostname") )
 	  (set_value 'machines (printenv 'PROMAX_MACHINES) )
) )
 (socket_debug_rule t
	(if (= (printenv 'SOCKET_DEBUG) "t")
		(do_show 'DEBUG)
		(do_not_show 'DEBUG) )  )
  (static_rule t
	(dont_show 'solver))
  (static_rule t
	(dont_show 'accuracy))
)

)

