; IIID IVD 1 FIELD DEPTHC DEV
'(
name: radontau
label: "Radon/Tau-P Analysis"
value_tab: 45

parameter: Xserver
text: "Select display DEVICE"
type: typein:
type_desc: (:string 32)
  :value "This Screen"
 mouse_text: "'This Screen' for current display or type in a display name to override the current display default."

;
; need parm to select Radon/TauP here
;

;parameter: TMODE
;text: "Type of transform"
;type: circular:
;type_desc: ( ("Radon" 0 "Radon transform")
;	     ("Tau-P" 1 "Tau-P transform"))
;mouse_text: "Choose radon or tau-p transform for analysis."

; radon only
parameter: NP 
text: "Number of P-values"
type: typein:
type_desc: ( int: 7 1 nil )
value: 31
mouse_text: "The number of P-values for the Radon transform."


parameter: PMIN
text: "Minimum P-value of interest (ms)"
type: typein:
type_desc: ( real: 8 nil nil )
value: -100.
mouse_text: "This is the minimum P-value in msecs (overcorrected)."


parameter: PMAX
text: "Maximum P-value of interest (ms)"
type: typein:
type_desc: ( real: 8 nil nil )
value: 400.
mouse_text: "This is the maximum P-value in msecs (undercorrected)."

parameter: TMIN
text: "Minimum time of interest (ms)"
type: typein:
type_desc: ( real: 8 0.0 nil )
value: 0.0
mouse_text: "This is the minimum time in msecs for Radon transform."


parameter: TMAX
text: "Maximum time of interest (ms)"
type: typein:
type_desc: ( real: 8 0.0 nil )
value: 0.0
mouse_text: "This is the maximum time in msecs for Radon transform. (0 = use maximum data time.)"

; radon only
parameter: FMIN
text: "Minimum frequency of interest"
type: typein:
type_desc: ( real: 8 0.0 nil )
value: 10.0
mouse_text: "This is the minimum coherent frequency (in Hertz) that is of interest in the data."

; radon only
parameter: FMAX
text: "Maximum frequency of interest"
type: typein:
type_desc: ( real: 8 1.0e-6 )
value: 80.0
mouse_text: "This is the maximum coherent frequency (in Hertz) that is of interest in the data."

; radon only
parameter: RADON_TYPE
text: "Type of transform to perform"
type: pop_choose:
type_desc: ( ("Parabolic" 2 "Parabolic radon transform")
	     ("Hyperbolic" 3 "Hyperbolic radon transform (approx)")
             ("Linear" 1 "Linear radon transform"))
mouse_text: "Choose whether you want to model events which are Linear,
Parabolic, or Hyperbolic."

; radon only
parameter: REF_OFFS
text: "Reference offset for delta moveout"
type: typein:
type_desc: ( real: 8 1.0 1.0e9 )
value: -1.0
mouse_text: "Reference offset at which mute parameters were picked for a particular delta moveout."
 
; radon only
parameter: DAMPING
text: "Damping for radon solution"
type: typein:
type_desc: ( real: 8 0.0001 1.0 )
value: 0.03
mouse_text: "Fraction of damping to add for matrix solver. Value between 0 and 1."
 
; radon only
parameter: LSPARSE
text: "Compute a sparse (Hi-res) radon solution?"
type: boolean:
value:  t
mouse_text: "Sparse inversion constructs a sparse Radon domain solution that also reconstructs the input data in a least-squares sense."


parameter: TIMEDOMAIN
text: "Compute a sparse (Hi-res) radon in time domain?"
type: boolean:
value:  t
mouse_text: "Time domain solution is slower but with fewer compromises."

parameter: MAXITER
text: "  Maximum number of sparse iterations"
type: typein:
type_desc: ( int: 7 0 10000 )
value: 2
mouse_text: "This many iterations will be performed at each frequency."

; radon only
parameter: LAMBDA
text: "  Sparseness parameter"
type: typein:
type_desc: ( real: 8 0.0001 1.0 )
value: 0.1
mouse_text: "Amount of sparseness in solution measured as a fraction of the main matrix diagonal. Use value between 0 and 1.0."
 
; radon only
parameter: SPARSE_B
text: "  Sparseness stability parameter"
type: typein:
type_desc: ( real: 8 0.0001 1.0 )
value: 0.1
mouse_text: "This parameter (measured as a fraction of sparseness parameter) avoids division by zero. Use value between 0.0001 and 1.0."
 
; radon only
parameter: EPSILON
text: "  Sparse inversion stopping parameter"
type: typein:
type_desc: ( real: 8 0.000001 1.0 )
value: 0.001
mouse_text: "Parameter to determine when sparse solution has been reached. When change in solution is less than this amount, iterations stop." 

parameter: NCGITER
text: "Number of CG iterations"
type: typein:
type_desc: ( int: 4 1 100 )
value: 3
mouse_text: "Maximum number of conjugate gradient iterations."

;parameter: GATELENG
;text: "Gate length"
;type: typein:
;type_desc: ( float: 7 20.0 10000.0 )
;value: 400.0
;mouse_text: "The data will be processed in time gates of this length."
 
parameter: MUTETF
text: "Mute the data in the radon/tau-p domain?"
type: boolean:
value:  t
mouse_text: "Primaries or multiples can be muted after transforming."


parameter: MUTETYPE
text: "  Type of mute"
type: circular:
type_desc: ( ("Top" 1 "Mute energy from time zero to the specified times." )
             ("Bottom" 2 "Mute energy from the specified times to the bottom of the data." ) )
mouse_text: "The mute type determines how the input times and locations will be used to mute the traces."

parameter: MUTENAME
text: "  Select mute parameter file"
type: function:
type_desc: ((parm_list "MUT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a mute parameter file description from the parameter file menu."

parameter: MUTERAMP
text: "  Length of mute ramp"
type: typein:
type_desc: ( int: 7 1 nil )
value: 30
mouse_text: "The length of the on/off time ramp used when applying the mute."

parameter: SUBTRACT_TX
text: "Subtract TX data"
type: boolean:
value: nil
mouse_text: "Subtract filtered TX gather from input TX data:  yes/no"

parameter: REMUTE
text: "Remute flag"
type: boolean:
value: nil
mouse_text: "Reapply mutes to traces:  yes/no"

parameter: program
text: "Program executable name"
type: edit:
type_desc: (30 100 2 " Example: /usr/stof/promax/sa/my_prog
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A             Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E             Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys     Delete one character to the LEFT of the cursor
 E:  Ctrl-D                     Delete one character to the RIGHT of the cursor
 E:  Ctrl-K             KILL to the end of the line (from the cursor)
 E:  Ctrl-Y             YANK back the contents of the kill buffer; 'Cut and 
                          paste'; (Can move the cursor first) " 3 )
value: "radon_taup.exe"
mouse_text: "Type path name of program executable.  If the path doesn't start wi
th a /, the main ProMAX executable directory is used."

parameter: DEBUG
text: "Debug mode?"
type: boolean:
value: nil
mouse_text: "To debug program, enter YES.  You will have to debug the program yo
urself"


exec_data: ("ST_RADON_TAUP_AN"
	    ("GENERAL"
	     ("version" implicit: "ProMAX $Id: radon_taup.menu 44212 2009-04-28 23:03:36Z Ted Shuck $ $Revision: 44212 $ $Date: 2009-04-28 17:03:36 -0600 (Tue, 28 Apr 2009) $")
; hardwire TMODE to 0 (radon) until Tau-P Transform is implemented
	     ("Xserver"  implicit: (if (= (value 'Xserver) "This Screen") (where_promax_displays) (value 'Xserver)))
	     ("TMODE"    implicit: 0 )
	     ("NP"       implicit: (value 'NP))
	     ("PMIN"     implicit: (value 'PMIN))
	     ("PMAX"     implicit: (value 'PMAX))
	     ("TMIN"     implicit: (value 'TMIN))
	     ("TMAX"     implicit: (value 'TMAX))
	     ("FMIN"     implicit: (value 'FMIN))
	     ("FMAX"     implicit: (value 'FMAX))
	     ("REF_OFFS" implicit: (value 'REF_OFFS))
	     ("DAMPING"  implicit: (value 'DAMPING))
	     ("RADON_TYPE" implicit: (value 'RADON_TYPE))
;	     ("HPOWER"   implicit: (if (= (value 'RADON_TYPE) 1) 1.0 
;				     (if (= (value 'RADON_TYPE) 2) 
;					 2.0 1100.0)) )
	     
	     ("LSPARSE"  implicit: (if (value 'LSPARSE) 1 0))
	     ("TIMEDOMAIN"  implicit: (if (value 'TIMEDOMAIN) 1 0))
	     ("MAXITER"  implicit: (value 'MAXITER))
	     ("NCGITER"  implicit: (value 'NCGITER))
	     ("LAMBDA"   implicit: (value 'LAMBDA))
	     ("SPARSE_B" implicit: (value 'SPARSE_B))
	     ("EPSILON"  implicit: (value 'EPSILON))
;	     ("GATELENG" implicit: (value 'GATELENG))
	     ("MININENS" implicit: 5 )
	     ("MUTETF"   implicit: (if (value 'MUTETF) 1 0))
	     ("MUTETYPE" implicit: (value 'MUTETYPE))
	     ("MUTENAME" implicit: (if (value 'MUTETF)
				       (value 'MUTENAME) "NONE"))
	     ("MUTERAMP" implicit: (value 'MUTERAMP))
	     ("SUBTRACT_TX" implicit: (if (value 'SUBTRACT_TX) 1 0))
	     ("REMUTE" implicit: (if (value 'REMUTE) 1 0))
	     ("program"  implicit: (value 'program))
	     ("DEBUG"    implicit: (if (value 'DEBUG) 2 0))
	     )
	    )
rules: ( 
	(rule1 (value 'MUTETF)
	       (do_show '(MUTETYPE MUTENAME MUTERAMP))
	       (do_not_show '(MUTETYPE MUTENAME MUTERAMP)))
 
	(REF_OFFS_default_rule 
	 (if (= ( value 'REF_OFFS) -1.0 )
	     (set_value 'REF_OFFS (  db_parmget_line "OFFMAXz")))) 
	
	(hide_parms_rule (do_not_show '(EPSILON)))
	(sparse_rule (value 'LSPARSE)
		     (do_show '( LAMBDA SPARSE_B TIMEDOMAIN MAXITER NCGITER))
		     (do_not_show '( LAMBDA SPARSE_B TIMEDOMAIN MAXITER NCGITER)))
;  This rule says that the DEBUG parameter should be shown only if
;  the environment variable SOCKET_DEBUG is set to "t"
;	(socket_debug_rule 
;	 (= (printenv 'SOCKET_DEBUG) "t")
;	 (progn (do_show 'DEBUG) (do_show 'program))
;	 (progn (do_not_show 'DEBUG) (do_not_show 'program)))
	(no_show (do_not_show '(program debug)))

	)
)



