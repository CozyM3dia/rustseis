; IIID IVD 1 BSI PROSPECTOR FIELD DEV DEPTHC BHSS
'(
 name: DECON
label: "Spiking/Predictive Decon"
value_tab: 60

parameter: DCN_TYPE
text: "TYPE of deconvolution"
;type: choose:
type: pop_choose:
type_desc: (  
 ("Minimum phase spiking"    1 "Traditional Wiener-Levinson Spiking Decon." ) 
 ("Minimum phase predictive" 4 "Traditional Wiener-Levinson Predictive Decon." ) 
 ("Phase correction only"    2 "Wiener-Levinson Decon without spectral whitening. (Mute zones will be filtered by the phasing correction.)" ) 
 ("Zero phase spiking"       3 "Wiener-Levinson Decon without phase.") )
mouse_text: "Use MB1 to pop up a menu of option choices dictating how the decon operators will be designed and applied."
plot_label: t

;parameter: IDOMAIN
;text: "  Domain for filter application"
;type: circular:
;type_desc: (   ("Time     "  1  "Calculate and apply the filter in the TIME domain." )
;	       ("Frequency"  2  "Calculate and apply the filter in the FREQUENCY domain." ))
;mouse_text: "Single gate filters can be applied in either the TIME domain or the FREQUENCY domain."
;plot_label: t

parameter: DCN_OPER
text: "Decon operator length(s)"
type: typein:
type_desc: (string: 25)
value: "80.0"
mouse_text: "Enter operator length(s), in ms, for each design gate (normally just one gate).  Example: 80.0, 120.0, 160.0."
plot_label: t

parameter: DCN_PRED
text: "Operator prediction distance(s)"
type: typein:
type_desc: (string: 25)
value: "35.0"
mouse_text: "Enter operator prediction distances [in mils] for each design gate (normally just one gate).  Example: 35.0,45.0."
plot_label: t


parameter: wb_option
text: "  Is prediction distance water relative?"
type: boolean:
value: nil
mouse_text: "Select YES to add WB_TIME to the prediction distance."


parameter: pred_correction
text: "  Apply prediction filter correction?"  
type: boolean:
value: nil
mouse_text: "Enter 'YES', if making a correction for a prediction window that contains only the 'first bounce' peg-leg multiple."
plot_label: t

parameter: RATIO
text: "    Auto-correlation ratio"
type: typein:
type_desc: ( real: 7 0.0 1.0 )
value:  0.0
mouse_text: "Set the ratio of the zero and first peg-leg lags of autocorrelation to this value (0.0 - calc. automatically)."
plot_label: t


parameter: TAPEROPT
text: "Apply user specified taper?"
type: boolean:
value: nil
mouse_text: "Select YES for user specified taper length. Select NO for old default of 1/2 minimum operator length."



parameter: TAPERLEN
text: "  Taper length in msec"
type: typein:
type_desc: ( real: 7 0. nil )
value: 50.
mouse_text: "A taper of this length will be applied to EACH end of the design window prior to autocorrelation (0. for no taper)."



parameter: DCN_WHTN
text: "Operator 'white noise' level(s)"
type: typein:
type_desc: (string: 25)
value: "0.1"
mouse_text: "Enter 'white noise' levels, in PERCENT, for each design gate (normally just one gate).  Example: 0.1, 0.5."
plot_label: t

parameter: TWIN_MIN
text: "Window rejection factor"
type: typein:
type_desc: ( real: 7 0. nil )
value: 2.0
mouse_text: "Kill traces with fewer LIVE samples (or design gate lengths less) than this factor times the operator length."


parameter: GATETIME
text: "Time gate reference"
type: pop_choose:
type_desc: ( ("Time 0"       1 "Gate times are referenced to time 0." )
	       ("Water bottom" 2 "Time gates are relative to the water bottom." ) )
mouse_text: "Use MB1 to select the time gate reference."
plot_label: t


parameter: db_option
text: "Get decon gates from the DATABASE?"
type: boolean:
value: t
mouse_text: "Set this to 'NO' if a decon design time gate parameter file was not created interactively. (Enter manually.)"
plot_label: t


parameter: GATENAME
text: "  SELECT decon gate parameter file"
type: function:
type_desc: ((parm_list "GAT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a decon design gate parameter file from the parameter file menu."
plot_label: t

parameter: GATENAWB
text: "  SELECT water relative decon gate file"
type: function:
type_desc: ((parm_list "WBG") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a decon design gate parameter file from the parameter file menu."
plot_label: t


parameter: PRIM_KEY
text: "  SELECT Primary decon gate header word"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the PRIMARY key for specifying decon design gate parms."
plot_label: t

parameter: SCND_KEY
text: "  SELECT Secondary decon gate header word"
type: function:
type_desc: (header_list headers)
value: "AOFFSET "
selected_item: "Absolute value of offset"
mouse_text: "Use MB1 to select another header word as the optional SECONDARY key for specifying decon design gate parameters."
plot_label: t

parameter: DCN_GATE
text: "  SPECIFY decon gate parameters"
type: edit:
type_desc: (30 80 5 " FORMAT: Primary Gate Location Value: (Secondary Gate Loc. Value):Time Gate(s)/
 EXAMPLE: 101:0.0:700-2000,2500-4000 / 101:5280.0:1200-2200,2500-4000 /
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )

value: "1:0:700-2500/1:2640:1000-2800/1:5280:1500-3000/"
mouse_text: "Use MB1 to define the time gates in which to design decon operators (example: '1:0:350-2500/1:5280:1200-2800/')."
plot_label: t
 
parameter: IOUT_OPT
text: "Output traces or filters"
type: pop_choose:
type_desc: (
 ("Normal decon output"  1  "Output deconvolved traces.  Normal mode of operation.")
 ("Filter operator output"  2  "Output filter operators instead of deconvolved traces.")
 ("Autocorrelations output"  3  "Output autocorrelations instead of deconvolved traces."))
mouse_text: "Option to output the filter operator for application to an alternate dataset or for diagnostics."
plot_label: t

parameter: filter_option
text: "Apply a bandpass filter after decon?"
type: boolean:
value: nil
mouse_text: "A bandpass filter may be applied following the decon application."
plot_label: t

parameter: FLT_FREQ
text: "  Bandpass filter frequency values"
type: typein:
type_desc: ( string: 25 )
value: "4-8-90-120"
mouse_text: "Enter four 'corner' frequencies: F1(0%) - F2(100%) - F3(100%) - F4(0%).  Hanning tapers are used for ramps."
plot_label: t

parameter: remute_option
text: "Re-apply trace mute after decon?"
type: boolean:
value: t
mouse_text: "Trace mutes (such as first break suppression mutes) may be re-applied after decon."

exec_data: ("DECON"
		("GENERAL"
			("version" implicit: "ProMAX $Id: decon.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
			("DCN_TYPE" implicit: (value 'DCN_TYPE))
			("DCN_PRED" implicit: (value 'DCN_PRED))
			("TAPEROPT" implicit: ( if (value 'TAPEROPT) 1 0 ))
			("TAPERLEN" implicit: (value 'TAPERLEN))
			("WB_OPT"   implicit: ( if (value 'wb_option) 1 0 ))
			("RATIO   " implicit: (if (value 'pred_correction) (value 'RATIO) -1.0 ))
; time domain(1) unless bandpass filter, zero phase, or ampl. only are chosen - faster on all platforms
			("IDOMAIN"  implicit: (if (and (or (=(value 'DCN_TYPE) 1)  (=(value 'DCN_TYPE) 4) ) (not (value 'filter_option) ) ) 1 2 ))
			("DCN_OPER" implicit: (value 'DCN_OPER))
			("DCN_WHTN" implicit: (value 'DCN_WHTN))
			("TWIN_MIN" implicit: (value 'TWIN_MIN))
			("GATETIME" implicit: (value 'GATETIME))
			("GATENAME" implicit: (if (value 'db_option) (value 'GATENAME) "NONE"))
			("GATENAWB" implicit: (if (value 'db_option) (value 'GATENAWB) "NONE"))
			("PRIM_KEY" implicit: (value 'PRIM_KEY))
			("SCND_KEY" implicit: (value 'SCND_KEY))
			("DCN_GATE" implicit: (value 'DCN_GATE))
			("IOUT_OPT" implicit: (value 'IOUT_OPT))
			("FLT_FREQ" implicit: (if (value 'filter_option) (value 'FLT_FREQ) "    ")) 
			("REMUTE"   implicit: ( if (value 'remute_option) 1 0 ))
		)
	   )

rules: (
        (gate (value 'db_option) (progn (do_show 'GATENAME)
				    (do_not_show 'PRIM_KEY)
				    (do_not_show 'SCND_KEY)
				    (do_not_show 'DCN_GATE))
			     (progn (do_not_show 'GATENAME)
				    (do_show 'PRIM_KEY)
				    (do_show 'SCND_KEY)
				    (do_show 'DCN_GATE)))
	(predictive  (= (value 'DCN_TYPE) 4) 
		(progn 
			(do_show '(pred_correction DCN_PRED wb_option)))
		(progn 
			(dont_show '(pred_correction DCN_PRED wb_option))))
        (bandpass ( and (showing 'filter_option) (value 'filter_option) )
		 (do_show 'FLT_FREQ) (do_not_show 'FLT_FREQ))
	(ratio (and (showing 'pred_correction) (value 'pred_correction) )
	          (do_show 'RATIO) (dont_show 'RATIO) )    
	(output1 (or  (= (value 'DCN_TYPE) 1)  (= (value 'DCN_TYPE) 4) )
		(do_show 'IOUT_OPT) (dont_show 'IOUT_OPT) )
	(output2 ( and (showing 'IOUT_OPT) ( > (value 'IOUT_OPT ) 1 )  )
	        (dont_show '(filter_option remute_option) )
	        (do_show '(filter_option remute_option) ) )

	 (gate_type_rule7 (and (value 'db_option) (showing 'db_option ) (value 'GATETIME) )
		 (if (= (value 'GATETIME) 1)
		     (progn (do_show 'GATENAME) (do_not_show 'GATENAWB) )
		   (progn (do_show 'GATENAWB) (do_not_show 'GATENAME) ) )
		 (do_not_show '(GATENAME GATENAWB)))
	 (taper_opt_rule (value 'TAPEROPT)
	         (do_show 'TAPERLEN)
	         (do_not_show 'TAPERLEN))


	)

)

