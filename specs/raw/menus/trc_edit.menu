; IIID IVD 1 BSI PROSPECTOR FIELD DEV DEPTHC BHSS
'(
 name: TRC_EDIT
label: "Trace Kill/Reverse"
value_tab: 40


parameter: EDITMODE
text: "Trace editing MODE"
type: pop_choose:
type_desc: ( ( "Kill   "  "KILL" "Traces should be KILLED.")
             ( "Reverse" "REVERSE" "Traces should be REVERSED.") 
             ( "Kill Zero Traces"  "ZERO" "Kill traces if all samples are zero or if TRC_TYPE=2.") )
mouse_text: "Traces may be either KILLED or REVERSED, or scanned for all ZEROs and then killed.  ZERO also zeros killed traces."
plot_label: t
 

parameter: db_option
text: "Get edits from the DATABASE?"
type: boolean:
value: t
mouse_text: "If you interactively created trace edit files, use this option to access one."

parameter: INC_MODE
text: "Trace selection MODE"
type: circular:
type_desc: ( ("Kill/Reverse traces in select list" 0 "kill or reverse all listed traces")
             ("Kill/Reverse traces NOT in select list" 1 "kill or reverse all traces NOT listed") )
mouse_text: "The traces in the list can be either INCLUDED or EXCLUDED from subsequent processes."


parameter: KILLNAME
text: "  SELECT trace Kill parameter file"
type: function:
type_desc: ((parm_list "KIL") parms)
value: "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a TRACE KILL parameter file from the parameter file menu."
plot_label: t


parameter: RVRSNAME
text: "  SELECT trace Reverse parameter file"
type: function:
type_desc: ((parm_list "RVS") parms)
value: "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a TRACE REVERSE parameter file from the parameter file menu."
plot_label: t



parameter: EDITKEY1
text: "  PRIMARY edit list header word"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the PRIMARY key for specifying traces to be edited."
plot_label: t


parameter: EDITKEY2
text: "  SECONDARY edit list header word"
type: function:
type_desc: (header_list headers)
value: "CHAN    "
selected_item: "Recording channel number"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the SECONDARY key for specifying traces to be edited."
plot_label: t


parameter: EDITKEY3
text: "  TERTIARY edit list header word"
type: function:
type_desc: (header_list headers)
value: "NONE    "
selected_item: "No trace header entry selected"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the TERTIARY key for specifying traces to be edited."
plot_label: t




parameter: EDIT_LST
text: "  SPECIFY traces to be edited"
type: edit:

type_desc: (32 80 5 " FORMAT: Primary Header Word Value to Edit:Secondary Header Word Value to Edit/
 EXAMPLES: 1:1-60 / 11:1,5,79,110 / 21-30:60-61 /




 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )

value: "1:60,78/14:1,40,120/"
mouse_text: "Use MB1 to access the text editor and define the locations of the traces to be edited."




plot_label: t


exec_data: ("TRC_EDIT"
		("GENERAL"
			("version" implicit: "ProMAX $Id: trc_edit.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
			("EDITMODE" implicit: (value 'EDITMODE))
			("EDITNAME" implicit: 
		           (cond (( or (not (showing 'db_option)) (not (value 'db_option)) ) "NONE" )
				 (( equal (value 'EDITMODE) "KILL" )(value 'KILLNAME))
				 (( equal (value 'EDITMODE) "REVERSE") (value 'RVRSNAME))
			       )
			 )
			("KILLNAME" implicit: (value 'KILLNAME))
			("RVRSNAME" implicit: (value 'RVRSNAME))

			("EDITKEY1" implicit: (value 'EDITKEY1))
			("EDITKEY2" implicit: (value 'EDITKEY2))
			("EDITKEY3" implicit: (value 'EDITKEY3))





			("EDIT_LST" implicit: (value 'EDIT_LST))
			("MERGE"    implicit: 1)
			("INC_MODE"     implicit: (value 'INC_MODE))
		)
	    )	

rules: (

 (zero  (= (value 'EDITMODE) "ZERO" ) (dont_show 'db_option) ( do_show 'db_option) )

 (kill  (and (showing 'db_option) (value 'db_option) ( = (value 'EDITMODE) "KILL" ) )
	    (do_show 'KILLNAME) (do_not_show 'KILLNAME) )

 (reverse  (and (showing 'db_option) (value 'db_option) ( = (value 'EDITMODE) "REVERSE" ) )
	    (do_show 'RVRSNAME) (do_not_show 'RVRSNAME) )


 (db_option2  (and (showing 'db_option) ( not (value 'db_option)) )  
        ( progn (do_show 'EDITKEY1)
                (do_show 'EDITKEY2)
                (do_show 'EDITKEY3)
                (do_show 'EDIT_LST)
                (do_show 'INC_MODE)
	        (do_not_show 'KILLNAME)
	        (do_not_show 'RVRSNAME) )
	( progn (do_not_show 'EDITKEY1)
        	(do_not_show 'EDITKEY2)
  	        (do_not_show 'EDITKEY3)
  	        (do_not_show 'INC_MODE)
                (do_not_show 'EDIT_LST) ) )
 (tertiary  ( = (value 'EDITKEY2) "NONE    " ) (do_not_show 'EDITKEY3))



      )

)





