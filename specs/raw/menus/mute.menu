; IIID IVD 1 BSI PROSPECTOR FIELD DEV DEPTHC BHSS
'(
  :name MUTE
  :label "Trace Muting"
  :value_tab 39


  :parameter REMUTE
  :text "Re-apply previous mutes"
  :type :choose
  :type_desc (
	      ("No      " 0 "Previous mutes in headers not re-applied")
	      ("Re-mute " 1 "Zero zones which were previously zeroed")
	      ("Re-ramp " 2 "Re-apply mute ramps and zero mute zones") 
	      ("Re-set  " 3 "Re-set mute headers (TLIVE_S, _E, TFULL_S, _E) to first and last live amplitudes") )
  :value 0
  :mouse_text "Mutes specified by LIVE and FULL amplitudes in trace headers may be re-applied with or without ramps."
  :plot_label t


  :parameter MUTETIME
  :text "Mute time reference"
  :type :pop_choose
  :type_desc ( ("Time 0"      1 "Mute times are referenced to time 0." )
	       ("Water Bottom" 2 "Mute times are relative to the water bottom." ) )
  :mouse_text "Use MB1 to select the mute time reference."
  :plot_label t


  :parameter MUTETYPE
  :text "TYPE of mute"
  :type :pop_choose
  :type_desc ( ("Top" 1 "Mute energy from time zero down to the specified times. (Mutes will be interpolated between specified locations.)" )
	       ("Surgical"  2 "Mute a slice of the data between the specified times. (The slice must be 'enclosed'.) " )
	       ("Bottom"    3 "Mute energy from the specified times to the bottom of the data. (Mutes will be interpolated between locations.)" ) )
  :mouse_text "Use MB1 to select the mute type and determine how the input times and locations will be used to mute the traces."
  :plot_label t


  :parameter RAMPON
  :text "  Starting ramp"
  :type :typein
  :type_desc ( :real 10 0.0 nil )
  :value  30.0
  :mouse_text "The time in milliseconds to 'ramp on' amplitudes at the start of the mute."
  :plot_label t

  :parameter RAMPOFF
  :text "  Ending ramp"
  :type :typein
  :type_desc ( :real 10 0.0 nil )
  :value  30.0
  :mouse_text "The time in milliseconds to 'ramp off' amplitudes at the end of the mute."
  :plot_label t

  :parameter SURGLEN
  :text "  Surgical mute ramp"
  :type :typein
  :type_desc ( :real 10 0.0 nil )
  :value  30.0
  :mouse_text "The time in milliseconds to 'ramp on and off' amplitudes for surgical mutes."
  :plot_label t

  :parameter TAPRTYP
  :text "  Taper type"
  :type :pop_choose
  :type_desc (
      ("Linear"  0  "Ramp on or off linearly")
      ("Cosine"  1  "Cosine ramp")
      ("Cosine squared"  2  "Cosine squared ramp")
    )
  :mouse_text "Choose type of ramp taper. Cosine is smoother than linear."
  :plot_label nil
  :showp nil


  :parameter EXTRAP
  :text "  EXTRAPOLATE mute times?"
  :type :boolean
  :value  t
					;:mouse_text "The mute times will be extrapolated past specified control locations."
  :mouse_text "Set to 'NO' if you do not wish the mute times to be extrapolated past specified control locations."

  :parameter EXTEND
  :text "  Mute application"
  :type :pop_choose
  :type_desc ( ("Interpolate over primary and secondary keys" 1 "Mute times will be interpolated/extrapolated over primary and secondary key." )
	       ("Interpolate over secondary key"              2 "Mute times will be interpolated over secondary key only " )
	       ("Apply only where specified"                  3 "Mute will only be applied to traces at specified primary and secondary locations." ) )
  :mouse_text "Use MB1 to select where the mute is applied."
  :plot_label t


  :parameter db_option
  :text "Get mute file from the DATABASE?"
  :type :boolean
  :value t
  :mouse_text "A mute parameter file may be selected from the database, or mute parameters may be specified manually."

  :parameter MUTENAME
  :text "  SELECT mute parameter file"
  :type :function
  :type_desc ((parm_list "MUT") parms)
  :showp nil
  :value  "no entry"
  :selected_item "* No Parameter File has been Selected *"
  :mouse_text "Use Mouse Button 1 to select a standard mute parameter file description from the parameter file menu."
  :plot_label t

  :parameter MUTENAWB
  :text "  SELECT water relative mute file"
  :type :function
  :type_desc ((parm_list "WBM") parms)
  :showp nil
  :value  "no entry"
  :selected_item "* No Parameter File has been Selected *"
  :mouse_text "Use Mouse Button 1 to select a water bottom mute parameter file description from the parameter file menu."
  :plot_label t


  :parameter PRIM_KEY
  :text "  SELECT Primary mute header word"
  :type :function
  :type_desc (header_list headers)
  :value "SOURCE  "
  :selected_item 	"Live source number"
  :mouse_text "Use MB1 to select a header word from the HEADERS menu to use as the PRIMARY key for specifying mute parameters."
  :plot_label t

  :parameter SCND_KEY
  :text "  SELECT Secondary mute header word"
  :type :function
  :type_desc (header_list headers)
  :value "AOFFSET "	
  :selected_item 	"Absolute value of offset"
  :mouse_text "Use MB1 to select a header word from the HEADERS menu to use as the SECONDARY key for specifying mute parameters."
  :plot_label t

  :parameter MUTESPEC
  :text "  SPECIFY mute parameters"
  :type :edit
  :type_desc (28 nil 5 " FORMAT: Primary Mute Location Value: Secondary Mute Location Value: Mute time/
 EXAMPLE: 1:-5280:1000 / 1:0:300 / 1:5280:1000 /
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
  :value "1:"
  :mouse_text "Use MB1 to define/enter the mute specifications. (Example: '1:-5280:1000/1:0:300/1:5280:1000/'.)"
  :plot_label t


  :exec_data ("MUTE"
	      ("GENERAL"
	       ("version"  :implicit "$Id: mute.menu 44577 2009-07-29 16:44:43Z David Johnston $" )
	       ("REMUTE"   :implicit (value 'REMUTE))
	       ("MUTETYPE" :implicit (value 'MUTETYPE))
	       ("MUTETIME" :implicit (value 'MUTETIME))
	       ("EXTRAP"   :implicit (if (value 'EXTRAP) 1 0))
	       ("EXTEND"   :implicit (value 'EXTEND))
	       ("RAMPON"   :implicit (value 'RAMPON))
	       ("RAMPOFF"  :implicit (value 'RAMPOFF))
	       ("SURGLEN"  :implicit (value 'SURGLEN))
	       ("TAPRTYP"  :implicit (value 'TAPRTYP))
	       ("MUTENAME" :implicit (if (value 'db_option)
					 (value 'MUTENAME) "NONE"))
	       ("MUTENAWB" :implicit (if (value 'db_option)
					 (value 'MUTENAWB) "NONE"))
	       ("PRIM_KEY" :implicit (value 'PRIM_KEY))
	       ("SCND_KEY" :implicit (value 'SCND_KEY))
	       ("MUTESPEC" :implicit (value 'MUTESPEC))
	       )
	      )
	

  :rules (

	  (rule1 (and (= ( value 'MUTETYPE ) 1 ) (= (value 'REMUTE) 0 ))
		 (do_show 'RAMPON)  
		 (do_not_show 'RAMPON))

	  (rule2 (and (= ( value 'MUTETYPE ) 3 ) (= (value 'REMUTE) 0 ))
		 (do_show 'RAMPOFF) 
		 (do_not_show 'RAMPOFF)) 

	  (rule3 (and (= ( value 'MUTETYPE ) 2 ) (= (value 'REMUTE) 0 ))
		 (do_show '(SURGLEN EXTEND)) 
		 (do_not_show '(SURGLEN EXTEND))) 

	  (rule5 (and (not (= ( value 'MUTETYPE ) 2 )) (= (value 'REMUTE) 0 )) 
		 (do_show 'EXTRAP) 
		 (do_not_show 'EXTRAP))

	  (rule6 (and (not (value 'db_option)) (showing 'db_option) )
		 (do_show '(PRIM_KEY SCND_KEY MUTESPEC))
		 (do_not_show '(PRIM_KEY SCND_KEY MUTESPEC)))

	  (rule7 (and (value 'db_option) (showing 'db_option ) (value 'MUTETIME) )
		 (if (= (value 'MUTETIME) 1)
		     (progn (do_show 'MUTENAME) (do_not_show 'MUTENAWB) )
		   (progn (do_show 'MUTENAWB) (do_not_show 'MUTENAME) ) )
		 (do_not_show '(MUTENAME MUTENAWB)))

	  (rule8 (= (value 'REMUTE) 0)
		 (do_show '(MUTETIME MUTETYPE db_option))
		 (do_not_show '(MUTETIME MUTETYPE db_option)))
	  )
  )
