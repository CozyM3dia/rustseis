; IIID IVD 1 BSI PROSPECTOR FIELD DEV DEPTHC BHSS
'(
 name: FILTER
label: "Bandpass Filter"
value_tab: 42


parameter: FLT_TYPE
text: "TYPE of filter"
;type: choose:
type: circular:
type_desc: (  
 ("Single Filter         "  1 "Apply a single bandpass filter." ) 
 ("Time and Space-Variant Filter"  2 "Apply time and space-variant filters in space-variant time windows." ))
mouse_text: "Bandpass filters can be applied as a single filter, or both the filters and application gates may spatially vary."
plot_label: t


parameter: FLT_SPEC
text: "Type of filter specification"
;type: choose:
type: circular:
type_desc: (  
 ("Ormsby bandpass     "  1 "Specify filters using 4 frequencies." ) 
 ("Butterworth bandpass"  2 "Specify filters using F1-DB/OCTAVE1-F2-DB/OCTAVE2." ))
mouse_text: "A bandpass filter can be specified as a group of 4 frequency values, or as a group of F1-SLOPE1-F2-SLOPE2 values."
plot_label: t


parameter: PHASE
text: "PHASE of filter"
type: circular:
type_desc: (  
 ("Zero   "  1 "Apply a ZERO phase filter." ) 
 ("Minimum"  2 "Apply a MINIMUM phase filter." ))
mouse_text: "Bandpass filters can be applied as zero phase filters, or as minimum phase filters."
plot_label: t


parameter: RNOISE
text: "  Percent additive noise factor"
type: typein:
type_desc: ( real: 7 0.0 100.0 nil 2 )
value: 1.0
mouse_text: "Enter the percentage of the maximum frequency value to 'floor' the spectrum prior to conversion to minimum phase." 
plot_label: t

parameter: IDOMAIN
text: "Domain for filter application"
type: circular:
type_desc: (   	       ("Frequency"  2  "Apply the filter in the FREQUENCY domain." )
			("Time     "  1  "Apply the filter in the TIME domain." )  )
mouse_text: "Single gate filters can be applied in either the TIME domain or the FREQUENCY domain."


parameter: FILT_LEN
text: "Tapered filter length in ms"
type: typein:
type_desc: ( real: 8 20.0 1000.0 )
value: 160.0
mouse_text: "Enter Hanning tapered filter length for time domain filter application (20-1000 ms)."


parameter: PCT_PAD
text: "Percent zero padding for FFT's"
type: typein:
type_desc: ( real: 7 0.0 100.0 nil 2 )
value: 25.0
mouse_text: "The percent of input trace length to pad with zeroes: 100% is always safe (but slow);10% may be OK for AGC'd data."
 

parameter: notch_option
text: "Apply a notch filter?"
type: boolean:
value: nil
mouse_text: "A notch filter may be applied at virtually any frequency and notch filter width."
plot_label: t


parameter: F_NOTCH
text: "  Notch filter frequency"
type: typein:
type_desc: ( real: 8 0.0 nil )
value: 60.0
mouse_text: "Enter the center frequency of the notch filter you wish to apply."
plot_label: t
 

parameter: N_F_WIDE
text: "  Width of notch filter"
type: typein:
type_desc: ( real: 8 1.0e-6 nil )
value: 4.0
mouse_text: "A 4 Hertz wide, 50 Hertz notch filter will zero frequencies from 48 to 52 Hz and apply exponential edge tapers."
plot_label: t
 

parameter: nsearch_option
text: "  Automatic notch frequency search?"
type: boolean:
value: nil
mouse_text: "This program can automatically scan around the specified notch frequency for the maximum energy to set the notch filter."
plot_label: t


parameter: FREQSCAN
text: "    Maximum notch frequency variation"
type: typein:
type_desc: ( real: 6 1.0e-6 nil )
value: 3.0
mouse_text: "A 60 Hertz, 3 Hertz wide notch search will set the notch to the maximum spectral energy between 57 and 63 Hertz."
plot_label: t
 

parameter: FLT_FREQ1
text: "Ormsby filter frequency values"
type: typein:
type_desc: ( string: 25 )
value: "8-12.5-40-50"                                      
mouse_text: "Enter four 'corner' frequencies: F1(0%) - F2(100%) - F3(100%) - F4(0%).  Hanning (cosine) tapers are used for ramps."
plot_label: t


parameter: FLT_FREQ2
text: "Butterworth filter freq-slope values"
type: typein:
type_desc: ( string: 25 )
value: "8-18-40-72"                                      
mouse_text: "Enter F1(-3dB) - DB/OCTAVE1(slope) - F2(-3dB) - DB/OCTAVE2(slope). Butterworth tapers are used for ramps"
plot_label: t


parameter: FLT_PARM1

text: "Space-variant filter parameters"



type: edit:

type_desc: (27 80 5 " FORMAT: (Primary location key:Secondary location key:)F1-F2-F3-F4,F1-F2-F3-F4/
 EXAMPLE: 1:0:5-10-40-50,10-14-70-90/1:5280:5-10-35-42,8-12-60-75/




 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )

value: "1:0:5-10-40-50,10-14-70-90/1:5280:5-10-35-42,8-12-60-75/"
mouse_text: "Use MB1 to edit/define the SPACE-variant filters and locations to apply to each time gate. (SEE EDITOR EXAMPLE.)"




plot_label: t


parameter: FLT_PARM2

text: "Space-variant filter parameters"



type: edit:

type_desc: (27 80 5 " FORMAT: (Primary location key:Secondary location key:)F1-DB/OCTAVE1-F2-DB/OCTAVE2,F1-DB/OCTAVE1-F2-DB/OCTAVE2/
 EXAMPLE: 1:0:10-18-40-72,14-18-70-72/1:5280:10-18-35-72,12-18-60-72/




 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )

value: "1:0:10-18-40-72,14-18-70-72/1:5280:10-18-35-72,12-18-60-72/"
mouse_text: "Use MB1 to edit/define the SPACE-variant filters and locations to apply to each time gate. (SEE EDITOR EXAMPLE.)"




plot_label: t



parameter: db_option
text: "Get time gates from the DATABASE?"
type: boolean:
value: t

mouse_text: "Set to 'NO' if a time-variant filter time gate parameter file was not created interactively.(Will enter manually.)"



plot_label: t


parameter: GATENAME
text: "  SELECT time gate parameter file"
type: function:
type_desc: ((parm_list "GAT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a spatially-variant time gate parameter file from the parameter file menu."
plot_label: t


parameter: PRIM_KEY
text: "  SELECT Primary time gate header word"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the PRIMARY key for specifying filter design parameters."
plot_label: t

parameter: SCND_KEY
text: "  SELECT Secondary time gate header word"
type: function:
type_desc: (header_list headers)
value: "OFFSET  "
selected_item: "Signed source-receiver offset"
mouse_text: "Use MB1 to select a header word from the HEADERS menu as the SECONDARY key for specifying filter design parms."
plot_label: t

parameter: FLT_GATE
text: "  SPECIFY filter time gate parameters"
type: edit:

type_desc: (21 80 5 " FORMAT: (Primary location key : Secondary location key :) T1-T2, T3-T4/
 EXAMPLE: 1:0:0-1500,2000-4000 / 1:5280:0-2500,3000-4000 /




 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )

value: "1:0:0-1500,2000-4000/1:5280:0-2500,3000-4000/" 
mouse_text: "Define time gates in which to apply requested filters (example: '1:0:0-1500,2000-4000/1:5280:0-2500,3000-4000/')."




plot_label: t


parameter: remute_option
text: "Re-apply trace mute after filter?"
type: boolean:
value: t
mouse_text: "Trace mutes (such as first break suppression mutes) may be re-applied after filtering."


exec_data: 
("FILTER"
 ("GENERAL"
  ("version" implicit: "ProMAX $Id: filter.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
  ("FLT_TYPE" implicit: (value 'FLT_TYPE))
  ("FLT_SPEC" implicit: (value 'FLT_SPEC))
  ("PHASE"    implicit: (value 'PHASE))
  ("RNOISE"   implicit: (value 'RNOISE))
  ("IDOMAIN"  implicit: (value 'IDOMAIN))
  ("FILT_LEN" implicit: (value 'FILT_LEN))
  ("PCT_PAD"  implicit: (value 'PCT_PAD))
  ("FLT_FREQ" implicit: (if (= (value 'FLT_SPEC) 1) (value 'FLT_FREQ1) (if (= (value 'FLT_SPEC) 2) (value 'FLT_FREQ2) )))
  ("FLT_PARM" implicit: (if (= (value 'FLT_SPEC) 1) (value 'FLT_PARM1) (if (= (value 'FLT_SPEC) 2) (value 'FLT_PARM2) )))
  ("F_NOTCH"  implicit: (if (value 'notch_option)
							(value 'F_NOTCH) 0.0 ))
  ("N_F_WIDE" implicit: (value 'N_F_WIDE))
  ("VARNOTCH"  implicit: (if (value 'nsearch_option) 1 0 ))
  ("FREQSCAN" implicit: (value 'FREQSCAN))
  ("GATENAME" implicit: (if (value 'db_option)
							(value 'GATENAME) "NONE" ))

  ("PRIM_KEY" implicit: (value 'PRIM_KEY))
  ("SCND_KEY" implicit: (value 'SCND_KEY))
  ("FLT_GATE" implicit: (value 'FLT_GATE))





  ("REMUTE"   implicit: (if (value 'remute_option) 1 0 ))
  )
 )

rules: 
(




(rule1 ( equal ( value 'FLT_TYPE ) 1 ) 
	   (progn  (do_not_show 'db_option)
			   (do_not_show 'GATENAME)

			   (do_not_show 'PRIM_KEY)
			   (do_not_show 'SCND_KEY)

			   (do_not_show 'FLT_PARM1)
				(do_not_show 'FLT_GATE))
		(progn  (do_not_show 'FLT_FREQ1)
				(do_show 'db_option)
				(do_show 'GATENAME)

				(do_show 'PRIM_KEY)
				(do_show 'SCND_KEY)

				(do_show 'FLT_GATE)))

(rule2 ( and ( equal (value 'FLT_TYPE) 2 ) 
			 (value 'db_option) )  
	   (progn  

          (do_not_show 'PRIM_KEY)
		  (do_not_show 'SCND_KEY)

          (do_not_show 'FLT_GATE)
		  (do_show 'GATENAME)))
 
(rule3 ( and ( equal (value 'FLT_TYPE) 2 )  
			 ( not (value 'db_option) )) 
	   (progn  

		   (do_show 'PRIM_KEY)
		   (do_show 'SCND_KEY)

           (do_show 'FLT_GATE)
		   (do_not_show 'GATENAME)))

(rule4 ( value 'notch_option )
	   (progn  (do_show 'F_NOTCH)
			   (do_show 'N_F_WIDE)
			   (do_show 'nsearch_option))
	   (progn  (do_not_show 'F_NOTCH)
			   (do_not_show 'N_F_WIDE)
			   (do_not_show 'nsearch_option)))

(rule5 ( and (value 'notch_option ) 
			 (value 'nsearch_option ) ) 
	   (do_show 'FREQSCAN) 
	   (do_not_show 'FREQSCAN))

(rule7 ( and ( = ( value 'FLT_TYPE ) 1 )
			 ( = ( value 'FLT_SPEC ) 1 ) )
	   (progn 
		 (do_show 'FLT_FREQ1)
		 (do_not_show '(FLT_FREQ2 FLT_PARM1 FLT_PARM2))))

(rule8 ( and ( = ( value 'FLT_TYPE ) 1 ) 
			 ( = ( value 'FLT_SPEC ) 2 ) )
	   (progn  
		 (do_show 'FLT_FREQ2) 
		 (do_not_show '(FLT_FREQ1 FLT_PARM1 FLT_PARM2))))

(rule9 ( and ( = ( value 'FLT_TYPE ) 2 ) ( = ( value 'FLT_SPEC ) 1 ) )
	   (progn  
		 (do_show 'FLT_PARM1) 
		 (do_not_show '(FLT_FREQ1 FLT_FREQ2 FLT_PARM2))))

(rule10 ( and ( = ( value 'FLT_TYPE ) 2 ) ( = ( value 'FLT_SPEC ) 2 ) )
		(progn  
		  (do_show 'FLT_PARM2)
		  (do_not_show '(FLT_PARM1 FLT_FREQ1 FLT_FREQ2))))

(time_domain_rule1 ( and ( = ( value 'FLT_TYPE ) 1 )
						 (or (not ( value 'notch_option))
							 (not (value 'nsearch_option))) )
				   (do_show 'IDOMAIN) 
				   (do_not_show 'IDOMAIN) )

(time_domain_rule2 ( and ( = ( value 'IDOMAIN ) 1 ) 
						 ( = ( value 'FLT_TYPE) 1 )	
						 (or (not ( value 'notch_option)) 
							 (not (value 'nsearch_option))) ) 
				   (progn (do_show 'FILT_LEN)
						  (do_not_show 'PCT_PAD)) 
				   (progn (dont_show 'FILT_LEN) 
						  (do_show 'PCT_PAD)))

(phase (= (value 'PHASE) 2 ) 
	   (do_show 'RNOISE) 
	   (dont_show 'RNOISE) )

)

)

