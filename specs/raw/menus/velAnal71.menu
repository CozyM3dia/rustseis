parameter: PD_OPT
text: "Interact with other processes using PD?"
type: boolean:
value: t
mouse_text: "If set to yes, a PD connection will be initiated to communicate with VVE and/or the 3D Viewer"
parameter: GUIDTYPE
text: "   Guide file type"
type: typein:
value: "VEL"
mouse_text: "Guide file type."

parameter: GUIDEOPT
text: "Get guide function from an existing parameter table?"
type: boolean:
value: t
mouse_text: "Get the guide function from the list of RMS velocity parameter tables"

parameter: GUIDETBL
text: "   Velocity guide function table name"
type: function:
type_desc: ((parm_list "VEL") parms)
value: "no entry"
mouse_text: "Guide function for fan function stacks, and picking. Use Mouse Button 1 to select a velocity file from the menu."

parameter: MINGDVEL
text: "   Guide minimum value"
type: typein:
type_desc: ( real: 12 MINVEL MAXVEL )
value: 99999999.
mouse_text: "Semblance analysis value at minimum time/depth to use as guide."

parameter: MAXGDVEL
text: "   Guide maximum time value"
type: typein:
type_desc: ( real: 12 MINVEL MAXVEL )
value: 99999999.
mouse_text: "Semblance analysis value at maximum time/depth to use as guide."
;parameter: SPACE12
;text: "-------------------------------------------------"
;value_tab: 80
parameter: STRETCH
text: "Maximum stretch percentage for NMO"
type: typein:
type_desc: ( real: 12 0.0 10000.0)
value: 30.0
mouse_text: "Any trace stretched more than this factor will be excluded from the semblance analysis. Enter 0.0 to turn off this option"

parameter: LONGOFFS
text: "Long offset moveout correction?"
type: choose:
type_desc: ( ( "NONE" 0 "Apply only two term NMO (normal application).")
             ( "ALCHALABI" 1 "Apply Al-Chalabi's third term (fastest).")
             ( "CASTLE" 2 "Apply Castle's shifted hyperbola (slow, least accurate).")
             ( "HARLAN" 4 "Apply Harlan's anisotropic third term (slower, good accuracy).")
             ( "TSVANKIN" 3 "Apply Tsvankin and Thomsen's third term (slowest, most accurate).")
    )
value: 0
mouse_text: "Choose desired method for long-offset moveout correction."

parameter: ETA
text: "   Anisotropy correction parameter eta"
type: typein:
type_desc: ( real: 6 -0.25 1.0 )
value: 0.0
mouse_text: "Value of zero means no anisotropy correction. Normally nonnegative and less than 0.1"
plot_label: t

parameter: LASTINT
text: "Interval velocity below last knee"
type: typein:
type_desc: ( real: 12 0.0e-4 nil )
value: 0.0
mouse_text: "Constant interval velocity used to phantom in unpicked velocity at time max. Use a a value of 0.0 to turn this option off"

parameter: PICKTYPE
text: "   Pick file type"
type: typein:
value: "VEL"
mouse_text: "Pick file type"

parameter: COPYPICK
text: "Copy picks to next location"
type: boolean:
value: nil
mouse_text: "Select YES to copy the picks at one location to the next location if no function previously exists."
parameter: SPACE14
text: "-------------------------------------------------"
value_tab: 80

parameter: DEBUG
text: "Debug mode?"
type: boolean:
value: nil
mouse_text: "To debug program, enter YES."
showp: nil

parameter: program
text: "   Program executable name"
type: edit:
type_desc: (30 100 2 " Example: velAnal.exe
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
value: "velAnal71.exe"
mouse_text: "Type path name of program executable."  

parameter: INIT
type: int:
value: 1
showp: nil

parameter: PATH
type: string:
value: nil
showp: nil

