; IIID IVD 1 FIELD DEV DEPTHC
;  Menu for Velocity Analysis 9/2000
'(

name: velAnal
label: "Velocity Analysis"
value_tab: 55
parameter: Xserver
text: "Select display DEVICE"
type: typein:
type_desc: (:string 32)
:value "This Screen"
mouse_text: "'This Screen' for current display or type in a display name to OVERRIDE the current display default."

parameter: NEWTABLE
text: "Table to store velocity picks"
type: function:
type_desc: ((parm_list "VEL") parms)
value: "no entry"
mouse_text: "Use Mouse Button 1 to select a velocity file from the menu."

parameter: PRECOMP
text: "Is the incoming data Precomputed?"
type: boolean:
value: t
mouse_text: "Incoming data has been precomputed using the vaprecom tool."

parameter: RMO
text: "Perform residual velocity analysis?"
type: int:
type: choose:
type_desc: (
("NONE" 0 "Default pre-stack velocity analysis.")
("TIME" 1 "Residual moveout analysis in time.")
("DEPTH" 2 "Residual moveout analysis in depth.")
)
value: 0
selected_item: "NONE"
mouse_text: "Configure parameters for residual velocity analysis"

parameter: OLDRMO
text: "Previous value of RMO"
type: int:
value: 0
showp: nil


parameter: SPACE0
text: "-------------------------------------------------"
value_tab: 80

parameter: SETPARMS
text: "Set the values for the computation variables?"
type: boolean:
value: t
mouse_text: "Change all of the necessary parameters when running in interactive mode."

parameter: SPACE1
text: "-------------------------------------------------"
value_tab: 80

parameter: LANDDATA
type: integer:
value: 1
parameter: NSMASH
text: "   Number of CDPs to sum into gather"
type: typein:
type_desc: ( int: 3 1 100)
value: 99999999
mouse_text: "Enter the number of CDPs to use to build the commom offset stacked supergather."

parameter: SMASHNMO
text: "   Apply partial NMO-to-binning"
type: boolean:
value: t
mouse_text: "Apply partial NMO before summing trace to offset bin center for supergather."

parameter: SMASHSTA
text: "   Apply differential CDP mean statics?"
type: boolean:
value: t
mouse_text: "Apply differential CDP mean statics prior to offset  super gather stack generation."

parameter: INITDIST
text: "   Absolute offset of first bin center"
type: typein:
type_desc: ( real: 12 0.0 nil)
value: 50.0
mouse_text: "Enter the center of the first offset bin."

parameter: BINSIZE
text: "   Bin size for vertically summing offsets"
type: typein:
type_desc: ( real: 12 nil nil)
value: 100.0
mouse_text: "Enter the offset bin size for summing offsets for supergather generation."

parameter: MAXOFFS
text: "   Maximum offset"
type: typein:
type_desc: ( real: 8 -1.0 1.0e9)
value: -1.0
mouse_text: "Enter the maximum offset for creating common offset stacked supergather."

parameter: USEAOFF
text: "   Use absolute value of offset for stacking?"
type: boolean:
value: t
mouse_text: "If YES absolute value of offset is used to stack gathers for 2D data.  Otherwise, signed offset is used.  3D always uses absolute offset."

parameter: MINVEL
text: "   Minimum semblance analysis value"
type: typein:
type_desc: ( real: 12 nil nil )
value: 99999999.
mouse_text: "Minimum expected stacking value - value of first semblance scan."

parameter: MAXVEL
text: "   Maximum semblance analysis value"
type: typein:
type_desc: ( real: 12 nil nil )
value: 99999999.
mouse_text: "Maximum expected stacking value - value of last semblance scan."

parameter: NVELS
text: "   Number of semblance calculations"
type: typein:
type_desc: ( int: 3 1 999 )
value: 50
mouse_text: "Number of semblance scans to perform between the minimum and maximum velocity range."

; for precompute only
parameter: VELSPACE
text: "   Semblance velocity axis"
type: circular:
type_desc: (
("Equal Velocity" 2 "Semblance velocity spacing and display is logrithmic between minimum and maximum velocity.")
("Slowness Squared" 4 "Spacing proportional to slowness squared. Use this option ONLY to create semblances for Velocity Auto Picker.")
;("Logrithmic" 1 "Semblance velocity spacing and display is logrithmic between minimum and maximum velocity.")
)
value: 2
mouse_text: "Method of spacing velocities along semblance axis."
showp: nil

parameter: WINSIZE
text: "   Semblance sample rate"
type: typein:
type_desc: ( real: 12 0.0 2000.0)
value: 20.0
mouse_text: "Enter the semblance sample rate in milliseconds - distance between analysis window centers."

parameter: RSMOOTH
text: "   Semblance calculation window"
type: typein:
type_desc: ( real: 12 0.0 4000.0)
value: 40.0
mouse_text: "Enter size of window over which semblance will be calculated."

parameter: NVFS
text: "   Number of stack velocity functions"
type: typein:
type_desc: ( int: 3 1 999 )
value: 11
mouse_text: "Number of velocity functions and the number of stack strips."

parameter: NSTACK
text: "   Number of CDPS per stack strip"
type: typein:
type_desc: ( int: 3 1 999 )
value: 99999999
mouse_text: "Number of CDPS to stack for each of the velocity function stacks."

parameter: NORMSTK
text: "   Scale stacks by number of live samples summed"
type: boolean:
value: t
mouse_text: "Divide function velocity stacks, dynamic stacks, and flip stacks by number of live samples summed into stacks."

parameter: VFSTYPE
text: "   Method of computing velocity functions"
type: pop_choose:
type_desc: (
("Top/base range" 1 "Velocity function range specified min and max time.")
("Delta delta-t" 2 "Velocity function is the moveout at maximum offset.")
("Percentage" 3 "Velocity function is percentage of guide function.")
("Constant Velocity" 4 "Constant velocity function- evenly spaced through semblance span.")
)
value: 1
mouse_text: "Method of computing velocity function from guide velocity function."

parameter: VFDELTA
text: "      Velocity function time increment"
type: typein:
type_desc: ( real: 5 0.0 nil )
value: 10.0
mouse_text: "Change in moveout (delta t) between the velocity functions at the farthest offset."

parameter: VFCENT
text: "      Velocity function percent maximum"
type: typein:
type_desc: ( real: 5 0.0 nil )
value: 30.0
mouse_text: "Maximum percent change of the fan relative to the guide function (minimum and maximum)."

parameter: VFMINVEL
text: "      Velocity variation at time 0"
type: typein:
type_desc: ( real: 6 0 MAXVEL )
value: 99999999.
mouse_text: "The fan at time 0 will be the this value (in units/sec) wide centered at the guide function velocity"

parameter: VFMAXVEL
text: "      Velocity variation at maximum time"
type: typein:
type_desc: ( real: 6 0 MAXVEL )
value: 99999999.
mouse_text: "The fan at maximum time will be the this value (in units/sec) wide centered at the guide function velocity"

parameter: SPACE2
text: "-------------------------------------------------"
value_tab: 80
parameter: VIEWFLAG
text: "Set which items are visible?"
type: boolean:
value: nil
mouse_text: "Set on/off the various panels and displays in Velocity Analysis."

parameter: SPACE3
text: "-------------------------------------------------"
value_tab: 80

parameter: SHOWSEMB
text: "   Display semblance panel?"
type: boolean:
value: t
mouse_text: "Display the semblance plot."

parameter: SHOWVF
text: "   Display stack velocity functions?"
type: boolean:
value: t
mouse_text: "Display the velocity functions on the semblance panel."

parameter: SHOWCONT
text: "   Display semblance contours?"
type: boolean:
value: t
mouse_text: "Display the semblance contours on the semblance panel."

parameter: SHOWINT
text: "   Display interval velocity function?"
type: boolean:
value: nil
mouse_text: "Display the interval velocity function on the semblance panel as the stacking velocity function is picked."

parameter: SHOWGUID
text: "   Display guide function?"
type: boolean:
value: t
mouse_text: "Display the guide function."

parameter: SHOWGAT
text: "   Display gather panel?"
type: boolean:
value: t
mouse_text: "Display the smashed super gather."

parameter: PLOTTYPE
text: "   Seismic traces plotted as?"
type: choose:
type_desc: (
	("WIGGLES" "WIGGLES" "Plot seimsic data as wiggly lines")
	("GRAYSCALE" "GRAYSCALE" "Plot seimsic data as grayscale density")
	)
value: "WIGGLES"
selected: "WIGGLES"
mouse_text: "Plot seismic data in the form of wiggly lines or grayscale."


parameter: APPLYNMO
text: "   Apply NMO on gather panel?"
type: boolean:
value: nil
mouse_text: "Normal moveout correct the gather panel according to the current pick velocity function"

parameter: ANIMNMO
text: "   Animate NMO on gather panel?"
type: boolean:
value: nil
mouse_text: "Normal moveout correct a slice of the gather panel according to the velocity coordinate of the dragged mouse location"

parameter: SHOWDYN
text: "   Display dynamic stack panel?"
type: boolean:
value: t
mouse_text: "Display a stack that represents the stack with the current picked velocity function."

parameter: SHOWFLIP
text: "   Display flip stacks panel?"
type: boolean:
value: nil
mouse_text: "Display the flip stacks - (the function stacks displayed as a movie)."

parameter: SHOWSTK
text: "   Display velocity function stacks panel?"
type: boolean:
value: t
mouse_text: "Display the velocity function stacks."

parameter: SHOWVEL
text: "   Display velocity color background?"
type: boolean:
value: nil
mouse_text: "Display the velocity color background under the function stacks and dynamic stack."

parameter: SHOWKEY
text: "   Display velocity color key?"
type: boolean:
value: nil
mouse_text: "Display the velocity color key beneath the semblance panel."

parameter: SHOWGHOR
text: "   Show horizons on gather panel?"
type: boolean:
value: t
mouse_text: "Select YES to display previously picked horizon(s) in the gather."

parameter: SHOWVHOR
text: "   Show horizons on velocity function stacks panel?"
type: boolean:
value: nil
mouse_text: "Select YES to display previously picked horizon(s) in the velocity function stacks."

parameter: SHOWDHOR
text: "   Show horizons on dynamic stack panel?"
type: boolean:
value: t
mouse_text: "Select YES to display previously picked horizon(s) in the dynamic stack."

parameter: SHOWFHOR
text: "   Show horizons on flip stacks panel?"
type: boolean:
value: nil
mouse_text: "Select YES to display previously picked horizon(s) in the flip stacks."

parameter: SHOWPRES
text: "   Show current CDP guide function?"
type: boolean:
value: nil
mouse_text: "Select YES to display current CDP guide function on Semblance and Function Velocity Stacks"

parameter: SHOWAVE
text: "   Show average CDP guide function?"
type: boolean:
value: nil
mouse_text: "Select YES to display average-of-all-CDPs guide function on Semblance and Function Velocity Stacks"

parameter: SHOWPREV
text: "   Show previous CDP guide function?"
type: boolean:
value: nil
mouse_text: "Select YES to display previous CDP guide function on Semblance and Function Velocity Stacks"

parameter: SHOWNEXT
text: "   Show next CDP guide function?"
type: boolean:
value: nil
mouse_text: "Select YES to display next CDP guide function on Semblance and Function Velocity Stacks"

parameter: SHOWLAST
text: "   Show last-viewed CDP guide function?"
type: boolean:
value: nil
mouse_text: "Select YES to display last-viewed CDP guide function on Semblance and Function Velocity Stacks"

parameter: TRACEWID
text: "   Equalize displayed trace width?"
type: boolean:
value: nil
mouse_text: "Equalize the displayed trace width in the gather and stack panels."

parameter: SEMBWID
text: "   Relative width of semblance panel"
type: typein:
type_desc: ( int: 4 0 9999)
value: 100
mouse_text: "Relative width of semblance panel compared to other panels."

parameter: GATWID
text: "   Relative width of gather panel"
type: typein:
type_desc: ( int: 4 0 9999)
value: 75
mouse_text: "Relative width of gather panel compared to other panels. Zero selects trace equalization default."

parameter: DYNWID
text: "   Relative width of dynamic stack panel"
type: typein:
type_desc: ( int: 4 0 9999)
value: 30
mouse_text: "Relative width of dynamic stack panel compared to other panels. Zero selects trace equalization default."

parameter: FLIPWID
text: "   Relative width of flip stacks panel"
type: typein:
type_desc: ( int: 4 0 9999)
value: 30
mouse_text: "Relative width of flip stacks panel compared to other panels. Zero selects trace equalization default."

parameter: VFWID
text: "   Relative width of velocity function stack panel"
type: typein:
type_desc: ( int: 4 0 9999)
value: 200
mouse_text: "Relative width of velocity function stack panel compared to other panels. Zero selects trace equalization default."

parameter: SPACE4
text: "-------------------------------------------------"
value_tab: 80

parameter: SEMBPARM
text: "Set semblance scaling and autosnap parameters?"
type: boolean:
value: nil
mouse_text: "Configure scaling and autosnap parameters for the semblance display"

parameter: SPACE5
text: "-------------------------------------------------"
value_tab: 80
parameter: NORM
text: "   Semblance normalization mode"
type: pop_choose:
type_desc: (
 ("Scale Time Slice"   1 "Divide time slice of semblance values by the maximum in time slice.")
 ("Scale Panel"  2 "Divide all semblance values by the maximum semblance in panel.")
 ("No Scaling"   3 "Do no scaling of semblance values.")
           )
mouse_text: "Choose method of normalizing semblances."

parameter: RPOWER
text: "   Contrast power factor"
type: typein:
type_desc: ( real: 3 0.0 nil )
value: 1.0
mouse_text: "Raise each semblance sample power to this power before plotting.  A value greater/less than 1.0 increases/decreases the contrast."

parameter: RNOISE
text: "   Contrast noise factor"
type: typein:
type_desc: ( real: 3 0.0 nil )
value: 0.1
mouse_text: "Add this value to maximum semblance before scaling (not used if no scaling applied).  Recommend 0.0 to 0.4"
parameter: AUTOSNAP
text: "   Automatically snap"
type: pop_choose:
type_desc: ( ( "Off" 0 "Never autosnap - user can snap using the one time snap option.")
	     ( "After copy only" 1 "Automatically snap the picks at a new location on first visit after the previous function is copied.")
	     ( "Snap existing functions" 2 "Automatically snap existing function on the first visit if a location already has a function in the output table.")
	     ( "Always" 3 "Automatically snap copied or previously existing function on first visit."))
value: 0
mouse_text: "Options to automatically snap velocity function for new ensemble."

parameter: HOR_DIST
text: "   Maximum velocity % change for snapping"
type: typein:
type_desc: ( int: 5 1 100)
value: 5
mouse_text: "Horizontal search distance (in percent) for the neighboring highest semblance."

parameter: VER_DIST
text: "   Maximum vertical change for snapping"
type: typein:
type_desc: ( int: 3 0 nil)
value: 40
mouse_text: "Vertical search distance (in msec) for the neighboring highest semblance."

parameter: SPACE6
text: "-------------------------------------------------"
value_tab: 80

parameter: MUTEMODE
text: "Pick/apply a mute?"
type: choose:
type_desc: (	( "NONE" 0 "Do not apply picked mute.")
		("TOP" 1 "Mute from top mute upward and make top mute editable.")
		("BASE" 2 "Mute from base mute downward and make base mute editable.")
		("BOTH" 3 "Mute from top mute upward and base mute downward. Top mute initially editable.")
	)
value: 0
mouse_text: "Use top and/or base mutes picked on the Gather panel and/or a mute file."

parameter: TOPMUTE
text: "  Gather offset Top mute table"
type: function:
type_desc: ((parm_list "MUT") parms)
value: "INVALID"
mouse_text: "Use Mouse Button 1 to select a mute table from the menu."

parameter: BASEMUTE
text: "  Gather offset Base mute table"
type: function:
type_desc: ((parm_list "MUT") parms)
value: "INVALID"
mouse_text: "Use Mouse Button 1 to select a mute table from the menu."

parameter: MUTETAPE
text: "  Mute taper length"
type: typein:
type_desc: ( real: 12 0.0 nil)
value: 20.0
mouse_text: "Taper length of end of mute in vertical units."


parameter: SHOWHOR
text: "Select/Display horizons?"
type: choose:
type_desc: (
	("NONE" 0 "Don't show any horizons, but remember selections.")
	("POP-MENU" 1 "Select using a pop-up menu. Faster, but no color.")
	("EXPLICIT" 2 "Select each horizon and color explicitly.")
	("RESET-EXPLICIT" 3 "Erase all explicit entries.")
	)
value: 0
mouse_text: "Methods to select horizon display and color."

parameter: SPACE7
text: "-------------------------------------------------"
value_tab: 80


parameter: HORDATUM
text: "   To which datum are the horizons referenced?"
type: circular:
type_desc: (
    ("Final Datum  " -1 "Horizons were picked from a stack referenced to final datum (F_DATUM)." )
    ("Floating Datum"  1 "Horizons were picked from a stack referenced to floating datum (N_DATUM)" ))
value: -1
selected_item: 	("Final Datum  " -1 )
mouse_text: "Velocity Analysis will shift horizons picked at final datum to floating datum so that horizons picked on conventional stacks can be used for analysis."

parameter: H_TABLES
text: "   Horizon tables"
type: action:
value: nil
type_desc: ("INVALID")
mouse_text: "Use MB1 to pop up a window and select Horizon Tables to display."

parameter: HOR1
text: "   Select horizon #1"
type: function:
type_desc: ((parm_list "HOR") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a horizon table from the parameter table menu."

parameter: HCOLOR1
text: "      Color"
type: pop_choose:
type_desc: (
	("red" "red" "red")
	("orange" "orange" "orange")
	("yellow" "yellow" "yellow")
	("green" "green" "green")
	("blue" "blue" "blue")
	("violet" "violet" "violet")
	("brown" "brown" "brown")
	("gray" "gray" "gray")
	("white" "white" "white")
	("black" "black" "black")
	)
value: "red"
selected_item: "red"
mouse_text: "Select a color for horizon #1 from the pop up menu."

