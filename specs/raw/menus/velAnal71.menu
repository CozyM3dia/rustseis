;		("DISPLAY"	implicit: (if (value 'DISPLAY) 1 0))
		("PD_OPT"	implicit: (if (value 'PD_OPT) 1 0))
		("GUIDTYPE"	implicit: (value 'GUIDTYPE))
		("GUIDEOPT"	implicit: (if (value 'GUIDEOPT) 1 0))
		("GUIDETBL"	implicit: (value 'GUIDETBL))
		("MINGDVEL"	implicit: (value 'MINGDVEL))
		("MAXGDVEL"	implicit: (value 'MAXGDVEL))
		("STRETCH"	implicit: (value 'STRETCH))
		("LASTINT"	implicit: (value 'LASTINT))
		("PICKTYPE"	implicit: (value 'PICKTYPE))
		("NEWTABLE"	implicit: (value 'NEWTABLE))
		("COPYPICK"	implicit: (if (value 'COPYPICK) 1 0))
		("DEBUG"	implicit: (if (value 'DEBUG) 2 0))
		("program"	implicit: (value 'program))
		   )
      )

rules: 
	(

	(Xserver_rule (NOT (= (value 'Xserver) "This Screen"))
  		(progn
  		(setq temp (host_valid_p (value 'Xserver)))
  		(if temp
  		(add_error 'Xserver temp)
  		(set_error_list 'Xserver temp)))
  		(set_error_list 'Xserver nil))
	(SPACE0_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'SPACE0) (do_not_show 'SPACE0))
	(SETPARMS_rule (not (value 'PRECOMP)) (do_show 'SETPARMS) (do_not_show 'SETPARMS))
	(SPACE1_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'SPACE1) (do_not_show 'SPACE1))

; land data rules
	(LANDDATA_rule (= (db_parmget_line "IUNITSz") 3) (set_value 'LANDDATA 0))
	(LANDDATA_rule (do_not_show 'LANDDATA))
; residual moveout rules
;	(RMO_rule (do_not_show 'RMO))
	(RMO_rule (= (value 'RMO) -1)
		(add_error 'RMO "No option selected")
		(delete_error 'RMO "No option selected"))
	(OLDRMO_rule (not (= (value 'OLDRMO) (value 'RMO)))
		(progn	(set_value 'MINVEL 99999999.)
			(set_value 'MAXVEL 99999999.)
			(set_value 'VFMINVEL 99999999.)
			(set_value 'VFMAXVEL 99999999.)
;			(set_value 'NNMINVEL 99999999.)
;			(set_value 'NNMAXVEL 99999999.)
			(set_value 'MINGDVEL 99999999.)
			(set_value 'MAXGDVEL 99999999.)
			(set_value 'OLDRMO (value 'RMO))))
        (RMO_rule2 (= (value 'RMO) 0) (do_show 'VELSPACE) (do_not_show 'VELSPACE))
        (RMO_rule3 (not (= (value 'RMO) 0)) 
		   (progn (set_value 'VELSPACE 2)
			  (set_selected_item 'VELSPACE 
					     '("Equal Velocity" 2 "Equal spacing of velocities."))))
; offset rules
	(NSMASH_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'NSMASH) (do_not_show 'NSMASH))
	(NSMASH_rule (and (= (value 'RMO) 0) (= (value 'NSMASH) 99999999)) (set_value 'NSMASH 5))
	(NSMASH_rule (and (= (value 'RMO) 1) (= (value 'NSMASH) 99999999)) (set_value 'NSMASH 1))
	(NSMASH_rule (and (= (value 'RMO) 2) (= (value 'NSMASH) 99999999)) (set_value 'NSMASH 1))
	(SMASHNMO_rule (and (not (value 'PRECOMP)) (value 'SETPARMS) (= (value 'RMO) 0)) (do_show 'SMASHNMO) (do_not_show 'SMASHNMO))
	(SMASHSTA_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'SMASHSTA) (do_not_show 'SMASHSTA))
	(INITDIST_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'INITDIST) (do_not_show 'INITDIST))
	(BINSIZE_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'BINSIZE) (do_not_show 'BINSIZE))
	(MAXOFFS_rule ( = ( value 'MAXOFFS) -1.0) (set_value 'MAXOFFS ( db_parmget_line "OFFMAXz")))
	(MAXOFFS_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'MAXOFFS) (do_not_show 'MAXOFFS))
	(USEAOFF_rule (= (db_parmget_line "I3Dz") 1 ) (do_not_show 'USEAOFF) (do_show 'USEAOFF))
	(USEAOFF_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'USEAOFF) (do_not_show 'USEAOFF))
; semblance rules
	(MINVEL_rule (and (= (value 'RMO) 0) (= (value 'MINVEL) 99999999.)) (set_value 'MINVEL 4000.0))
	(MINVEL_rule (and (= (value 'RMO) 1) (= (value 'MINVEL) 99999999.)) (set_value 'MINVEL -50.))
	(MINVEL_rule (and (= (value 'RMO) 2) (= (value 'MINVEL) 99999999.)) (set_value 'MINVEL -50.))
	(MINVEL_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'MINVEL) (do_not_show 'MINVEL))
	(MAXVEL_rule (and (= (value 'RMO) 0) (= (value 'MAXVEL) 99999999.)) (set_value 'MAXVEL 25000.0))
	(MAXVEL_rule (and (= (value 'RMO) 1) (= (value 'MAXVEL) 99999999.)) (set_value 'MAXVEL 50.))
	(MAXVEL_rule (and (= (value 'RMO) 2) (= (value 'MAXVEL) 99999999.)) (set_value 'MAXVEL 50.))
	(MAXVEL_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'MAXVEL) (do_not_show 'MAXVEL))
	(NVELS_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'NVELS) (do_not_show 'NVELS))
	(VELSPACE_rule (do_not_show 'VELSPACE))
;	(VELSPACE_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'VELSPACE) (do_not_show 'VELSPACE))
	(WINSIZE_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'WINSIZE) (do_not_show 'WINSIZE))
	(RSMOOTH_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'RSMOOTH) (do_not_show 'RSMOOTH))
	(NVFS_rule  (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'NVFS)  (do_not_show 'NVFS))
; function velocity stack rules
	(NSTACK_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'NSTACK) (do_not_show 'NSTACK))
	(NSTACK_rule (and (= (value 'RMO) 0) (= (value 'NSTACK) 99999999)) (set_value 'NSTACK 5))
	(NSTACK_rule (and (= (value 'RMO) 1) (= (value 'NSTACK) 99999999)) (set_value 'NSTACK 1))
	(NSTACK_rule (and (= (value 'RMO) 2) (= (value 'NSTACK) 99999999)) (set_value 'NSTACK 1))
	(NORMSTK_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'NORMSTK) (do_not_show 'NORMSTK))
; velocity function rules
	(VFSTYPE_rule (and (not (value 'PRECOMP)) (= (value 'RMO) 0) (value 'SETPARMS)) (do_show 'VFSTYPE) (do_not_show 'VFSTYPE))
	(VFDELTA_rule (and (= (value 'RMO) 0) (value 'SETPARMS) (= (value 'VFSTYPE) 2) (not (value 'PRECOMP))) (do_show 'VFDELTA) (do_not_show 'VFDELTA))
	(VFCENT_rule (and (= (value 'RMO) 0) (value 'SETPARMS) (= (value 'VFSTYPE) 3) (not (value 'PRECOMP))) (do_show 'VFCENT) (do_not_show 'VFCENT))
	(VFMINVEL_rule (and (= (value 'VFMINVEL) 99999999. ) ( = (db_parmget_line "IUNITSz") 3) ) (set_value 'VFMINVEL 500.0))
	(VFMINVEL_rule (= (value 'VFMINVEL) 99999999. ) (set_value 'VFMINVEL 2000.0))
	(VFMINVEL_rule (and (value 'SETPARMS) (= (value 'RMO) 0) (= (value 'VFSTYPE) 1) (not (value 'PRECOMP))) (do_show 'VFMINVEL) (do_not_show 'VFMINVEL))
	(VFMAXVEL_rule (and (= (value 'VFMAXVEL) 99999999. ) ( = (db_parmget_line "IUNITSz") 3) ) (set_value 'VFMAXVEL 1500.0))
	(VFMAXVEL_rule (= (value 'VFMAXVEL) 99999999. ) (set_value 'VFMAXVEL 5000.0))
; mute rules
        (TOPMUTE_rule (or (= (value 'MUTEMODE) 1) (= (value 'MUTEMODE) 3) (= (value 'MUTEMODE) 4))
		(do_show 'TOPMUTE) (do_not_show 'TOPMUTE))
	(BASEMUTE_rule (or (= (value 'MUTEMODE) 2) (= (value 'MUTEMODE) 3) (= (value 'MUTEMODE) 4))
		(do_show 'BASEMUTE) (do_not_show 'BASEMUTE))
	(MUTETAPE_rule  (not (= (value 'MUTEMODE) 0))
		(do_show 'MUTETAPE) (do_not_show 'MUTETAPE))
	(VFMAXVEL_rule (and (value 'SETPARMS) (= (value 'RMO) 0) (= (value 'VFSTYPE) 1) (not (value 'PRECOMP))) (do_show 'VFMAXVEL) (do_not_show 'VFMAXVEL))
	(SPACE2_rule (and (not (value 'PRECOMP)) (value 'SETPARMS)) (do_show 'SPACE2) (do_not_show 'SPACE2))
; show items rules
	(SPACE3_rule (value 'VIEWFLAG) (do_show 'SPACE3) (do_not_show 'SPACE3))
	(SHOWSEMB_rule (value 'VIEWFLAG) (do_show 'SHOWSEMB) (do_not_show 'SHOWSEMB))
	(SHOWVF_rule (and (value 'VIEWFLAG) (= (value 'RMO) 0)) (do_show 'SHOWVF) (do_not_show 'SHOWVF))
	(SHOWCONT_rule (value 'VIEWFLAG) (do_show 'SHOWCONT) (do_not_show 'SHOWCONT))
	(SHOWINT_rule (and (value 'VIEWFLAG) (= (value 'RMO) 0)) (do_show 'SHOWINT) (do_not_show 'SHOWINT))
	(SHOWGUID_rule (value 'VIEWFLAG) (do_show 'SHOWGUID) (do_not_show 'SHOWGUID))
	(SHOWGAT_rule (value 'VIEWFLAG) (do_show 'SHOWGAT) (do_not_show 'SHOWGAT))
	(PLOTTYPE_rule (value 'VIEWFLAG) (do_show 'PLOTTYPE) (do_not_show 'PLOTTYPE))
	(APPLYNMO_rule (value 'VIEWFLAG) (do_show 'APPLYNMO) (do_not_show 'APPLYNMO))
	(ANIMNMO_rule (value 'VIEWFLAG) (do_show 'ANIMNMO) (do_not_show 'ANIMNMO))
	(SHOWDYN_rule (value 'VIEWFLAG) (do_show 'SHOWDYN) (do_not_show 'SHOWDYN))
	(SHOWFLIP_rule (value 'VIEWFLAG) (do_show 'SHOWFLIP) (do_not_show 'SHOWFLIP))
	(SHOWSTK_rule (value 'VIEWFLAG) (do_show 'SHOWSTK) (do_not_show 'SHOWSTK))
	(SHOWVEL_rule (and (value 'VIEWFLAG) (= (value 'PLOTTYPE) "WIGGLES"))
		(do_show 'SHOWVEL)
		(progn	(do_not_show 'SHOWVEL)
			(set_value 'SHOWVEL nil)))
	(SHOWKEY_rule (value 'VIEWFLAG) (do_show 'SHOWKEY) (do_not_show 'SHOWKEY))
	(SHOWGHOR_rule (value 'VIEWFLAG) (do_show 'SHOWGHOR) (do_not_show 'SHOWGHOR))
	(SHOWFHOR_rule (value 'VIEWFLAG) (do_show 'SHOWFHOR) (do_not_show 'SHOWFHOR))
	(SHOWPRES_rule (value 'VIEWFLAG) (do_show 'SHOWPRES) (do_not_show 'SHOWPRES))
	(SHOWAVE_rule (value 'VIEWFLAG) (do_show 'SHOWAVE) (do_not_show 'SHOWAVE))
	(SHOWPREV_rule (value 'VIEWFLAG) (do_show 'SHOWPREV) (do_not_show 'SHOWPREV))
	(SHOWNEXT_rule (value 'VIEWFLAG) (do_show 'SHOWNEXT) (do_not_show 'SHOWNEXT))
	(SHOWLAST_rule (value 'VIEWFLAG) (do_show 'SHOWLAST) (do_not_show 'SHOWLAST))
	(SHOWDHOR_rule (value 'VIEWFLAG) (do_show 'SHOWDHOR) (do_not_show 'SHOWDHOR))
	(SHOWVHOR_rule (value 'VIEWFLAG) (do_show 'SHOWVHOR) (do_not_show 'SHOWVHOR))
	(TRACEWID_rule (value 'VIEWFLAG) (do_show 'TRACEWID) (do_not_show 'TRACEWID))
	(SEMBWID_rule (value 'VIEWFLAG) (do_show 'SEMBWID) (do_not_show 'SEMBWID))
	(GATWID_rule (value 'VIEWFLAG) (do_show 'GATWID) (do_not_show 'GATWID))
	(DYNWID_rule (value 'VIEWFLAG) (do_show 'DYNWID) (do_not_show 'DYNWID))
	(FLIPWID_rule (value 'VIEWFLAG) (do_show 'FLIPWID) (do_not_show 'FLIPWID))
	(VFWID_rule (value 'VIEWFLAG) (do_show 'VFWID) (do_not_show 'VFWID))
	(SPACE4_rule (value 'VIEWFLAG) (do_show 'SPACE4) (do_not_show 'SPACE4))
; more semblance rules
	(SPACE5_rule (value 'SEMBPARM) (do_show 'SPACE5) (do_not_show 'SPACE5))
	(NORM_rule (value 'SEMBPARM) (do_show 'NORM)  (do_not_show 'NORM))
	(RPOWER_rule (value 'SEMBPARM) (do_show 'RPOWER) (do_not_show 'RPOWER))
	(RNOISE_rule (and (value 'SEMBPARM) (or (= (value 'NORM) 1) (= (value 'NORM) 2))) (do_show 'RNOISE) (do_not_show 'RNOISE))
; snap rules
	(AUTOSNAP_rule (value 'SEMBPARM) (do_show 'AUTOSNAP) (do_not_show 'AUTOSNAP))
	(HOR_DIST_rule (value 'SEMBPARM) (do_show 'HOR_DIST) (do_not_show 'HOR_DIST))
	(VER_DIST_rule (value 'SEMBPARM) (do_show 'VER_DIST) (do_not_show 'VER_DIST))
	(SPACE6_rule (value 'SEMBPARM) (do_show 'SPACE6) (do_not_show 'SPACE6))
; horizon rules
	(SPACE7_rule (= (value 'SHOWHOR) 2) (do_show 'SPACE7) (do_not_show 'SPACE7))
	(get_tables (value 'H_TABLES) 
          (progn 
            (set_value 'H_TABLES nil)
          	(set_selected_item 'H_TABLES none:)
            (set_type_desc 'H_TABLES (list (get_promax_tables)) )
          )
    )
	(H_TABLES_rule (= (value 'SHOWHOR) 1) (do_show 'H_TABLES) (do_not_show 'H_TABLES))
	(HORDATUM_rule (or (= (value 'SHOWHOR) 1) (= (value 'SHOWHOR) 2)) (do_show 'HORDATUM) (do_not_show 'HORDATUM))
	(HOR1_rule (= (value 'SHOWHOR) 2) (do_show 'HOR1) (do_not_show 'HOR1))
	(HCOLOR1_rule (and (= (value 'SHOWHOR) 2) (not (= (value 'HOR1) "no entry"))) (do_show 'HCOLOR1) (do_not_show 'HCOLOR1))
	(HOROK2_rule (and (= (value 'SHOWHOR) 2) (not (value 'HOROK2)) (not (= (value 'HOR1) "no entry"))) (do_show 'HOROK2) (do_not_show 'HOROK2))
	(HOR2_rule (and (= (value 'SHOWHOR) 2) (value 'HOROK2)) (do_show 'HOR2) (do_not_show 'HOR2))
	(HCOLOR2_rule (and (= (value 'SHOWHOR) 2) (not (= (value 'HOR2) "no entry"))) (do_show 'HCOLOR2) (do_not_show 'HCOLOR2))
