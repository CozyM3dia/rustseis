; IIID IVD 1 BSI PROSPECTOR FIELD DEV DEPTHC BHSS
'(
 name: TVS
label: "Time-Variant Scaling"
value_tab: 43


parameter: GAINTYPE
text: "Basis for scaling"
;type: choose:
type: pop_choose:
type_desc: ( 
  ("RMS "  "RMS"  "The ROOT MEAN SQUARE value in the defined gate will be used to determine the scalar." ) 
  ("MEAN " "MEAN" "The MEAN (average) value in the defined gate will be used to determine the scalar." )
  ("MAX " "MAX"  "The MAXIMUM value in the defined gate will be used to determine the scalar." )
  ("USER-VALS"  "USER_VAL"  "The USER will supply scalars that are multiplied times the trace samples in each time gate." ) )
mouse_text: "The user may select RMS, MEAN, MAXIMUM or USER-SUPPLIED VALUES as a basis for TVS scalars."
plot_label: t


parameter: POWR_EXP
text: "Root power for scalar adjustment"
type: typein:
type_desc: ( real: 5 1.0e-5 nil )
value: 1.0
mouse_text: "This is the power exponent for adjusting computed gain scalars.  1.0=no extra adjustment, 0.5='softer' scaling."
plot_label: t


parameter: USRP_KEY
text: "  SELECT Primary User Value Header WORD"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the headers menu as the PRIMARY key for specifying TVS User supplied gain values."


parameter: USRS_KEY
text: "  SELECT Secondary User Value Header WORD"
type: function:
type_desc: (header_list headers)
value: "OFFSET  "
selected_item: "Signed source-receiver offset"
mouse_text: "Use MB1 to select a header word from the headers menu as the SECONDARY key for specifying TVS User supplied gain values."



parameter: TVS_USRV
text: "  USER TVS Gain Values"
type: edit:
type_desc: (30 80 5 " Format: Primary Value:Secondary Value:Scalar1,Scalar2,..,Scalar N/
 Example: 1:-5280:1.1,2.3,5.5/1:0:0.9,1.9,4.3/1:5280:1.5,3.0,6.0/
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
value: "1:0:1.5,3.7,6.5/"
mouse_text: "Define the TVS gain values (example: '1:0:1.1,2.3,5.5/1:5280:1.5,3.0,6.0/')." 
plot_label: t


;parameter: USER_VAL
;text: "  Define 'USER' scalars"
;type: edit:
;type_desc: (25 80 5 " Format: scalar for 1st time gate,2nd scalar,..,nth scalar,
; Examples: 0.8,1.0,1.3; 0.5,1.0,1.5
; HELP: EMACS Editor Widget (scroll with down/up arrow keys)
; CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
; CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
; CM: Ctrl-E		Move the cursor to the END of the current line
; EDITING: All keyboard entry is in 'insert' mode
; E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
; E:  Ctrl-D			Delete one character to the RIGHT of the cursor
; E:  Ctrl-K		KILL to the end of the line (from the cursor)
; E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
;			  paste'; (Can move the cursor first) " 3 )
;value: "1.0"
;mouse_text: "This item is used to access the text editor and enter the USER-SUPPLIED TVS scalars (one for each time gate)."
;plot_label: t


parameter: TVS_MODE
text: "Basis for application"
;type: choose:
type: circular:
type_desc: ( 
      ("CENTER " 1 "Interpolate and apply scalars from gate center to gate center." )
      ("EDGE"     2 "Apply a constant scalar within the gate and interpolate between gate edges." ) )
mouse_text: "This option determines how the computed scalars will be applied to the trace samples."
plot_label: t


parameter: MIN_SAMP
text: "Minimum samples per gate"
type: typein:
type_desc: ( int: 4 1 9999 )
value: 5
mouse_text: "Minimum number of samples per TVS gate.  If fewer samples are available, the gate is removed."


parameter: db_option
text: "Get TVS time gates from database?"
type: boolean:
value: nil
mouse_text: "Select 'YES' if the time gates were entered interactively."


parameter: GATENAME
text: "  SELECT Time Gate Parameter FILE"
type: function:
type_desc: ((parm_list "GAT") parms)
value:  "no entry"
selected_item: "* No Parameter File has been Selected *"
mouse_text: "Use Mouse Button 1 to select a TVS time gate parameter file from the parameter file menu."


parameter: PRIM_KEY
text: "  SELECT Primary Time Gate Header WORD"
type: function:
type_desc: (header_list headers)
value: "SOURCE  "
selected_item: "Live source number"
mouse_text: "Use MB1 to select a header word from the headers menu as the PRIMARY key for specifying TVS time gate parameters."


parameter: SCND_KEY
text: "  SELECT Secondary Time Gate Header WORD"
type: function:
type_desc: (header_list headers)
value: "OFFSET  "
selected_item: "Signed source-receiver offset"
mouse_text: "Use MB1 to select a header word from the headers menu as the SECONDARY key for specifying TVS time gate parms."



parameter: TVS_GATE
text: "  SPECIFY TVS time gates"
type: edit:
type_desc: (30 80 5 " Format: Primary Value:Secondary Value:Time Gate1,Time Gate2,..,Time GateN/
 Example: 1:-5280:1200-2200/1:0:1000-2200/1:5280:1100-2200/
 HELP: EMACS Editor Widget (scroll with down/up arrow keys)
 CURSOR MOVEMENT: Use the arrow keys:->,<-,etc.;Point the mouse cursor,click B1
 CM: Ctrl-A		Move the cursor to the BEGINNING of the current line
 CM: Ctrl-E		Move the cursor to the END of the current line
 EDITING: All keyboard entry is in 'insert' mode
 E:  Backspace, Delete keys	Delete one character to the LEFT of the cursor
 E:  Ctrl-D			Delete one character to the RIGHT of the cursor
 E:  Ctrl-K		KILL to the end of the line (from the cursor)
 E:  Ctrl-Y		YANK back the contents of the kill buffer; 'Cut and 
			  paste'; (Can move the cursor first) " 3 )
value: "1:0:0-500,700-1800,2500-4000/"
mouse_text: "Define the TVS time gates (example: '1:0:0-500,700-1800,2500-4000/1:5280:500-1000,1200-2000,2600-4000/')." 
plot_label: t

parameter: OUT_TYPE
text: "Type of output"
;type: choose:
type: circular:
type_desc: ( 
      ("TRACES " 1 "Output the scaled input traces." )
      ("SCALARS" 2 "Output the scalar values as traces." ) )
mouse_text: "This option determines what values are in the output traces."
plot_label: t


exec_data: ("TVS"
		("GENERAL"
			("version" implicit: "ProMAX $Id: tvs.menu 44577 2009-07-29 16:44:43Z David Johnston $ $Revision: 44577 $ $Date: 2009-07-29 10:44:43 -0600 (Wed, 29 Jul 2009) $")
			("POWR_EXP" implicit: (value 'POWR_EXP))
			("USRP_KEY" implicit: (value 'USRP_KEY))
			("USRS_KEY" implicit: (value 'USRS_KEY))
			("TVS_USRV" implicit: (value 'TVS_USRV))
			("PRIM_KEY" implicit: (value 'PRIM_KEY))
			("SCND_KEY" implicit: (value 'SCND_KEY))
			("GAINTYPE" implicit: (value 'GAINTYPE))
			("TVS_MODE" implicit: (value 'TVS_MODE))
			("MIN_SAMP" implicit: (value 'MIN_SAMP))
			("TVS_GATE" implicit: (value 'TVS_GATE))
;			("USER_VAL" implicit: (value 'USER_VAL))
			("GATENAME" implicit: (if (value 'db_option)
						  (value 'GATENAME) "NONE"))
			("OUT_TYPE"  implicit: (value 'OUT_TYPE))
		)
	   )

rules: (
 (rule1 ( equal ( value 'GAINTYPE ) "USER_VAL" )
 		(do_show '(USRP_KEY USRS_KEY TVS_USRV))
                (do_not_show '(USRP_KEY USRS_KEY TVS_USRV))) 
 (rule2 ( equal ( value 'GAINTYPE ) "USER_VAL" ) 
 		(do_not_show 'MIN_SAMP) (do_show 'MIN_SAMP)) 
 (rule3 ( equal ( value 'GAINTYPE ) "USER_VAL" ) 
 		(do_not_show 'POWR_EXP) (do_show 'POWR_EXP)) 
 (rule4 (value 'db_option)   (progn (do_show 'GATENAME)
				    (do_not_show 'PRIM_KEY)
				    (do_not_show 'SCND_KEY)
				    (do_not_show 'TVS_GATE))
			     (progn (do_not_show 'GATENAME)
				    (do_show 'PRIM_KEY)
				    (do_show 'SCND_KEY)
				    (do_show 'TVS_GATE)))
	)


)

