{
  "name": "NIAS_L22_Full_1262Shots_Tier2_Enhanced",
  "description": "Full 31.6 km NIAS 2D marine line (1,262 shots = 121,152 traces) with Tier 2 SCAMP2 + CDP Trim Statics + F-X Decon + Curvelet Denoising + Kirchhoff Time Migration + SQLite OPF",
  "steps": [
    {
      "tool": "segd_read",
      "params": {
        "path": "C:\\Kuliah\\Metode Seismik 2025\\Data Seismik",
        "max_shots": null,
        "live_only": true
      }
    },
    { "tool": "trace_len", "params": { "length_ms": 4000.0 } },
    { "tool": "debias", "params": {} },
    {
      "tool": "geomspread_marine",
      "params": {
        "near_offset_m": 100.0,
        "receiver_interval_m": 12.5,
        "nominal_shot_interval_m": 25.0,
        "cdp_bin_size_m": 6.25,
        "chan1_is_near": true,
        "source_depth_m": 5.0,
        "streamer_depth_m": 6.0
      }
    },
    {
      "tool": "filter",
      "params": { "spec_type": "Ormsby", "phase": "Zero", "freqs": [6.0, 12.0, 70.0, 90.0], "pad_pct": 25.0 }
    },
    { "tool": "tar", "params": { "time_power": 1.5, "max_time_ms": 3500.0 } },
    {
      "tool": "scamp2",
      "params": {
        "save_table": "nias_full_scamp",
        "params": {
          "gate_start_ms": 200.0,
          "gate_end_ms": 3400.0,
          "solve_source": true,
          "solve_receiver": true,
          "solve_offset": true,
          "apply_source": true,
          "apply_receiver": true,
          "apply_offset": false,
          "preserve_mean_amp": true
        }
      }
    },
    {
      "tool": "decon",
      "params": {
        "operator_ms": 140.0,
        "prediction_lag_ms": 16.0,
        "white_noise_pct": 1.0,
        "design_windows_ms": [[300.0, 3200.0]]
      }
    },
    {
      "tool": "fk_filt",
      "params": {
        "mode": "RejectLowVelocity",
        "dx_m": 12.5,
        "vel_cut_mps": 1350.0,
        "taper_frac": 0.2,
        "pedestal": 0.02
      }
    },
    { "tool": "inline_sort", "params": { "primary": "CDP", "secondary": "AOFFSET" } },
    {
      "tool": "vaprecom71",
      "params": {
        "cdps": [],
        "save_table": "nias_full_vel_t2",
        "auto_pick": true,
        "scan": {
          "v_min_mps": 1450.0,
          "v_max_mps": 3500.0,
          "dv_mps": 50.0,
          "window_ms": 30.0,
          "t_step_ms": 20.0,
          "stretch_mute_pct": 50.0
        }
      }
    },
    {
      "tool": "nmo",
      "params": {
        "velocity_table": "nias_full_vel_t2",
        "params": { "direction": "Forward", "stretch_mute_pct": 35.0, "stretch_taper_samples": 8, "do_stat": true }
      }
    },
    {
      "tool": "trimstat",
      "params": {
        "gate_start_ms": 300.0,
        "gate_end_ms": 3200.0,
        "max_shift_ms": 8.0,
        "min_correlation": 0.45
      }
    },
    { "tool": "stack", "params": { "method": "Mean", "fold_norm_power": 1.0, "exclude_muted_zeros": true } },
    { "tool": "agc", "params": { "operator_ms": 600.0, "basis": "Rms", "anchor": "Center", "target_amp": 1.0 } },
    {
      "tool": "fxdecon",
      "params": {
        "filter_len": 5,
        "horiz_window_traces": 32,
        "time_window_ms": 400.0,
        "time_overlap_ms": 60.0,
        "white_noise_pct": 1.5
      }
    },
    {
      "tool": "segy_write",
      "params": {
        "path": "C:\\Kuliah\\Metode Seismik 2025\\rustseis\\out\\nias_tier2_full_1262_stack_fx.sgy",
        "comment": "NIAS L22 Full 1262-shot Tier 2 Stack (SCAMP2+TrimStat+FXDecon)"
      }
    },
    {
      "tool": "kirtime2dstk",
      "params": {
        "velocity_table": "nias_full_vel_t2",
        "params": {
          "dx_m": 6.25,
          "max_aperture_m": 1500.0,
          "max_dip_deg": 55.0,
          "apply_half_derivative": true,
          "anti_alias": true
        }
      }
    },
    {
      "tool": "fxdecon",
      "params": {
        "filter_len": 5,
        "horiz_window_traces": 32,
        "time_window_ms": 400.0,
        "time_overlap_ms": 60.0,
        "white_noise_pct": 1.5
      }
    },
    {
      "tool": "segy_write",
      "params": {
        "path": "C:\\Kuliah\\Metode Seismik 2025\\rustseis\\out\\nias_tier2_full_1262_migrated.sgy",
        "comment": "NIAS L22 Full 1262-shot Tier 2 Migrated (SCAMP2+TrimStat+FXDecon+Kirchhoff)"
      }
    }
  ]
}
